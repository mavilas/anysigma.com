{
  "name": "anysigma.com",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.33.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:production": "PUBLIC_SITE_STAGE=production astro build",
    "build:staging": "PUBLIC_SITE_STAGE=staging astro build",
    "build:construction": "PUBLIC_SITE_STAGE=production astro build && node scripts/build-construction.mjs",
    "deploy:production": "pnpm run build:construction && wrangler deploy",
    "deploy:staging": "pnpm run build:staging && wrangler deploy --env staging",
    "deploy:cloudflare": "pnpm run deploy:production",
    "setup:recaptcha": "node scripts/setup-recaptcha.mjs",
    "setup:resend": "node scripts/setup-resend.mjs",
    "test:contact": "node scripts/test-contact.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test"
  },
  "dependencies": {
    "@lucide/astro": "^1.14.0",
    "astro": "^6.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "lighthouse": "^13.3.0",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.90.0"
  }
}
