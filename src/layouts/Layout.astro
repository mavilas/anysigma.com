---
import "../styles/tailwind.css";
import { getDictionary } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  lang?: "ja" | "en";
  ogImage?: string;
}

const {
  title = "anysigma | Beyond Intelligence",
  description = "Intelligent systems. Boundless potential. We are building the future of automated intelligence.",
  lang = "ja",
  ogImage = "/og-default.svg",
} = Astro.props;

const t = getDictionary(lang);
const canonical = new URL(Astro.url.pathname, "https://anysigma.com").toString();
const ogImageUrl = new URL(ogImage, "https://anysigma.com").toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0c" />

    <link rel="alternate" href="https://anysigma.com/" hreflang="ja" />
    <link rel="alternate" href="https://anysigma.com/en/" hreflang="en" />
    <link rel="alternate" href="https://anysigma.com/" hreflang="x-default" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="anysigma" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "ja_JP"} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      // Simple theme management if needed later, default to dark for Sigma
      document.documentElement.dataset.theme = "dark";
    </script>
  </head>
  <body>
    <div class="background-grid"></div>
    <div class="glow-effect"></div>
    
    <header class="header wrap">
      <a href={lang === "ja" ? "/" : "/en/"} class="logo" aria-label={t.accessibility.home}>
        <img src="/anysigma-mark.svg" alt="" width="32" height="32" />
        <span class="logo-text"><span>any</span>sigma</span>
      </a>
      <div class="nav-actions">
        <a href={t.language.switchHref} class="btn-lang">{t.language.switchLabel}</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-content">
        <div class="footer-brand">
          <img src="/anysigma-mark.svg" alt="" width="24" height="24" />
          <span class="logo-text"><span>any</span>sigma</span>
        </div>
        <p class="copyright">&copy; 2026 anysigma. {t.footer.rights}</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.1 });

        for (const el of document.querySelectorAll("[data-reveal]")) {
          observer.observe(el);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    
    /* Sigma Palette: Deep Indigo / Electric Violet / Cyber Gray */
    --paper: oklch(10% 0.02 280);
    --surface: oklch(14% 0.02 280);
    --surface-elevated: oklch(18% 0.03 280);
    
    --ink: oklch(98% 0.01 280);
    --ink-soft: oklch(85% 0.02 280);
    --muted: oklch(65% 0.02 280);
    
    --line: oklch(25% 0.03 280);
    --line-strong: oklch(35% 0.04 280);
    
    --accent: oklch(70% 0.18 280);
    --accent-glow: oklch(70% 0.18 280 / 0.15);
    --accent-deep: oklch(50% 0.2 280);
    
    --font: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", YuGothic, "Noto Sans JP", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    
    --max: 1200px;
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --ease-deep: cubic-bezier(0.16, 1, 0.3, 1);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    font-feature-settings: "palt" 1;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    position: relative;
  }

  .background-grid {
    position: fixed;
    inset: 0;
    background-image: 
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.3;
    z-index: -1;
    mask-image: radial-gradient(circle at center, black, transparent 90%);
  }

  .glow-effect {
    position: fixed;
    top: -10%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle at center, var(--accent-glow), transparent 70%);
    z-index: -1;
    pointer-events: none;
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    width: 100%;
    padding-inline: 1.5rem;
  }

  header.header {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 10;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    transition: opacity 0.2s var(--ease);
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .logo-text span {
    color: var(--accent);
  }

  .btn-lang {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    transition: all 0.2s var(--ease);
  }

  .btn-lang:hover {
    color: var(--ink);
    border-color: var(--muted);
    background: var(--surface);
  }

  main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 4rem;
  }

  .footer {
    padding-block: 3rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.6;
  }

  .copyright {
    color: var(--muted);
    font-size: 0.8125rem;
    margin: 0;
  }

  h1 {
    font-size: clamp(3.5rem, 12vw, 7.5rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    margin: 0;
    line-height: 0.85;
  }

  .accent-text {
    color: var(--accent);
    background: linear-gradient(135deg, var(--accent), oklch(85% 0.12 310));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lead {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--ink-soft);
    max-width: 32ch;
    margin-top: 2rem;
    line-height: 1.3;
    font-weight: 500;
  }

  .button {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--paper);
    padding: 0.875rem 2rem;
    border-radius: 99px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.3s var(--ease-deep), filter 0.2s var(--ease);
    box-shadow: 0 20px 40px -10px var(--accent-glow);
  }

  .button:hover {
    transform: translateY(-3px) scale(1.02);
    filter: brightness(1.1);
  }

  /* Reveal Animations */
  [data-reveal] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s var(--ease-deep), transform 1s var(--ease-deep);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-reveal-delay="1"] { transition-delay: 0.1s; }
  [data-reveal-delay="2"] { transition-delay: 0.2s; }
  [data-reveal-delay="3"] { transition-delay: 0.3s; }
  [data-reveal-delay="4"] { transition-delay: 0.4s; }
  [data-reveal-delay="5"] { transition-delay: 0.5s; }

  @media (max-width: 640px) {
    header.header {
      height: 64px;
    }
    main {
      padding-block: 2rem;
    }
    h1 {
      line-height: 0.9;
    }
  }
</style>
