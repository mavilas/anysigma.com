---
import "../styles/tailwind.css";
import { getDictionary } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  lang?: "ja" | "en";
  ogImage?: string;
}

const {
  title = "anysigma | Beyond Intelligence",
  description = "Intelligent systems. Boundless potential. We are building the future of automated intelligence.",
  lang = "ja",
  ogImage = "/og-default.svg",
} = Astro.props;

const t = getDictionary(lang);
const canonical = new URL(Astro.url.pathname, "https://anysigma.com").toString();
const ogImageUrl = new URL(ogImage, "https://anysigma.com").toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0c" />

    <link rel="alternate" href="https://anysigma.com/" hreflang="ja" />
    <link rel="alternate" href="https://anysigma.com/en/" hreflang="en" />
    <link rel="alternate" href="https://anysigma.com/" hreflang="x-default" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="anysigma" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "ja_JP"} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      document.documentElement.dataset.theme = "dark";
    </script>
  </head>
  <body>
    <!-- The Tokyo Background SVG -->
    <div class="background-storm"></div>
    
    <header class="header wrap">
      <a href={lang === "ja" ? "/" : "/en/"} class="logo" aria-label={t.accessibility.home}>
        <img src="/anysigma-mark.svg" alt="" width="32" height="32" class="logo-mark" />
        <span class="logo-text"><span>any</span>sigma</span>
      </a>
      <div class="nav-actions">
        <a href={t.language.switchHref} class="btn-lang">{t.language.switchLabel}</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-content">
        <p class="copyright">&copy; 2026 anysigma. {t.footer.rights}</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.05 });

        document.querySelectorAll("[data-reveal]").forEach(el => observer.observe(el));
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --paper: oklch(10% 0.02 280);
    --surface: oklch(14% 0.02 280);
    --ink: oklch(98% 0.01 280);
    --ink-soft: oklch(85% 0.02 280);
    --muted: oklch(65% 0.02 280);
    --line: oklch(25% 0.03 280);
    --accent: oklch(70% 0.18 280);
    --accent-violet: oklch(75% 0.15 310);
    --accent-glow: oklch(70% 0.18 280 / 0.1);
    
    --font: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", YuGothic, "Noto Sans JP", system-ui, sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, monospace;
    --max: 1200px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-deep: cubic-bezier(0.16, 1, 0.3, 1);
  }

  * { box-sizing: border-box; }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "palt" 1;
    overflow-y: scroll;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    position: relative;
    background: var(--paper);
  }

  .background-storm {
    position: fixed;
    inset: 0;
    background: url('/anysigma-storm.svg') no-repeat center center;
    background-size: cover;
    z-index: -1;
    opacity: 0.6;
  }

  .background-storm::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, var(--paper) 100%);
  }

  .scanlines {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(0, 0, 0, 0.05) 51%,
      transparent 51%
    );
    background-size: 100% 4px;
    z-index: 5;
    pointer-events: none;
    opacity: 0.3;
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    width: 100%;
    padding-inline: 1.5rem;
  }

  header.header {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s var(--ease);
  }

  .logo:hover {
    transform: translateX(4px);
  }

  .logo-mark {
    filter: drop-shadow(0 0 8px var(--accent-glow));
    animation: logo-flicker 4s infinite;
  }

  @keyframes logo-flicker {
    0%, 100% { opacity: 1; filter: drop-shadow(0 0 8px var(--accent-glow)); }
    31% { opacity: 1; }
    32% { opacity: 0.8; filter: drop-shadow(0 0 2px var(--accent-glow)); }
    33% { opacity: 1; }
    84% { opacity: 1; }
    85% { opacity: 0.9; }
    86% { opacity: 1; }
  }

  .logo-text {
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .logo-text span {
    color: var(--accent);
  }

  .btn-lang {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    transition: all 0.3s var(--ease);
  }

  .btn-lang:hover {
    color: var(--ink);
    border-color: var(--muted);
    background: var(--surface);
    transform: translateY(-1px);
  }

  main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer {
    padding-block: 4rem;
    border-top: 1px solid var(--line);
  }

  .footer-content {
    display: flex;
    justify-content: center;
    opacity: 0.4;
  }

  .copyright {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  h1 {
    font-size: clamp(4rem, 15vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.07em;
    margin: 0;
    line-height: 0.8;
  }

  .accent-text {
    color: var(--accent);
    background: linear-gradient(135deg, var(--accent), var(--accent-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px var(--accent-glow));
  }

  .lead {
    font-size: clamp(1.2rem, 3vw, 1.85rem);
    color: var(--ink-soft);
    max-width: 32ch;
    margin-top: 2.5rem;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .button {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--paper);
    padding: 1rem 2.5rem;
    border-radius: 99px;
    font-weight: 900;
    text-decoration: none;
    transition: all 0.4s var(--ease-deep);
    box-shadow: 0 20px 50px -10px var(--accent-glow);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
  }

  .button:hover {
    transform: translateY(-5px) scale(1.03);
    filter: brightness(1.15);
    box-shadow: 0 30px 60px -12px var(--accent-glow);
  }

  /* Reveal Animations */
  [data-reveal] {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(40px) scale(0.98);
    transition: 
      opacity 1.2s var(--ease-deep), 
      transform 1.2s var(--ease-deep),
      filter 1.2s var(--ease-deep);
  }

  [data-reveal].is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0) scale(1);
  }

  [data-reveal-delay="1"] { transition-delay: 0.15s; }
  [data-reveal-delay="2"] { transition-delay: 0.3s; }
  [data-reveal-delay="3"] { transition-delay: 0.45s; }
  [data-reveal-delay="4"] { transition-delay: 0.6s; }
  [data-reveal-delay="5"] { transition-delay: 0.75s; }

  @media (max-width: 640px) {
    header.header { height: 80px; }
    h1 { line-height: 0.85; }
    .lead { margin-top: 1.5rem; }
  }
</style>
