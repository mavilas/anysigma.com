---
import Layout from "../layouts/Layout.astro";
import { getDictionary } from "../i18n";

const lang = "ja";
const t = getDictionary(lang);
---

<Layout lang={lang}>
  <div class="content wrap">
    <div class="status-badge" data-reveal="fade-up">{t.parking.status}</div>
    <h1 data-reveal="fade-up" data-reveal-delay="1">
      <span class="accent-text">any</span>sigma
    </h1>
    <p class="lead" data-reveal="fade-up" data-reveal-delay="2">
      {t.parking.message}
    </p>
    <p class="submessage" data-reveal="fade-up" data-reveal-delay="3">
      {t.parking.submessage}
    </p>
    <div class="actions" data-reveal="fade-up" data-reveal-delay="4">
      <a href="mailto:hello@anysigma.com" class="button">{t.parking.cta}</a>
      <a href="/en/" class="lang-switch">English</a>
    </div>
  </div>
</Layout>

<style>
  .content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .status-badge {
    background: color-mix(in oklch, var(--accent), transparent 85%);
    color: var(--accent);
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    border: 1px solid color-mix(in oklch, var(--accent), transparent 70%);
  }

  .submessage {
    color: var(--muted);
    margin-top: 1rem;
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .lang-switch {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .lang-switch:hover {
    color: var(--accent);
  }
</style>
