---
import * as Icons from "@lucide/astro";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  name: string;
  members: string;
  channel: string;
  rationale: string;
  url?: string;
  icon?: string;
  revealDelay?: number;
}

const {
  name,
  members,
  channel,
  rationale,
  url,
  icon = "users-round",
  revealDelay = 0,
} = Astro.props;

const toPascal = (s: string) =>
  s
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join("");

const IconComponent = (Icons as any)[toPascal(icon)] || Icons.Users;

const Wrapper = url ? "a" : "div";
const wrapperProps = url
  ? { href: url, target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<Wrapper
  {...wrapperProps}
  class={`tile group border border-[var(--color-line)] rounded-xl p-6 bg-[var(--color-paper)] block ${url ? "" : "cursor-default"}`}
  data-reveal="fade-up"
  data-reveal-delay={revealDelay}
>
  <div class="flex items-start justify-between gap-4 mb-4">
    <IconComponent class="w-5 h-5 text-[var(--color-accent)] mt-1" />
    {
      url && (
        <ArrowUpRight class="w-4 h-4 text-[var(--color-ink-faint)] arrow-pop group-hover:text-[var(--color-ink)] transition-colors" />
      )
    }
  </div>

  <div class="font-display text-2xl leading-tight mb-1">{name}</div>
  <div class="text-[11px] uppercase tracking-[0.14em] text-[var(--color-ink-faint)] font-medium mb-3">
    {members} · {channel}
  </div>

  <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
    {rationale}
  </p>
</Wrapper>
