    ],
    recommendations: [
      { title: "Inline assignee chip on the composer row", why: "An always-visible 'Me' chip with a tap-to-change picker. Brings tap count to 2 even when assigning. Linear-tier.", effort: "4 hr", fixPath: "services/nova/src/components/tasks/TaskInlineCreate.tsx · assignee picker sheet" },
      { title: "Optimistic insert with snackbar-undo", why: "Task appears immediately on send. If backend fails, snackbar offers 'Tap to retry' instead of an error dialog.", effort: "3 hr", fixPath: "services/nova/src/components/tasks/TaskInlineCreate.tsx · createTask mutation onMutate / onError" },
    ],
  },
];

/* ====== Sum of total recommendation effort ====== */
const totalRecHours = journeys.reduce((sum, j) => {
  return sum + j.recommendations.reduce((s, r) => {
    const m = r.effort.match(/(\d+(?:\.\d+)?)\s*(hr|h|day|d)/);
    if (!m) return s;
    const n = parseFloat(m[1]);
    return s + (m[2].startsWith("d") ? n * 8 : n);
  }, 0);
}, 0);
const totalBugs = journeys.reduce((s, j) => s + j.bugs.length, 0);
const totalRecs = journeys.reduce((s, j) => s + j.recommendations.length, 0);

const kindStyle = (kind: StepKind) => {
  switch (kind) {
    case "user": return { bg: "var(--color-paper)", border: "var(--color-ink)", icon: "circle-dot" };
    case "client": return { bg: "var(--color-paper-soft)", border: "var(--color-ink-soft)", icon: "smartphone" };
    case "server": return { bg: "var(--color-accent-soft)", border: "var(--color-accent)", icon: "cloud" };
    case "auth0": return { bg: "var(--color-warning-soft)", border: "var(--color-warning)", icon: "key-round" };
    case "db": return { bg: "var(--color-success-soft)", border: "var(--color-success)", icon: "database" };
    case "wait": return { bg: "var(--color-paper-warm)", border: "var(--color-ink-faint)", icon: "hourglass" };
  }
};

const severityColor = (s?: Severity) => {
  if (s === "blocker") return "var(--color-danger)";
  if (s === "friction") return "var(--color-warning)";
  return "var(--color-line)";
};
