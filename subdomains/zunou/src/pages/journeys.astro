---
import Layout from "../layouts/Layout.astro";
import {
  Route,
  CircleDot,
  ArrowRight,
  AlertTriangle,
  CheckCircle2,
  XCircle,
  Hourglass,
  Zap,
  TrendingDown,
  TrendingUp,
  UserPlus,
  KeyRound,
  Calendar,
  MessageSquare,
  Hash,
  Plus,
  Smartphone,
  Cloud,
  Database,
  RefreshCw,
  Flag,
  Sparkles,
  Bug,
  Wrench,
  Target,
  Clock,
  ListChecks,
  CircleHelp,
  Layers,
} from "@lucide/astro";

/* ====== Magic numbers (from GTM §05) ====== */
const magic = {
  events: "5",
  moment: "1",
  returns: "3",
  window: "14 days",
};

/* ====== Journey timing — a step is a thing the system does or the user does.
   latency buckets: fast <200ms, mid 200–800ms, slow 800–2000ms, blocking 2000ms+ ====== */
type StepKind = "user" | "client" | "server" | "auth0" | "db" | "wait";
type Severity = "ok" | "friction" | "blocker";

interface Step {
  id: string;
  label: string;
  detail?: string;
  kind: StepKind;
  ms?: number; // typical
  severity?: Severity;
  evidence?: string;
}

interface GtmRef {
  ref: string;       // e.g. "§05" or "Decision #3"
  label: string;     // human label
  href: string;      // anchor on /
}

interface Journey {
  id: string;
  title: string;
  audience: string;
  todayCount: string;
  todayTime: string;
  recCount: string;
  recTime: string;
  magicTie: string;
  gtmRefs: GtmRef[];
  icon: string;
  steps: Step[];
  bugs: { title: string; detail: string; evidence: string }[];
  recommendations: { title: string; why: string; effort: string; fixPath: string }[];
}

const journeys: Journey[] = [
  /* ===== JOURNEY 1 — FIRST SIGN-IN ===== */
  {
    id: "sign-in",
    title: "First sign-in",
    audience: "Brand-new user opening the app for the first time",
    todayCount: "14–20 blocking roundtrips",
    todayTime: "1.5–4 s",
    recCount: "6–8 roundtrips",
    recTime: "<1 s",
    magicTie: 'Mobile users abandon pages taking >3s at <a href="https://www.marketingdive.com/news/google-53-of-mobile-users-abandon-sites-that-take-over-3-seconds-to-load/426070/" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]"><strong>53%</strong> (Google)</a>. Today the iOS cold-start sits squarely in that range.',
    gtmRefs: [
      { ref: "§05", label: "Magic numbers — 5 / 1 / 3", href: "/#tldr" },
      { ref: "§06", label: "TAI pilot · activation gate", href: "/#communities" },
      { ref: "Posture", label: "Engineering posture", href: "/#posture" },
    ],
    icon: "key-round",
    steps: [
      { id: "tap", label: "Tap Sign in", kind: "user", ms: 0 },
      { id: "auth0-ul", label: "Auth0 universal login", detail: "loginWithRedirect / promptAsync", kind: "auth0", ms: 600 },
      { id: "pkce", label: "PKCE code exchange", kind: "client", ms: 200 },
      { id: "userinfo", label: "GET /userinfo", kind: "auth0", ms: 300 },
      { id: "delay", label: "100ms safety buffer", detail: "AuthContext.tsx:401 — admitted workaround", kind: "wait", ms: 100, severity: "friction", evidence: "AuthContext.tsx:399–405" },
      { id: "signin", label: "signInUser mutation", detail: "GraphQL call to Laravel", kind: "server", ms: 200 },
      { id: "mgmt-token", label: "POST /oauth/token (Mgmt API)", detail: "iOS Apple Sign-In: token has no email claim", kind: "auth0", ms: 500, severity: "blocker", evidence: "SignInUserMutation.php:94–123" },
      { id: "mgmt-user", label: "GET /api/v2/users/{id}", detail: "Fetch email from Auth0 Management API", kind: "auth0", ms: 400, severity: "blocker", evidence: "SignInUserMutation.php:425–434" },
      { id: "role-add", label: "Auth0 role + permissions", detail: "3 more Mgmt API calls, all sequential", kind: "auth0", ms: 900, severity: "blocker", evidence: "Auth0RoleService.php:36–54" },
      { id: "perm-refresh", label: "Refresh permissions cache", detail: "New Auth0 SDK instance + paginated fetch", kind: "auth0", ms: 600, severity: "friction", evidence: "RefreshAuth0PermissionsService.php:21–55" },
      { id: "pulses", label: "ensureUserHasPersonalPulses", detail: "N+1 DB queries inside the request cycle", kind: "db", ms: 400, severity: "friction", evidence: "SignInUserMutation.php:585–605" },
      { id: "getme", label: "getMeQuery", detail: "Redundant — signInUser already returned the user", kind: "server", ms: 250, severity: "friction", evidence: "AuthContext.tsx:286–342" },
      { id: "bootorg", label: "Bootstrap org query", kind: "server", ms: 200 },
      { id: "bootset", label: "Bootstrap settings query", detail: "Serial: needs org id first", kind: "server", ms: 200, severity: "friction", evidence: "useBootstrapOrg.ts:116–194" },
      { id: "render", label: "Onboarding mounts", kind: "client", ms: 0 },
    ],
    bugs: [
      {
        title: '"Native iOS keeps kicking users out — but PWA stays signed in"',
        detail: "PWA uses Auth0's `@auth0/auth0-react` SDK with `cacheLocation: 'localstorage'` and silent SDK-managed refresh — robust. Native iOS (Nova/Capacitor) reimplements the entire flow manually: `expo-auth-session` for the PKCE handshake, `expo-secure-store` (Keychain) for tokens, and a manual `POST /oauth/token` for refresh. Three known failure modes here: (a) Keychain access can throw on cold-start before the secure enclave is unlocked, returning null and triggering re-login; (b) the refresh-token POST has no retry on 5xx — a single network blip drops the user; (c) there's no AppState listener to refresh tokens when the app foregrounds after a long background. The PWA never hits any of this because the Auth0 SDK handles it. The fix is not to harden three different bugs — it's to consolidate native iOS onto the same Auth0 SDK behavior.",
        evidence: "nova/src/contexts/AuthContext.tsx (manual restore + refresh) · expo-secure-store usage · no AppState listener for token refresh",
      },
      {
        title: '"Sometimes I have to sign in twice" — primary cause',
        detail: "`prompt: 'login'` is hardcoded in the Auth0 config, which forces Auth0 to ignore any cached SSO session and show the login screen even when a valid refresh token exists. A returning user with a fresh device session still gets the login prompt.",
        evidence: "AuthContext.tsx:88 (web) · nova/src/contexts/AuthContext.tsx:314 (mobile)",
      },
      {
        title: '"Sign in twice" — secondary cause',
        detail: "`isInitialized` resets to false whenever Auth0 SDK briefly toggles `isAuthenticated` (which happens during silent refresh). The auth-flow effect then re-runs `signInUserMutation` + `getMeQuery` — a second full sign-in roundtrip.",
        evidence: "AuthContext.tsx:417–426",
      },
      {
        title: "Silent redirect-to-login on transient error",
        detail: "`getToken` retries `getAccessTokenSilently` once with `cacheMode: 'off'`; if that also fails (network blip, 429), it calls `loginWithRedirect` with no warning. Indistinguishable from session expiry by the user.",
        evidence: "AuthContext.tsx:218–247",
      },
      {
        title: "Management API token not cached",
        detail: "`fetchEmailFromAuth0` and `Auth0RoleService::addRole` independently fetch fresh Management API tokens on every login, even within the same request. The token has a 24-hour TTL — caching saves 2+ HTTP calls per login.",
        evidence: "SignInUserMutation.php:425–434 · Auth0RoleService.php:24–32",
      },
    ],
    recommendations: [
      { title: "Consolidate native iOS auth onto a single SDK path", why: "PWA works because Auth0's React SDK handles token storage, silent refresh, and AppState transitions correctly. Native iOS reimplements all three manually and gets each one slightly wrong. Either (a) move Nova to Capacitor + Auth0 SDK for parity, or (b) wrap the manual flow with: AppState listener → silent refresh on foreground; retry-with-backoff on the refresh POST; deferred Keychain reads gated on `isReady`. Pilot-blocker because it's the bug users feel most.", effort: "1 day (option b) · 2–3 days (option a)", fixPath: "services/nova/src/contexts/AuthContext.tsx (restore + refresh) · expo-secure-store calls · add AppState.addEventListener" },
      { title: "Drop `prompt: 'login'`", why: "Returning users with valid refresh tokens should not see Auth0's login screen. This is the single biggest fix for the 'sign in twice' report.", effort: "1 hr", fixPath: "lib/zunou-react/contexts/AuthContext.tsx:88 · nova/src/contexts/AuthContext.tsx:314" },
      { title: "Cache Auth0 Management API token", why: "24-hour TTL. Saves 2 HTTP calls per login (~700ms on iOS).", effort: "2 hr", fixPath: "services/api/app/Services/Auth0RoleService.php:24–32 · SignInUserMutation.php:425–434" },
      { title: "Make `ensureUserHasPersonalPulses` a background job", why: "Today it blocks the sign-in response with N+1 DB queries. The user's first session doesn't need pulses provisioned synchronously — the bootstrap query fetches them on demand.", effort: "3 hr", fixPath: "services/api/app/GraphQL/Mutations/SignInUserMutation.php:407,585–605 → new Job class" },
      { title: "Remove the redundant `getMeQuery`", why: "`signInUserMutation` already returns the user. The second call is dead weight — saves a full roundtrip.", effort: "30 min", fixPath: "lib/zunou-react/contexts/AuthContext.tsx:286–342" },
      { title: "Don't reset `isInitialized` on every `auth0IsAuthenticated` flip", why: "Use a one-shot ref to gate `handleAuthFlow`. Eliminates the double sign-in.", effort: "2 hr", fixPath: "lib/zunou-react/contexts/AuthContext.tsx:417–426" },
      { title: "Replace `loginWithRedirect` fallback with a typed retry toast", why: "Transient errors should surface a 'try again' UI, not silently bounce the user back through Auth0.", effort: "3 hr", fixPath: "lib/zunou-react/contexts/AuthContext.tsx:218–247" },
      { title: "Remove the 100ms safety buffer", why: "The comment already admits it 'may work without it.' Test and delete.", effort: "30 min", fixPath: "lib/zunou-react/contexts/AuthContext.tsx:399–405" },
    ],
  },
