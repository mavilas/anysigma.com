---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import {
  MessageSquare,
  KeyRound,
  CheckCircle2,
  CircleDashed,
  Zap,
  GitCommitHorizontal,
  Blocks,
  AlertCircle,
  Check,
  UsersRound,
  Building2,
  Users,
  User,
  GitPullRequest,
  ShieldCheck,
  Lock,
  Shield,
  Activity,
  Circle,
  Wrench,
  LineChart,
  ArrowLeft,
  Calendar,
} from "@lucide/astro";

const agenda = [
  { id: "frame", label: "Frame" },
  { id: "ready", label: "Ready" },
  { id: "pending", label: "Pending" },
  { id: "wins", label: "Easy wins" },
  { id: "balance", label: "Balance" },
  { id: "talk", label: "Talking points" },
];

const archetypes = [
  { name: "Community", icon: UsersRound },
  { name: "Company",   icon: Building2 },
  { name: "Team",      icon: Users },
  { name: "Solo",      icon: User },
];

const ready = [
  { brick: "Composable onboarding phases", where: "services/nova/src/onboarding/buildPhases.ts", why: "Already keyed by entry point (new-user, invited, new-org, replay-workspace). The skeleton for archetype-driven flows exists." },
  { brick: "Home template registry, 12 widgets", where: "services/nova/.../useHomeLayoutStore.ts", why: "executive, maker, focus, meeting-heavy, minimal. Each is a Lego configuration of widgets with smart-hide rules." },
  { brick: "Pulse model with categories", where: "PulseCategory: PERSONAL, ONETOONE, TEAM", why: "The container is already polymorphic. We just don't expose the shape choice at signup." },
  { brick: "Pluggable agents + 15 data sources", where: "AiAgentType + DataSource models", why: "Slack, GitHub, Jira, Zunou agents and a deep ingestion surface. Already swappable per archetype." },
  { brick: "Embeddable Agent SDK", where: "services/agent", why: "Same brain runs in Dashboard, Nova, Launch event. We can drop the agent into any beachhead surface." },
  { brick: "132 PHPUnit tests on the API", where: "services/api/tests", why: "Already written. Not gating CI today. Wiring them in is one line of YAML." },
];

const pending = [
  { gap: "Account archetype at signup", impact: "Today the user has to guess which template fits. Pre-select widgets, agents, sources from one choice: Community vs Company vs Team vs Solo.", size: "S" },
  { gap: "Vocabulary unification", impact: "Organization, Workspace, Pulse, Team used interchangeably. CreateOrgPhase header says \"workspace\" but the mutation is createOrganization.", size: "S" },
  { gap: "Real use-case Pulse templates", impact: "pulseTemplates.json has 4 stubs with placeholder text. Replace with Investor Community, Eng Team, Sales Pod, Personal Operator.", size: "M" },
  { gap: "Deterministic 60-second magic moment", impact: "Today the payoff is auto-join meetings, which only fires if Google Calendar is linked. Skip it and the wow dies silently.", size: "M" },
  { gap: "Multi-tenant invariant tests", impact: "Roughly 90 raw SQL sites in services/api/app are unverified for organization_id scoping. One missed clause is a cross-tenant leak.", size: "L" },
  { gap: "Fail-closed JWT in two Lambdas", impact: "notification-hub and ai-proxy return {valid:true, skipped:true} when AUTH0_DOMAIN env is missing. A misconfigured deploy becomes a public endpoint.", size: "XS" },
];

const easyWins = [
  { title: "Wire pest into CI", body: "Add vendor/bin/pest to test-api.yml. 132 tests start gating PRs tomorrow. Would have caught the two reverts in the last 100 commits.", effort: "1 line of YAML", icon: GitPullRequest },
  { title: "Staging release depends on tests", body: "global-perform-staging-release.yml currently ships on push:staging with no test dependency. Add needs: [api, dashboard, slack].", effort: "3 lines", icon: ShieldCheck },
  { title: "Fail-closed JWT in Lambdas", body: "notification-hub/auth.mjs:43 and the ai-proxy mirror. Refuse to boot without AUTH0_DOMAIN. Jest test asserts the boot error.", effort: "about 30 min", icon: Lock },
  { title: "Verify Calendar webhook signature", body: "GoogleCalendarWebhookController treats X-Goog-Channel-Token as ID, not HMAC. Add signature check and a Pest feature test.", effort: "1 hour", icon: Shield },
  { title: "Sentry on every Lambda", body: "Pre-requisite for any SLO dashboard. Structured JSON logs and alerts. We stop finding regressions through user complaints.", effort: "half day", icon: Activity },
];

const sizeTone: Record<string, string> = {
  XS: "bg-[var(--color-success-soft)] text-[var(--color-success)]",
  S:  "bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)]",
  M:  "bg-[var(--color-warning-soft)] text-[var(--color-warning)]",
  L:  "bg-[var(--color-danger-soft)] text-[var(--color-danger)]",
};

const talkingPoints = [
  "The platform is dense in places. 12 home widgets, 15 data source types, 4 agent types. The onboarding doesn't yet let Kevin choose the shape of his beachhead. It asks him to assemble it.",
  "Lego framing: one new archetype is one manifest, not new code. Community = { widgets, agents Slack + Zunou, template focus, cadence weekly }. Kevin's beachhead becomes data, not a sprint.",
  "Stability is the unlock for trust. Roughly half of the last 100 commits are fixes and two were reverts on code that has unrun tests. The fix is mechanical: gate what exists.",
  "We don't need 100% coverage everywhere. We need the existing 132 tests to actually run, the multi-tenant invariant enforced once, and two Lambdas to fail-closed. That's the trust baseline.",
  "Balance: keep the build cadence, add one gate per service per week, watch the revert rate. If it drops, we shipped trust. If it doesn't, we revisit the next Friday.",
  "Communities vs companies isn't a fork. It's a starting Lego. Same platform, archetype-shaped first 60 seconds. Easy to change later because the bricks underneath don't move.",
];
---

<Layout
  title="Kevin prep · Zunou GTM"
  description="Internal discussion: what's ready to show Kevin, what's pending, and the easy wins that buy us trust."
  agenda={agenda}
>
  <style is:global>
    .keypoint {
      display: inline-flex; align-items: flex-start; gap: 10px;
      padding: 14px 18px;
      border: 1px solid var(--color-line);
      background: var(--color-paper);
      border-radius: 12px;
      max-width: 380px;
      font-size: 14px;
      line-height: 1.55;
      color: var(--color-ink);
    }
    .keypoint .label {
      font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--color-accent); margin-bottom: 4px; display: block; font-weight: 600;
    }
    .keypoint.on-ink {
      background: rgba(255,255,255,0.06);
      border-color: rgba(255,255,255,0.18);
      color: rgba(255,255,255,0.92);
    }
    .keypoint.on-ink .label { color: #c4b5fd; }

    .section-head-row {
      display: flex; gap: 28px; align-items: flex-start; justify-content: space-between;
      flex-wrap: wrap; margin-bottom: 28px;
    }
    .section-head-row > .spacer { flex: 1; min-width: 200px; }

    .lift {
      transition: transform .25s cubic-bezier(.2,.7,.2,1),
                  border-color .25s,
                  background-color .25s,
                  box-shadow .25s;
    }
    .lift:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(74, 0, 224, 0.06);
    }
  </style>

  <!-- HERO -->
  <section class="pt-12 sm:pt-20 pb-6">
    <div class="max-w-6xl mx-auto px-6">
      <div data-reveal="fade-up" class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--color-line)] bg-[var(--color-paper-soft)] text-xs uppercase tracking-[0.18em] text-[var(--color-ink-soft)] mb-6">
        <MessageSquare class="w-3.5 h-3.5 text-[var(--color-accent)]" />
        <span>Internal · Discussion · Kevin meeting</span>
      </div>

      <h1 data-reveal="fade-up" data-reveal-delay="1" class="font-display text-[2.75rem] sm:text-[4rem] lg:text-[4.75rem] leading-[1.04] tracking-tight mb-6 max-w-4xl">
        Stabilize so the team can <span class="text-[var(--color-accent)]">trust the build</span>. Then Lego the beachhead.
      </h1>

      <p data-reveal="fade-up" data-reveal-delay="2" class="text-lg sm:text-xl text-[var(--color-ink-soft)] max-w-[62ch] leading-[1.6]">
        The bricks are mostly in the box. Onboarding doesn't let Kevin choose the shape of his beachhead. It asks him to assemble it. Meanwhile we're shipping fast and breaking the same surface twice. Both problems have small, mechanical answers.
      </p>

      <div data-reveal="fade-up" data-reveal-delay="3" class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="border border-[var(--color-line)] bg-[var(--color-paper-soft)] rounded-lg px-5 py-4 lift">
          <div class="flex items-center gap-2 text-[var(--color-success)] mb-1.5">
            <CheckCircle2 class="w-4 h-4" />
            <span class="font-display text-3xl text-[var(--color-ink)]">6</span>
          </div>
          <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-ink-soft)] font-medium">Bricks ready</div>
        </div>
        <div class="border border-[var(--color-line)] bg-[var(--color-paper-soft)] rounded-lg px-5 py-4 lift">
          <div class="flex items-center gap-2 text-[var(--color-accent)] mb-1.5">
            <CircleDashed class="w-4 h-4" />
            <span class="font-display text-3xl text-[var(--color-ink)]">6</span>
          </div>
          <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-ink-soft)] font-medium">Gaps to close</div>
        </div>
        <div class="border border-[var(--color-line)] bg-[var(--color-paper-soft)] rounded-lg px-5 py-4 lift">
          <div class="flex items-center gap-2 text-[var(--color-accent)] mb-1.5">
            <Zap class="w-4 h-4" />
            <span class="font-display text-3xl text-[var(--color-ink)]">5</span>
          </div>
          <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-ink-soft)] font-medium">Easy wins</div>
        </div>
        <div class="border border-[var(--color-line)] bg-[var(--color-paper-soft)] rounded-lg px-5 py-4 lift">
          <div class="flex items-center gap-2 text-[var(--color-danger)] mb-1.5">
            <GitCommitHorizontal class="w-4 h-4" />
            <span class="font-display text-3xl text-[var(--color-ink)]">~50%</span>
          </div>
          <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-ink-soft)] font-medium">of last 100 commits are fixes</div>
        </div>
      </div>

      <div data-reveal="fade-up" data-reveal-delay="4" class="mt-10 flex flex-wrap gap-2 text-sm">
        <a href="#frame" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-[var(--color-ink)] text-[var(--color-paper)] hover:opacity-90 transition-opacity">
          <Blocks class="w-4 h-4" /> The frame
        </a>
        <a href="#ready" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md border border-[var(--color-line)] hover:bg-[var(--color-paper-soft)] transition-colors">
          <CheckCircle2 class="w-4 h-4 text-[var(--color-success)]" /> Ready
        </a>
        <a href="#pending" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md border border-[var(--color-line)] hover:bg-[var(--color-paper-soft)] transition-colors">
          <AlertCircle class="w-4 h-4 text-[var(--color-accent)]" /> Pending
        </a>
        <a href="#wins" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md border border-[var(--color-line)] hover:bg-[var(--color-paper-soft)] transition-colors">
          <Zap class="w-4 h-4 text-[var(--color-accent)]" /> Easy wins
        </a>
        <a href="#talk" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md border border-[var(--color-line)] hover:bg-[var(--color-paper-soft)] transition-colors">
          <MessageSquare class="w-4 h-4" /> Talking points
        </a>
      </div>
    </div>
  </section>

  <!-- FRAME -->
  <Section
    id="frame"
    number="01"
    tone="soft"
    eyebrow="The frame"
    title="The platform is a Lego set. The pitch should be too."
    lede="One platform. Four archetypes at signup, each bundling widgets, agents, data sources, and cadence. Kevin's beachhead becomes a new manifest, not a new sprint."
  >
    <div data-reveal="fade-up" class="section-head-row">
      <div class="spacer"></div>
      <div class="keypoint">
        <KeyRound class="w-4 h-4 text-[var(--color-accent)] shrink-0 mt-0.5" />
        <div>
          <span class="label">Key point</span>
          Make the shape choice explicit at signup. Assembly is our job, not the user's.
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-4 gap-3">
      {archetypes.map((a, i) => (
        <div data-reveal="fade-up" data-reveal-delay={i + 1} class="group relative border border-[var(--color-line)] bg-[var(--color-paper)] rounded-lg p-5 lift hover:border-[var(--color-accent)]">
          <div class="flex items-center justify-between">
            <a.icon class="w-5 h-5 text-[var(--color-accent)]" />
            <span class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-faint)]">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="font-display text-2xl mt-3 mb-3">{a.name}</div>
          <div class="flex flex-wrap gap-1.5">
            {["widgets", "agents", "sources", "cadence"].map((c) => (
              <span class="px-2 py-0.5 rounded text-[10px] uppercase tracking-[0.12em] bg-[var(--color-paper-soft)] border border-[var(--color-line)] text-[var(--color-ink-soft)]">{c}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- READY -->
  <Section
    id="ready"
    number="02"
    eyebrow="Ready"
    title="Bricks already in the box."
    lede="The platform we'd assemble Kevin's beachhead from. It just isn't visible to a new user yet."
  >
    <div data-reveal="fade-up" class="section-head-row">
      <div class="spacer"></div>
      <div class="keypoint">
        <KeyRound class="w-4 h-4 text-[var(--color-accent)] shrink-0 mt-0.5" />
        <div>
          <span class="label">Key point</span>
          We don't need to build the Lego set. We need to put the lid on the box so the customer sees the picture.
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      {ready.map((r, i) => (
        <div data-reveal="fade-up" data-reveal-delay={(i % 3) + 1} class="border border-[var(--color-line)] bg-[var(--color-paper)] rounded-lg p-5 lift hover:border-[var(--color-accent)]">
          <div class="flex items-start gap-3">
            <div class="mt-0.5 shrink-0 w-7 h-7 rounded-full bg-[var(--color-success-soft)] flex items-center justify-center">
              <Check class="w-3.5 h-3.5 text-[var(--color-success)]" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-display text-lg">{r.brick}</div>
              <code class="text-xs text-[var(--color-ink-faint)] font-mono break-all">{r.where}</code>
              <p class="text-sm mt-2 text-[var(--color-ink-soft)] leading-[1.55]">{r.why}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- PENDING -->
  <Section
    id="pending"
    number="03"
    tone="soft"
    eyebrow="Pending"
    title="Gaps to close before Kevin."
    lede="Ordered by sequence, not size. The first two unlock the rest."
  >
    <div data-reveal="fade-up" class="section-head-row">
      <div class="spacer"></div>
      <div class="keypoint">
        <KeyRound class="w-4 h-4 text-[var(--color-accent)] shrink-0 mt-0.5" />
        <div>
          <span class="label">Key point</span>
          Most gaps are S/M. A focused week buys us the demo, not a quarter.
        </div>
      </div>
    </div>

    <div class="space-y-3">
      {pending.map((p, i) => (
        <div data-reveal="fade-up" data-reveal-delay={(i % 3) + 1} class="border border-[var(--color-line)] bg-[var(--color-paper)] rounded-lg p-5 lift hover:border-[var(--color-accent)]">
          <div class="flex items-start gap-4">
            <div class="font-display text-3xl text-[var(--color-ink-faint)] w-12 shrink-0">{String(i + 1).padStart(2, "0")}</div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 flex-wrap">
                <div class="font-display text-lg">{p.gap}</div>
                <span class={`text-[10px] uppercase tracking-[0.18em] px-2 py-0.5 rounded font-semibold ${sizeTone[p.size]}`}>{p.size}</span>
              </div>
              <p class="text-sm mt-2 text-[var(--color-ink-soft)] leading-[1.55]">{p.impact}</p>
            </div>
            <AlertCircle class="w-5 h-5 text-[var(--color-accent)] shrink-0 mt-1" />
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- EASY WINS -->
  <Section
    id="wins"
    number="04"
    eyebrow="Easy wins"
    title="Stabilize so the team can trust the build."
    lede="Five mechanical moves. Total effort: less than one engineer day. Each removes a category of recurring pain."
  >
    <div data-reveal="fade-up" class="section-head-row">
      <div class="spacer"></div>
      <div class="keypoint">
        <KeyRound class="w-4 h-4 text-[var(--color-accent)] shrink-0 mt-0.5" />
        <div>
          <span class="label">Key point</span>
          The tests already exist. We just aren't running them. One line of YAML buys back trust.
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {easyWins.map((w, i) => (
        <div data-reveal="fade-up" data-reveal-delay={(i % 3) + 1} class="border border-[var(--color-line)] bg-[var(--color-paper)] rounded-lg p-5 lift group hover:bg-[var(--color-ink)] hover:text-[var(--color-paper)] hover:border-[var(--color-ink)]">
          <div class="flex items-center justify-between mb-3">
            <w.icon class="w-5 h-5 text-[var(--color-accent)] group-hover:text-[#c4b5fd] transition-colors" />
            <span class="text-[10px] uppercase tracking-[0.18em] opacity-70 font-medium">{w.effort}</span>
          </div>
          <div class="font-display text-xl mb-2">{w.title}</div>
          <p class="text-sm opacity-80 leading-[1.55]">{w.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- BALANCE -->
  <Section
    id="balance"
    number="05"
    tone="ink"
    eyebrow="The balance"
    title="Keep the build cadence. Add one gate per service per week."
    lede="The team being deep in build mode is the right posture for this stage. The risk isn't velocity. It's that the surface they ship today doesn't hold under tomorrow's user. Trust is what lets us go faster with confidence, not slower."
  >
    <div data-reveal="fade-up" class="section-head-row">
      <div class="spacer"></div>
      <div class="keypoint on-ink">
        <KeyRound class="w-4 h-4 text-[#c4b5fd] shrink-0 mt-0.5" />
        <div>
          <span class="label">Key point</span>
          Velocity and trust aren't a trade-off when the gates run on every PR.
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-3 gap-4">
      <div data-reveal="fade-up" data-reveal-delay="1" class="border border-white/15 rounded-lg p-5 lift">
        <div class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-[var(--color-paper-soft)] font-medium">
          <Circle class="w-3 h-3" /> Today
        </div>
        <div class="font-display text-2xl mt-2">Build velocity high</div>
        <div class="text-sm text-[var(--color-paper-soft)] mt-2 leading-[1.55]">but roughly half of commits are fixes, two reverts in the last 100, mobile ships with zero tests.</div>
      </div>
      <div data-reveal="fade-up" data-reveal-delay="2" class="border border-white/15 rounded-lg p-5 lift">
        <div class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-[var(--color-paper-soft)] font-medium">
          <Wrench class="w-3.5 h-3.5" /> Next 2 weeks
        </div>
        <div class="font-display text-2xl mt-2">Gate what exists</div>
        <div class="text-sm text-[var(--color-paper-soft)] mt-2 leading-[1.55]">wire pest, vitest, lambda Jest into PR-time CI. Cost: a few lines of YAML.</div>
      </div>
      <div data-reveal="fade-up" data-reveal-delay="3" class="border border-white/15 rounded-lg p-5 lift">
        <div class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-[var(--color-paper-soft)] font-medium">
          <LineChart class="w-3.5 h-3.5" /> Then
        </div>
        <div class="font-display text-2xl mt-2">Watch the revert rate</div>
        <div class="text-sm text-[var(--color-paper-soft)] mt-2 leading-[1.55]">if it drops, we shipped trust. If not, we revisit the next Friday. Honest signal, no theater.</div>
      </div>
    </div>
  </Section>

  <!-- TALKING POINTS -->
  <Section
    id="talk"
    number="06"
    eyebrow="Talking points"
    title="For the room, not for the slide."
    lede="Six prompts to bring into the conversation with Kevin and the team."
  >
    <div data-reveal="fade-up" class="section-head-row">
      <div class="spacer"></div>
      <div class="keypoint">
        <KeyRound class="w-4 h-4 text-[var(--color-accent)] shrink-0 mt-0.5" />
        <div>
          <span class="label">Key point</span>
          Open with the Lego framing. Close with the revert rate as the trust metric.
        </div>
      </div>
    </div>

    <ol class="space-y-3 list-none p-0 m-0">
      {talkingPoints.map((t, i) => (
        <li data-reveal="fade-up" data-reveal-delay={(i % 3) + 1} class="flex items-start gap-4 border-l-2 border-[var(--color-accent)] pl-5 py-1.5">
          <span class="font-mono text-xs text-[var(--color-ink-faint)] mt-1.5 shrink-0">0{i + 1}</span>
          <p class="text-base leading-[1.6] m-0">{t}</p>
        </li>
      ))}
    </ol>

    <div class="mt-12 border-t border-[var(--color-line)] pt-8 flex flex-wrap gap-6 text-sm text-[var(--color-ink-soft)]">
      <a href="/" class="inline-flex items-center gap-1.5 hover:text-[var(--color-ink)] transition-colors">
        <ArrowLeft class="w-4 h-4" /> back to overview
      </a>
      <a href="/pilots/indelible" class="inline-flex items-center gap-1.5 hover:text-[var(--color-ink)] transition-colors">
        <MessageSquare class="w-4 h-4" /> Indelible pilot prep
      </a>
      <span class="inline-flex items-center gap-1.5">
        <Calendar class="w-4 h-4 text-[var(--color-accent)]" /> Prepared for the team
      </span>
    </div>
  </Section>
</Layout>
