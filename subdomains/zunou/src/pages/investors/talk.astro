---
import Layout from "../../layouts/Layout.astro";
import {
  Mic,
  Clock,
  ArrowRight,
  Target,
  Sparkles,
  Cpu,
  Rocket,
  Calendar,
  Handshake,
  BookOpen,
} from "@lucide/astro";

interface Beat {
  range: string;
  mins: number;
  title: string;
  icon: any;
  anchor: string;
  hits: string[];
  what: string;
}

const beats: Beat[] = [
  {
    range: "0 to 2",
    mins: 2,
    title: "Hook · the argument in one paragraph",
    icon: Sparkles,
    anchor: "/investors#top",
    hits: [
      "Open the page on the investor's laptop.",
      "Read the accent-bordered thesis card out loud, slowly.",
      "Land on: 'The exec workflow surface is open. We're built for the Slack-native team, globally.'",
    ],
    what: "Set the frame. The connector is going to repeat this paragraph in their words to other investors. Make it land verbatim.",
  },
  {
    range: "2 to 5",
    mins: 3,
    title: "Touch it · demo on their phone",
    icon: Mic,
    anchor: "/investors#touch",
    hits: [
      "Demo URL (demo.zunou.ai) is not live yet — ships in Phase 0. Walk this section as the concrete commitment, not a click-through.",
      "Frame the seed contents: 6 personas, 3 weeks of meetings, the aha follow-up the agent surfaces unprompted.",
      "Point to the open follow-up: 'Tanaka-san asked about Q3 ARR last Tuesday. You haven't responded.'",
      "Pause 5 seconds. That moment is what we're engineering for in Phase 0.",
    ],
    what: "Until demo.zunou.ai is live, this beat is a commitment to ship, not a product walkthrough. Loom's playbook is the destination; today you're framing the path. After this beat, the meeting changes register.",
  },
  {
    range: "5 to 8",
    mins: 3,
    title: "The product is real · architecture proof",
    icon: Cpu,
    anchor: "/investors#section-01",
    hits: [
      "136 agent tools, 15 sources, 12 widgets.",
      "Voice Agent on Realtime, autonomous Relays, MCP-native, embeddable SDK.",
      "Cite: 'every claim is in /journeys with a file:line citation.'",
    ],
    what: "Close the door on 'is this real?' before they ask. Architecture density is the proof they can repeat to other investors.",
  },
  {
    range: "8 to 11",
    mins: 3,
    title: "Why now · the three observations",
    icon: Rocket,
    anchor: "/investors#section-02",
    hits: [
      "Sakana / LayerX / KDDI-ELYZA / Rakuten — funded but not in our lane.",
      "Copilot and Glean don't reach the Slack-native + Google-native team, globally.",
      "MCP triage replaces by gravity — they keep WhatsApp / LINE habits.",
    ],
    what: "Why this window won't be open in 12 months. The wedge mechanic is the most novel idea on the page; emphasize it.",
  },
  {
    range: "11 to 14",
    mins: 3,
    title: "Three beachhead waves",
    icon: Target,
    anchor: "/investors#section-03",
    hits: [
      "Beachhead 0 · Indelible · confirmed (point to /pilots/indelible if they want depth).",
      "Beachhead 1 · TAI Tokyo · Ilya-introduced · late July or early August 2026.",
      "Beachhead 2 · 6,500 reachable across 13 layered communities.",
      "Stage-gate Feb 2027: 4 of 6 PMF criteria triggers fuel; 2 or fewer triggers pivot; 3 triggers a 60-day extension.",
    ],
    what: "The pre-committed kill criterion is the discipline signal. Investors and connectors trust founders who name their pivot in advance.",
  },
  {
    range: "14 to 16",
    mins: 2,
    title: "The horizon · PMF first, ARR follows",
    icon: Calendar,
    anchor: "/investors#section-04",
    hits: [
      "Months 1-3 activation. Months 3-6 paid validation. Months 6-12 compound.",
      "ARR locks after month-3 paid signal, not before.",
      "The year-1 ARR number locks after paid signal, not before. Financial model is still being built around that gate.",
    ],
    what: "The honest framing. We are not faking a hockey stick. This is the line that separates us from pitches the connector has heard six times this month.",
  },
  {
    range: "16 to 20",
    mins: 4,
    title: "Where we'd value your view · open the room",
    icon: Handshake,
    anchor: "/investors#views",
    hits: [
      "Walk the 7 open calls quickly (one minute). Don't defend any of them yet.",
      "Direct frame: 'These are the calls we've taken a position on but kept open for pressure-testing. Where would you take a different position, and why?'",
      "Note what he reacts to fastest. Those are the ones to follow up on.",
      "Close: 'Tell us where we're wrong. Wherever you'd take a different position, that's the most useful thing you can give us today.'",
      "Stay silent after that line. He speaks next.",
    ],
    what: "He's already an investor. Don't pitch, don't ask. Use the full 4 minutes (no team slide to spend time on) to extract his sharpest read on the calls we're least sure about. Number 07 (parallel-tracks compounding) is the most valuable answer he could give you.",
  },
];

const followUps = [
  { q: "How do you measure activation?", anchor: "/gtm#mechanic", what: "Magic number: 5 events + 1 magic moment + 3 returns in 14 days." },
  { q: "Why start in SEA / Tokyo, not the US?", anchor: "/gtm#posture", what: "We're based where Marco is, and the warm-network density in SEA + Tokyo is the highest available to us. Density manufactures PMF; loose US distribution scatters signal. The product itself is global from day one." },
  { q: "What's broken today?", anchor: "/pilots/readiness", what: "Honest readiness audit. 16 PMF-gate items, 2.5 weeks. We name the gaps, we don't hide them." },
  { q: "Can I see real users?", anchor: "/pilots/indelible", what: "Kevin Brockland · Indelible Ventures. Three sequenced use cases scoped from the meeting." },
  { q: "How do you measure success week 1?", anchor: "/dashboard", what: "Five PostHog / Metabase / Grafana dashboards. Monday-morning ritual." },
];

const total = beats.reduce((s, b) => s + b.mins, 0);
---

<Layout
  title="Zunou · Investor talk track (speaker notes)"
  description="Speaker notes for Marco. 20-minute pitch flow with section anchors. Internal."
  kind="scan"
>
  <!-- TOP BANNER -->
  <div class="border-b border-[var(--color-accent)]/40 bg-[var(--color-accent-soft)]/60">
    <div class="max-w-4xl mx-auto px-6 py-2.5 flex items-center justify-between gap-4 flex-wrap text-sm">
      <div class="flex items-baseline gap-2 flex-wrap min-w-0">
        <span class="text-[10px] uppercase tracking-[0.18em] font-mono font-bold text-[var(--color-accent-ink)] shrink-0">Investors / talk track</span>
        <span class="text-[var(--color-ink)]">Speaker notes. Open on your laptop. The investor sees /investors.</span>
      </div>
      <a href="/investors" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] inline-flex items-center gap-1 text-xs">
        <span>Open /investors</span><ArrowRight class="w-3 h-3" />
      </a>
    </div>
  </div>

  <!-- HERO -->
  <section class="pt-16 sm:pt-20 pb-10">
    <div class="max-w-4xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-6 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Mic class="w-3.5 h-3.5" />
          Speaker notes
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">{total} min · 8 beats · Marco only</span>
      </div>

      <h1 class="font-display text-[2.25rem] sm:text-[3rem] leading-[1.0] tracking-tight mb-4" data-reveal="fade-up" data-reveal-delay="1">
        20 minutes. 8 beats. Every beat anchored.
      </h1>

      <p class="text-base sm:text-lg text-[var(--color-ink-soft)] leading-relaxed max-w-3xl" data-reveal="fade-up" data-reveal-delay="2">
        Scroll-synced to <code class="inline-code">/investors</code>. Each beat lists the anchor to navigate to on the investor's screen, what to say, and what the takeaway is. Beats 2 (demo) and 8 (ask) are non-negotiable; the others can compress if time runs short.
      </p>
    </div>
  </section>

  <hr class="section-rule max-w-4xl mx-auto" />

  <!-- BEATS -->
  <section class="py-10">
    <div class="max-w-4xl mx-auto px-6">
      <div class="flex items-center gap-2 mb-6" data-reveal="fade-up">
        <Clock class="w-4 h-4 text-[var(--color-accent)]" />
        <h2 class="text-xs uppercase tracking-[0.18em] font-bold text-[var(--color-accent)]">The 20-minute flow</h2>
      </div>

      <div class="space-y-3">
        {beats.map((b, i) => (
          <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-5" data-reveal="fade-up" data-reveal-delay={(i % 4) + 1}>
            <div class="flex items-baseline justify-between gap-4 mb-3 flex-wrap">
              <div class="flex items-center gap-3">
                <span class="font-mono text-[11px] uppercase tracking-[0.18em] font-bold text-[var(--color-accent)]">
                  Min {b.range}
                </span>
                <b.icon class="w-4 h-4 text-[var(--color-accent)]" />
                <span class="font-display text-xl text-[var(--color-ink)]">{b.title}</span>
              </div>
              <a href={b.anchor} class="text-xs font-mono text-[var(--color-ink-faint)] hover:text-[var(--color-accent)] inline-flex items-center gap-1">
                {b.anchor} <ArrowRight class="w-3 h-3" />
              </a>
            </div>
            <ul class="text-sm text-[var(--color-ink-soft)] leading-relaxed space-y-1 mb-3">
              {b.hits.map((h) => <li>· {h}</li>)}
            </ul>
            <p class="text-xs text-[var(--color-ink-faint)] italic leading-relaxed">
              {b.what}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-4xl mx-auto" />

  <!-- FOLLOW-UP QUESTIONS -->
  <section class="py-10">
    <div class="max-w-4xl mx-auto px-6">
      <div class="flex items-center gap-2 mb-6" data-reveal="fade-up">
        <BookOpen class="w-4 h-4 text-[var(--color-accent)]" />
        <h2 class="text-xs uppercase tracking-[0.18em] font-bold text-[var(--color-accent)]">If they ask &mdash; deep-link cheat sheet</h2>
      </div>
      <p class="text-base text-[var(--color-ink)] leading-relaxed mb-5 max-w-3xl" data-reveal="fade-up">
        Common follow-up questions. Don't navigate unless asked &mdash; the talk track stays on /investors. But know where to go.
      </p>
      <div class="grid sm:grid-cols-2 gap-3" data-reveal="fade-up" data-reveal-delay="1">
        {followUps.map((f) => (
          <div class="rounded-lg border border-[var(--color-line)] bg-[var(--color-paper)] p-4">
            <div class="font-semibold text-sm mb-1 text-[var(--color-ink)]">{f.q}</div>
            <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-2">{f.what}</p>
            <a href={f.anchor} class="text-xs font-mono text-[var(--color-accent)] hover:text-[var(--color-ink)] inline-flex items-center gap-1">
              {f.anchor} <ArrowRight class="w-3 h-3" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-4xl mx-auto" />

  <!-- COMPRESS NOTES -->
  <section class="py-10">
    <div class="max-w-4xl mx-auto px-6">
      <div class="flex items-center gap-2 mb-6" data-reveal="fade-up">
        <Target class="w-4 h-4 text-[var(--color-accent)]" />
        <h2 class="text-xs uppercase tracking-[0.18em] font-bold text-[var(--color-accent)]">If time runs short</h2>
      </div>
      <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-5" data-reveal="fade-up">
        <p class="text-base text-[var(--color-ink-soft)] leading-relaxed mb-4">
          The two beats that cannot drop are <strong class="text-[var(--color-ink)]">beat 2 (touch it)</strong> and <strong class="text-[var(--color-ink)]">beat 8 (the ask)</strong>. Everything else compresses.
        </p>
        <ul class="text-sm text-[var(--color-ink-soft)] leading-relaxed space-y-1.5">
          <li>· <strong class="text-[var(--color-ink)]">12-minute cut:</strong> hook (2) + touch (3) + product (2, compressed) + beachheads (3) + views (2). Drop why-now and horizon.</li>
          <li>· <strong class="text-[var(--color-ink)]">15-minute cut:</strong> add back why-now (3 min). Skip horizon.</li>
          <li>· <strong class="text-[var(--color-ink)]">10-minute cut:</strong> hook (1) + touch (3) + beachheads (3) + ask (2) + 1 min for one question. Architecture proof is implied by the demo.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-6 text-center" data-reveal="fade-up">
      <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-3">
        Speaker notes only. Direct link: <code class="inline-code">zunou.anysigma.com/investors/talk</code>
      </p>
      <p class="text-xs text-[var(--color-ink-faint)] italic">
        Marco Avila · do not share
      </p>
    </div>
  </section>
</Layout>
