        <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-5 border-l-4 border-l-[var(--color-warning)]" data-reveal="fade-up" data-reveal-delay="1">
          <div class="flex items-center gap-2 mb-2">
