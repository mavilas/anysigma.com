  <!-- §04 PRE-FLIGHT -->
  <section class="py-16 sm:py-20 bg-[var(--color-paper-soft)]" id="preflight">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-5" data-reveal="fade-up">
        <span class="section-number"><span>04</span></span>
        <span class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">Pre-flight blockers</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl mb-5 max-w-3xl leading-tight" data-reveal="fade-up" data-reveal-delay="1">
        What has to be true before the pilot opens.
      </h2>
      <p class="text-lg leading-relaxed text-[var(--color-ink-soft)] max-w-3xl mb-10" data-reveal="fade-up" data-reveal-delay="2">
        Kevin is Android — PWA covers him for ~6 weeks. But his portfolio is mixed. iOS bugs we already documented in <a href="/foundation#tier-1" class="text-[var(--color-accent-ink)] hover:underline font-semibold">Foundation Tier-1</a> become hard pre-flight requirements for this pilot, not just future improvements. <strong class="text-[var(--color-ink)]">Burning a portfolio founder on day one because of a sign-in bug is the worst thing we can do — Kevin loses face with his founder, and the pilot's activation read collapses.</strong>
      </p>

      {[
        { items: blocking, title: "Blocking · must clear before pilot opens", color: "danger", chip: "BLOCKING" },
        { items: inFlight, title: "In flight · should clear in parallel with pilot prep", color: "warning", chip: "IN FLIGHT" },
        { items: ready, title: "Ready or near-ready", color: "success", chip: "READY" },
      ].map((group) => group.items.length > 0 && (
        <div class="mb-10">
          <h3 class:list={[
            "font-display text-xl mb-4 flex items-center gap-2",
            group.color === "danger" && "text-[var(--color-danger)]",
            group.color === "warning" && "text-[var(--color-warning)]",
            group.color === "success" && "text-[var(--color-success)]",
          ]} data-reveal="fade-up">
            {group.color === "danger" && <XCircle class="w-5 h-5" />}
            {group.color === "warning" && <AlertTriangle class="w-5 h-5" />}
            {group.color === "success" && <CheckCircle2 class="w-5 h-5" />}
            <span>{group.title}</span>
            <span class="text-xs font-mono text-[var(--color-ink-faint)]">({group.items.length})</span>
          </h3>
          <div class="space-y-2">
            {group.items.map((p, i) => (
              <div class="grid grid-cols-[2.25rem_1fr_auto] gap-3 items-start rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-4 hover:border-[var(--color-ink-faint)] transition-all" data-reveal="fade-up" data-reveal-delay={Math.min(i, 4)}>
                <div class:list={[
                  "w-8 h-8 rounded-lg flex items-center justify-center text-xs",
                  p.area === "iOS" && "bg-[var(--color-danger-soft)] text-[var(--color-danger)]",
                  p.area === "Onboarding" && "bg-[var(--color-warning-soft)] text-[var(--color-warning)]",
                  p.area === "Notifications" && "bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)]",
                  p.area === "Android" && "bg-[var(--color-success-soft)] text-[var(--color-success)]",
                  p.area === "Product" && "bg-[var(--color-paper-soft)] text-[var(--color-ink-soft)] border border-[var(--color-line)]",
                ]}>
                  {p.area === "iOS" && <Apple class="w-4 h-4" />}
                  {p.area === "Onboarding" && <KeyRound class="w-4 h-4" />}
                  {p.area === "Notifications" && <Bell class="w-4 h-4" />}
                  {p.area === "Android" && <Smartphone class="w-4 h-4" />}
                  {p.area === "Product" && <Sparkles class="w-4 h-4" />}
                </div>
                <div>
                  <h4 class="font-display text-base leading-tight mb-1">{p.title}</h4>
                  <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-2">{p.why}</p>
                  {p.link && (
                    <a href={p.link.href} class="inline-flex items-center gap-1 text-xs font-mono text-[var(--color-accent-ink)] hover:underline">
                      <ArrowRight class="w-3 h-3" />{p.link.label}
                    </a>
