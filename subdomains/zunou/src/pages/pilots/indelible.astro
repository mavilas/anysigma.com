---
import Layout from "../../layouts/Layout.astro";
import {
  Handshake,
  CircleDot,
  Target,
  Flag,
  Layers,
  Users,
  Calendar,
  GraduationCap,
  Smartphone,
  Apple,
  CheckCircle2,
  XCircle,
  AlertTriangle,
  Clock,
  Hourglass,
  ArrowRight,
  Globe,
  Lock,
  KeyRound,
  Bell,
  ExternalLink,
  ListChecks,
  Sparkles,
  CircleHelp,
  Wrench,
  Bug,
  Building2,
  Map as MapIcon,
  Compass,
  Mic,
  MessageSquare,
} from "@lucide/astro";

/* ====== Pre-flight requirements before the pilot opens ====== */
type PreFlightStatus = "blocking" | "in-flight" | "ready";
interface PreFlightItem {
  area: "iOS" | "Onboarding" | "Notifications" | "Android" | "Product";
  title: string;
  why: string;
  status: PreFlightStatus;
  link?: { label: string; href: string };
  effort: string;
}

const preFlight: PreFlightItem[] = [
  {
    area: "iOS",
    title: "Fix native iOS auth — \"keeps kicking users out\"",
    why: "Kevin uses Android (PWA fine for him), but his portfolio is mixed. iOS founders bouncing on cold-start kills the cohort activation read. PWA fallback isn't acceptable when the rest of TAI is on iOS.",
    status: "blocking",
    link: { label: "Foundation Tier-1 #06 + Journeys §J1", href: "/foundation#tier-1" },
    effort: "1 day (option b) · 2–3 days (option a)",
  },
  {
    area: "iOS",
    title: "Drop `prompt: 'login'` — \"sign in twice\"",
    why: "One-line fix. Returning iOS users see the login screen on every cold start; some give up before they sign in once.",
    status: "blocking",
    link: { label: "Journeys §J1 → Drop prompt: 'login'", href: "/journeys#j-sign-in" },
    effort: "1 hr",
  },
  {
    area: "iOS",
    title: "Make `upsertNovaSettingMetadata` blocking before navigation",
    why: "If the GQL save returns mid-background, iOS user re-onboards on next session — looks like \"sign in twice\" from their POV. Will hit Indelible founders the day after the pilot opens.",
    status: "blocking",
    link: { label: "Journeys §J2 onboarding bug", href: "/journeys#j-onboarding" },
    effort: "1 hr",
  },
  {
    area: "Onboarding",
    title: "Verify production onboarding end-to-end with a fresh pilot account",
    why: "Onboarding rebuilt recently; production behavior hasn't been validated by a non-team user. A broken first session = magic-number activation reads as 0%, regardless of how good the rest of the pitch is.",
    status: "in-flight",
    link: { label: "Foundation Tier-1 #01", href: "/foundation#tier-1" },
    effort: "1 day",
  },
  {
    area: "Onboarding",
    title: "Web DM flow restored",
    why: "If anyone in Kevin's portfolio demos on a laptop (likely — investors check things on desktop), the missing /dashboard DM path looks like a half-built product.",
    status: "blocking",
    link: { label: "Foundation Tier-1 #02 + Journeys §J4", href: "/foundation#tier-1" },
    effort: "2–3 days",
  },
  {
    area: "Notifications",
    title: "Notification outbox + idempotency + DLQ",
    why: "Indelible portfolio = 20–40 founders messaging each other in a private pulse. Every silently-dropped @mention is a broken trust moment. Outbox is the cheapest insurance.",
    status: "in-flight",
    link: { label: "Foundation Tier-1 #10", href: "/foundation#tier-1" },
    effort: "1–2 wk",
  },
  {
    area: "Notifications",
    title: "Surface per-channel mute in conversation header",
    why: "Volume in the portfolio pulse will spike. If they can't tame the noise per-channel without nuking everything, they'll mute the whole product. Already exists in backend — just expose it.",
    status: "in-flight",
    link: { label: "Foundation Tier-1 #03", href: "/foundation#tier-1" },
    effort: "1 day",
  },
  {
    area: "Android",
    title: "Confirm PWA on Android Chrome — install, push, badge",
    why: "Kevin's primary device. PWA must support add-to-home-screen, push notifications via Web Push, and badge counts. Test on his exact device before the next meeting.",
    status: "in-flight",
    link: { label: "Journeys §J1 (web push path)", href: "/journeys#j-sign-in" },
    effort: "0.5 day verify · 2 days fix any gaps",
  },
  {
    area: "Android",
    title: "Native Android build → Google Play internal testing",
    why: "PWA is fine for the next 4–6 weeks but native unlocks better push reliability + background sync. Capacitor or Expo build (we have iOS already). Aim for internal testing track in 3–4 weeks so Kevin can dogfood the native app while his portfolio uses PWA.",
    status: "in-flight",
    link: { label: "Foundation Stage 4 (mobile parity)", href: "/foundation#roadmap" },
    effort: "3–4 wk",
  },
  {
    area: "Product",
    title: "Pre-built portfolio pulse template",
    why: "Kevin shouldn't have to configure pulse settings, default channels, agent prompts, or service-provider templates from scratch. Ship a one-click \"VC portfolio\" template (channels: Intros · Playbooks · Service Providers · Asks · Wins).",
    status: "ready",
    effort: "2 days",
  },
];

const blocking = preFlight.filter((p) => p.status === "blocking");
const inFlight = preFlight.filter((p) => p.status === "in-flight");
const ready = preFlight.filter((p) => p.status === "ready");

/* ====== Three use cases (mirrors GTM §07 Phase 1A) ====== */
const useCases = [
  {
    n: "01",
    badge: "Lead with this · session 1",
    title: "Indelible Portfolio Knowledge Hub",
    icon: "users",
    pain: "Portfolio founders don't share GTM learnings, outbound playbooks, or vetted service-provider intel. Tribal knowledge stays tribal — Indelible's value-add stops at the cap-table.",
    play: "Private portfolio pulse. Default channels: Intros · Playbooks · Service Providers · Asks · Wins. Agent ingests and surfaces what's relevant to each founder's stage and stack. Brain Dump captures learnings, Relays drives async intros, Voice Agent answers \"latest playbook on cold-email in SEA right now.\"",
    magic: "60% of portfolio founders hit 5 events + 1 magic moment + 3 returns in 14 days. Magic moment = a relevant intro, playbook, or service-provider rec the agent surfaces unprompted.",
    why: "Smallest cohort (~20–40 portfolio companies), Kevin-curated trust, fastest activation read. Lowest pre-flight risk.",
  },
  {
    n: "02",
    badge: "After UC1 activates · ~6 weeks out",
    title: "AI Salon Thailand · Events",
    icon: "calendar",
    pain: "HQ-rolled-out platform is bad. Eventbrite → migrated to Luma → hit WhatsApp group max → no continuity post-event. Free intentionally (no monetization), so the pain is community-organizational.",
    play: "Spaces (Event-Spaces): QR at the door → Nova installs → AI agent pre-loaded with attendee + event + speaker context → persistent post-event Pulse. Luma stays for registration; Zunou is the community-continuity layer.",
    magic: "Attendee hits 5 interactions + 1 magic moment + 3 returns inside 14 days post-event. Magic moment = an intro the agent makes, or a question answered by another attendee's content.",
    why: "Needs Spaces flow end-to-end + a successful UC1 to point at as proof. Becomes the wedge for the broader Thailand AI community.",
  },
  {
    n: "03",
    badge: "After UC2 lands · ~3 months out",
    title: "Founder Institute Thailand · Alumni",
    icon: "graduation-cap",
    pain: "Built a portal — no interactions inside. Alumni become an email list after graduation. Thailand cohort already had an app install + auto-join group as the pattern that worked.",
    play: "Alumni Pulse with auto-join via Spaces install at the graduation event → ongoing agent-mediated re-engagement (curated learnings, fresh intros, hiring digests, service-provider rotations).",
    magic: "Alumni stay engaged 30 / 60 / 90 days post-graduation, measured by 5+ interactions per month per alum.",
    why: "Needs the events flow from UC2 + a portfolio activation success story before we propose this to FI Thailand leadership.",
  },
];

/* ====== Next-meeting agenda ====== */
const agenda = [
  { mins: "5 min", title: "Recap pain points + confirm sequencing", body: "Recap Kevin's three pain points back to him; confirm we lead with the portfolio knowledge hub (not events, not FI alumni)." },
  { mins: "10 min", title: "Live demo · UC1 portfolio pulse", body: "On Kevin's device (Android PWA). Show: Brain Dump capturing a learning · Relays sending an async intro · Voice Agent answering a real portfolio-relevant question · Daily Debrief surfacing it." },
  { mins: "5 min", title: "Show the magic-number instrumentation", body: "Walk the activation funnel we'll be reading. The number we'll send him at day 7 and day 14. Honest about what triggers the gate-up to UC2." },
  { mins: "5 min", title: "Pre-flight transparency", body: "Show the bug list we're fixing before opening his portfolio (iOS auth, web DM, notifications). Set expectation: pilot opens after the blocking items clear." },
  { mins: "5 min", title: "His next move", body: "Kevin curates the first 5 founders he'd want in the portfolio pulse. We hand-onboard each one alongside him." },
  { mins: "5 min", title: "Open questions + close", body: "Pricing for after pilot? Spaces config for Thailand AI Salon (UC2 prep)? FI Thailand intro path (UC3)? Anything we missed?" },
];

const totals = {
  preFlightTotal: preFlight.length,
  blockingCount: blocking.length,
  effortBlockerDays: 7,
};
---

<Layout
  title="Zunou — Pitch · Indelible Ventures (Kevin Brockland)"
  description="Sales prep doc for the Beachhead 0 pilot with Indelible Ventures. Three sequenced use cases, pre-flight bug fixes, next-meeting agenda."
  kind="scan"
  agenda={[
    { id: "exec-summary", label: "Executive summary", icon: "list" },
    { id: "who", label: "Who · research", icon: "building-2" },
    { id: "pains", label: "Three pain points", icon: "alert-triangle" },
    { id: "use-cases", label: "Three use cases", icon: "layers" },
    { id: "preflight", label: "Pre-flight blockers", icon: "shield-alert" },
    { id: "android", label: "Android + PWA path", icon: "smartphone" },
    { id: "next-meeting", label: "Next-meeting agenda", icon: "calendar" },
    { id: "open", label: "Open questions", icon: "circle-help" },
  ]}
>
  <!-- Top banner · sub-page nav -->
  <div class="border-b border-[var(--color-accent)]/40 bg-[var(--color-accent-soft)]/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between gap-x-4 gap-y-1 flex-wrap text-sm">
      <div class="flex items-baseline gap-x-2 gap-y-0.5 flex-wrap min-w-0">
        <span class="text-[10px] uppercase tracking-[0.16em] font-mono font-bold text-[var(--color-accent-ink)] shrink-0">Pilots / Indelible · sales prep</span>
        <span class="text-[var(--color-ink)]">Internal pitch doc — first external user. Not Kevin-facing yet.</span>
      </div>
      <div class="flex items-center gap-x-4 shrink-0 text-xs">
        <a href="/gtm#phases" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>GTM · Phase 1A</span><span aria-hidden="true">→</span></a>
        <a href="/foundation#tier-1" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Foundation Tier-1</span><span aria-hidden="true">→</span></a>
        <a href="/journeys" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Journeys</span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <section class="pt-20 sm:pt-24 pb-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-8 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Handshake class="w-3.5 h-3.5" />
          Pitch · Indelible Ventures
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">Marco Avila · v1 · prep for next meeting w/ Kevin</span>
      </div>

      <h1 class="font-display text-[2.5rem] sm:text-[3.5rem] lg:text-[4.25rem] leading-[0.98] tracking-tight mb-5 max-w-4xl" data-reveal="fade-up" data-reveal-delay="1">
        Kevin's portfolio is the wedge.<br />
        <span class="text-[var(--color-ink-soft)] italic">The product has to be ready for it.</span>
      </h1>

      <p class="text-lg sm:text-xl text-[var(--color-ink-soft)] leading-relaxed mb-10 max-w-3xl" data-reveal="fade-up" data-reveal-delay="2">
        First external user. Three concrete pain points from the meeting. Three sequenced use cases. A short pre-flight list of bugs to clear (iOS auth, web DM, notification outbox) — most are already <a href="/foundation#tier-1" class="text-[var(--color-accent-ink)] hover:underline font-semibold">Foundation Tier-1</a>. Kevin himself is on Android (PWA covers it for ~6 weeks), but his portfolio is mixed — iOS bugs block the pilot, not just his demo.
      </p>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" data-reveal="fade-up" data-reveal-delay="3">
        <div class="stat-xl featured">
          <div class="stat-xl-eyebrow">Use cases sequenced</div>
          <div class="stat-xl-figure accent">3</div>
          <div class="stat-xl-label">Portfolio hub · Events · FI alumni</div>
        </div>
        <div class="stat-xl">
          <div class="stat-xl-eyebrow">Pre-flight bug list</div>
          <div class="stat-xl-figure">{totals.preFlightTotal}</div>
          <div class="stat-xl-label">{totals.blockingCount} blocking · rest in-flight or ready</div>
        </div>
        <div class="stat-xl">
          <div class="stat-xl-eyebrow">Days to clear blockers</div>
          <div class="stat-xl-figure">~{totals.effortBlockerDays}</div>
          <div class="stat-xl-label">Two engineers in parallel</div>
        </div>
        <div class="stat-xl">
          <div class="stat-xl-eyebrow">Native Android build target</div>
          <div class="stat-xl-figure">3–4 wk</div>
          <div class="stat-xl-label">Google Play internal track · PWA covers the gap</div>
        </div>
      </div>
    </div>
  </section>

  <!-- EXECUTIVE SUMMARY -->
  <section class="pb-12" id="exec-summary">
    <div class="max-w-6xl mx-auto px-6">
      <div class="exec-summary" data-reveal="fade-up">
        <div class="exec-summary-header">
          <span class="exec-summary-eyebrow"><CircleDot class="w-3 h-3" /> Executive summary</span>
          <span class="exec-summary-meta">5 bullets · 60 seconds</span>
        </div>
        <ol class="exec-summary-list">
          <li><strong>Kevin Brockland (Indelible Ventures, KL) is our first portfolio rollout — and Zunou is already in his portfolio</strong> per <a href="https://tracxn.com/d/venture-capital/indelible-ventures/__cki8iR6PiNxMBJR447jGvTPJfIGcg5e5pGZni6Sa4fQ" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Tracxn</a>. Critical reframe: this isn't a cold sale, it's a portfolio company demoing back to its GP. The meeting surfaced three concrete pains; we sequence by activation likelihood, not by his preference — lead with the smallest, highest-trust use case.</li>
          <li><strong>Lead with the portfolio knowledge hub.</strong> Smallest cohort (~20–40 founders), Kevin-curated trust, fastest read on whether the magic-number works on a friendly cohort. Don't open events or FI alumni until UC1 hits its gate.</li>
          <li><strong>iOS bugs block this pilot, not just Kevin's demo.</strong> Kevin is Android (PWA fine for him), but his portfolio is mixed. The "sign in twice" + "iOS keeps kicking users out" bugs from the audit will burn ~30–50% of his portfolio before they ever activate. Foundation Tier-1 has these — they're now hard pre-flight blockers for this pilot.</li>
          <li><strong>Native Android in 3–4 weeks.</strong> PWA on Android Chrome covers Kevin himself for the first 6 weeks of the pilot. Native build (Capacitor or Expo) ships to Google Play internal testing in ~3–4 weeks so he can dogfood while the rest of the portfolio runs PWA.</li>
          <li><strong>The next meeting is a 35-minute structured agenda.</strong> Recap pains → live demo on his Android → show the magic-number instrumentation → pre-flight transparency → his next move (he curates the first 5 founders) → open questions. Outline below in §07.</li>
        </ol>
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- §01 WHO -->
  <section class="py-16 sm:py-20" id="who">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-5" data-reveal="fade-up">
        <span class="section-number"><span>01</span></span>
        <span class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">Who · the research</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl mb-5 max-w-3xl leading-tight" data-reveal="fade-up" data-reveal-delay="1">
        Kevin Brockland · <a href="https://indelible.vc" target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink)] hover:text-[var(--color-accent-ink)] underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)] underline-offset-2">Indelible Ventures</a>.
      </h2>
      <p class="text-lg leading-relaxed text-[var(--color-ink-soft)] max-w-3xl mb-4" data-reveal="fade-up" data-reveal-delay="2">
        CFA, ex-impact-fund portfolio manager (<a href="https://www.bravesea.com/blog/kevin-brockland" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">SEAF ~$400M AUM, MDIF</a> covering India / SEA / LatAm). Relocated to Malaysia, founded Indelible Ventures in 2021. <a href="https://fi.co/insight/q-a-with-vc-lab-alumni-kevin-brockland-of-indelible-ventures" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">VC Lab alumnus</a> · <a href="https://www.endeavormalaysia.org/people/kevin-brockland" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">Endeavor Malaysia mentor</a> · organizes <a href="https://luma.com/aisalon" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">AI Salon Bangkok</a> on Luma.
      </p>

      <div class="rounded-xl border-2 border-[var(--color-accent)] bg-[var(--color-paper)] p-5 mb-8 max-w-3xl" data-reveal="fade-up" data-reveal-delay="3">
        <div class="flex items-center gap-2 mb-2">
          <Sparkles class="w-3.5 h-3.5 text-[var(--color-accent)]" />
          <span class="text-[10px] uppercase tracking-[0.18em] font-bold text-[var(--color-accent-ink)]">Critical reframe</span>
        </div>
        <p class="text-base text-[var(--color-ink)] leading-relaxed">
          <strong>Zunou is already in Indelible's portfolio.</strong> This isn't a cold sale — Kevin is one of our investors. The pitch is "the portfolio knowledge hub you wished existed, that we just built and now want to roll out across your portfolio first." Earned trust, much warmer dynamic. <span class="text-[var(--color-ink-faint)] text-sm italic">(Source: <a href="https://tracxn.com/d/venture-capital/indelible-ventures/__cki8iR6PiNxMBJR447jGvTPJfIGcg5e5pGZni6Sa4fQ" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">Tracxn portfolio listing</a>.)</span>
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-3 max-w-5xl">
        <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-5" data-reveal="fade-up">
          <div class="flex items-center gap-2 mb-3">
            <Building2 class="w-4 h-4 text-[var(--color-accent)]" />
            <span class="text-[10px] uppercase tracking-[0.18em] font-bold text-[var(--color-accent-ink)]">Indelible Ventures · 2021 · KL</span>
          </div>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-2">
            Pre-seed / seed. First check $100K–$250K, average round $580K. ~10 portfolio companies as of early 2025. Thesis: B2B SaaS · fintech infra · AI-enabled tools · productivity · HR — for SEA's overlooked corners.
          </p>
          <p class="text-xs text-[var(--color-ink-faint)] mb-2">
            <strong class="text-[var(--color-ink-soft)]">Sister portfolio (UC1 lookalikes):</strong> BetterClinic (ambient AI scribe) · Kimaru AI (supply chain) · Quotable AI (SME supply) · RunCloud · Vase AI · <strong class="text-[var(--color-accent-ink)]">Zunou AI</strong>.
          </p>
          <a href="https://indelible.vc" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-accent-ink)] hover:underline font-mono">indelible.vc →</a>
        </div>

        <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-5" data-reveal="fade-up" data-reveal-delay="1">
          <div class="flex items-center gap-2 mb-3">
            <Mic class="w-4 h-4 text-[var(--color-accent)]" />
            <span class="text-[10px] uppercase tracking-[0.18em] font-bold text-[var(--color-accent-ink)]">AI Salon Bangkok · monthly</span>
          </div>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-2">
            Kevin organizes the SEA chapter of the global <a href="https://luma.com/aisalon" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">AI Salon</a> network. Monthly invite-RSVP events on Luma. Audience: early-stage AI founders + investors. Recent confirmed editions: <a href="https://lu.ma/AI-Salon-Bangkok-May-2025" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">May 2025</a> · <a href="https://luma.com/AI-Salon-Bangkok-September-2025" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">Sep 2025</a>.
          </p>
          <p class="text-xs text-[var(--color-ink-faint)] italic">
            HQ-rolled-out platform is bad → migrated Eventbrite → Luma → WhatsApp group hit max. UC2 lives here.
          </p>
        </div>

        <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-5" data-reveal="fade-up" data-reveal-delay="2">
          <div class="flex items-center gap-2 mb-3">
            <GraduationCap class="w-4 h-4 text-[var(--color-accent)]" />
            <span class="text-[10px] uppercase tracking-[0.18em] font-bold text-[var(--color-accent-ink)]">Founder Institute · mentor</span>
          </div>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-2">
            Kevin is a FI-affiliated mentor (VC Lab alumnus). The <a href="https://fi.co/insight/founder-institute-officially-launches-in-bangkok-its-sixth-city-in-southeast-asia" target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-accent)]/40 hover:decoration-[var(--color-accent)]">FI Bangkok chapter</a> was launched by Krating Poonpol (Disrupt) + Benjamin Ranck (Jetabroad) — Kevin is not the chapter director. He routes us to FI Thailand once UC2 lands.
          </p>
          <p class="text-xs text-[var(--color-ink-faint)] italic">
            Thailand cohort already used an auto-join-app pattern — exactly mirrors what Spaces does at graduation. UC3 lives here.
          </p>
        </div>
      </div>

      <div class="rounded-xl border border-dashed border-[var(--color-accent)]/40 bg-[var(--color-paper-soft)] p-5 mt-6 max-w-4xl" data-reveal="fade-up">
        <div class="flex items-center gap-2 mb-2">
          <Compass class="w-3.5 h-3.5 text-[var(--color-accent)]" />
          <span class="text-[10px] uppercase tracking-[0.18em] font-bold text-[var(--color-accent-ink)]">Why Zunou fits the Indelible thesis</span>
        </div>
        <p class="text-sm text-[var(--color-ink)] leading-relaxed">
          Indelible backs <strong>pre-seed/seed B2B SaaS and AI tools targeting SEA founders who are resource-constrained and need to punch above their weight operationally</strong> — that's the published thesis on <a href="https://indelible.vc" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent-ink)] hover:underline">indelible.vc</a>. Zunou's Pulses + Spaces + Agent stack is directly additive for sister portfolio companies: BetterClinic (small clinical teams), Quotable / Kimaru (distributed supply-chain ops), Vase AI (async research workflows). Each one needs lightweight async collaboration without enterprise pricing — the agent layer addresses the exact "enterprise software infrastructure" gap their thesis names. <strong>UC1 isn't speculative; the lookalikes are sitting in the same fund.</strong>
        </p>
      </div>
