  <!-- §03 USE CASES -->
  <section class="py-16 sm:py-20" id="use-cases">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-5" data-reveal="fade-up">
        <span class="section-number"><span>03</span></span>
        <span class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">Three use cases</span>
