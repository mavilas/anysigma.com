                </div>
                <div class="text-right text-xs font-mono text-[var(--color-ink-soft)] whitespace-nowrap flex items-center gap-1">
                  <Hourglass class="w-3 h-3" />
                  {p.effort}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
