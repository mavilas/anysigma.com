---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Decision from "../components/Decision.astro";
import Community from "../components/Community.astro";
import Term from "../components/Term.astro";
import { glossary, groupTitles, groupOrder } from "../data/glossary";

// Pre-bucket glossary entries for the rendered Glossary section
const glossaryByGroup = groupOrder.map((group) => ({
  group,
  title: groupTitles[group],
  entries: Object.entries(glossary).filter(([, e]) => e.group === group),
}));
import {
  Flag,
  CheckSquare,
  BookOpen,
  AlertTriangle,
  CircleCheck,
  CheckCircle2,
  Check,
  X,
  Send,
  MessagesSquare,
  Calendar,
  ArrowDown,
  CircleDot,
} from "@lucide/astro";

const decisions = [
  // SETTLED — already ratified; shown for context, no vote
  { n: 1, title: "Geographic focus — Japan-led for 12 months", desc: "Home market; second geography sequenced post-PMF, not preemptively.", group: "core", status: "settled" },
  { n: 2, title: "NSM = WAU past magic number, in a partner community", desc: "Knowing it grows slowly at first.", group: "core", status: "settled" },
  { n: 3, title: "Calendar as gate", desc: "Accept that users without calendar see a deliberately broken-feeling product.", group: "core", status: "settled" },
  { n: 4, title: "Stage-gate rule — ~6 months after Phase 1 launch", desc: "≥4 of 6 PMF criteria → fuel; ≤2 → pivot; 3 → extend 60 days.", group: "core", status: "settled" },
  { n: 5, title: "Retire HN / PH / IH and cold-LinkedIn", desc: "Replace with warm-intro + community + earned media.", group: "core", status: "settled" },

  // OPEN — pending team ratification
  { n: 6, title: "KGI — year-1 ARR ambition is large; lock the specific number after month-3 paid validation", desc: "Year-1 ambition: ¥30M+ ARR is plausible — but only because we don't stop at the beachhead. Beachhead = TAI + a few communities = 1–2 months of PMF learning. The real year-1 number comes from layering parallel tracks on top: more communities, Spaces-powered large events (IVS-class), content/PR, partnerships. We deliberately don't lock a specific year-1 ARR number until month-3 paid signal calibrates real willingness-to-pay × tier preference. Question to discuss: do we agree the year-1 framing is 'PMF in months 1–3, paid signal by 3–6, ARR number locks after that' — with ¥30M+ as the ambition we're working toward?", group: "core", status: "open" },
  { n: 7, title: "Magic number (v0) — 5 / 1 / 3 in 14 days", desc: "Working hypothesis. Derivation in §05. Refit monthly against real cohort data once pilot starts. Pushback now if you think the inputs are off.", group: "core", status: "open" },
  { n: 8, title: "Launch shape — pilot-first vs synchronized 4-community?", desc: "Current recommendation in §06: pilot one community deep first (TAI), learn, then double. Original §05 plan was 4-at-once synchronized. Pilot-first means slower but lower risk. Vote on which approach.", group: "core", status: "open" },
  { n: 9, title: "Sponsored-seat cap + free-trial duration", desc: "Working estimate: 50 members × ¥600 × N months × 4 communities. Candidate Ns: 3 months vs 6 months. Question to test with community owners. Bounded liability either way — not 'free forever'.", group: "core", status: "open" },
  { n: 10, title: "Public events feed — before / with / after waitlist?", desc: "Connpass + Doorkeeper APIs + Lu.ma at launch. The discovery question (§06.7): do we put this in front of unsigned-in users to drive top-of-funnel?", group: "core", status: "open" },
  { n: 11, title: "Budget approach — methodology over total", desc: "Per-user inference math + sponsored-seat caps + hybrid venue sponsorship (flat fee + per-user-join bonus, capped ¥400k/event) + ops/content/legal placeholders. §09 panel D shows ¥12.5–21M operational envelope (compensation lines out of scope here — separate conversation). Ratify the methodology + sponsorship-model shape, not the absolute total.", group: "core", status: "open" },
  { n: 12, title: "Adopt Masaru's positioning angle as the lead message", desc: "“Strategy in Notion. Tasks in Asana. Decisions in Slack. Good luck.” Effective for builders / operators; less so for enterprise.", group: "core", status: "open" },
  { n: 13, title: "Community-discovery direction (A / B / C)", desc: "A = passive emergence (default); B = lightweight in-product recs (Phase 3+ test); C = community discovery as a core surface.", group: "core", status: "open" },

  // OPEN — from §16.5 gap audit
  { n: 14, title: "Pricing v0 — what tier shape + price point?", desc: "Three patterns spec'd in §09 panel B (Notion-style / Linear-style / usage-metered). Validate with community owners + early users before locking.", group: "gap", status: "open" },
  { n: 15, title: "Support model v0 — Marco + Malek covering JP/EN business hours", desc: "In-app widget + Slack channel. First CSM hire post-day-180 if Phase 5a fuel.", group: "gap", status: "open" },
  { n: 16, title: "Attribution v0 — last-touch for cohort analysis", desc: "Revisit at day 90 once data flows.", group: "gap", status: "open" },
  { n: 17, title: "Loop 6 commitment — invest product eng in meeting-prep viral loop", desc: "Loom rode this exact loop to 25M users — every shared video is an ad.", group: "gap", status: "open" },
];

const settledDecisions = decisions.filter((d) => d.status === "settled");
const openCoreDecisions = decisions.filter((d) => d.status === "open" && d.group === "core");
const openGapDecisions = decisions.filter((d) => d.status === "open" && d.group === "gap");
const openCount = decisions.filter((d) => d.status === "open").length;
---

<Layout
  title="Zunou — Japan-Led GTM Strategy"
  agenda={[
    { id: "exec-summary", label: "Executive summary", icon: "list" },
    { id: "tldr", label: "TL;DR · long form", icon: "scroll-text" },
    { id: "posture", label: "Posture", icon: "compass" },
    { id: "trends", label: "Trends", icon: "trending-up" },
    { id: "moat", label: "MCP moat", icon: "shield" },
    { id: "competitive", label: "Competitive", icon: "swords" },
    { id: "mechanic", label: "Mechanic", icon: "settings" },
    { id: "communities", label: "Communities", icon: "users" },
    { id: "organizer-value", label: "Organizer value", icon: "handshake" },
    { id: "readiness", label: "Readiness", icon: "package-check" },
    { id: "surface-and-drivers", label: "Surface & drivers", icon: "git-graph" },
    { id: "phases", label: "Phases", icon: "git-branch" },
    { id: "case-studies", label: "Case studies", icon: "book-open" },
    { id: "commitment", label: "Commitment", icon: "ribbon" },
    { id: "signals-engine", label: "Signals engine", icon: "radio" },
    { id: "tension", label: "Risk · tension", icon: "alert-triangle" },
    { id: "stage-gate", label: "Stage gate", icon: "flag-triangle-right" },
    { id: "pre-mortem", label: "Pre-mortem", icon: "skull" },
    { id: "asks", label: "Asks", icon: "hand" },
    { id: "investment", label: "Investment", icon: "wallet" },
    { id: "decisions", label: "Decisions", icon: "circle-help" },
    { id: "gaps", label: "Gaps", icon: "minus-circle" },
    { id: "engage", label: "Engage", icon: "send" },
    { id: "glossary", label: "Glossary", icon: "book-marked" },
    { id: "references", label: "References", icon: "library" },
  ]}
>
  <!-- Top banner · three-pillar cross-page nav (consistent with Foundation + Quality) -->
  <div class="border-b border-[var(--color-accent)]/40 bg-[var(--color-accent-soft)]/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between gap-x-4 gap-y-1 flex-wrap text-sm">
      <div class="flex items-baseline gap-x-2 gap-y-0.5 flex-wrap min-w-0">
        <span class="text-[10px] uppercase tracking-[0.16em] font-mono font-bold text-[var(--color-accent-ink)] shrink-0">GTM · strategy</span>
        <span class="text-[var(--color-ink)]">Five pillars: GTM names it · Dashboard measures it · Journeys shows it · Foundation builds it · Quality verifies it.</span>
      </div>
      <div class="flex items-center gap-x-4 shrink-0 text-xs">
        <a href="/dashboard" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Dashboard</span><span aria-hidden="true">→</span></a>
        <a href="/journeys" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Journeys</span><span aria-hidden="true">→</span></a>
        <a href="/foundation" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Foundation</span><span aria-hidden="true">→</span></a>
        <a href="/quality" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Quality</span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <section class="pt-24 sm:pt-32 pb-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-10 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Flag class="w-3.5 h-3.5" />
          Internal · first proposal · for discussion
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">
          Marco Avila · 2026-05-11 · v1
        </span>
      </div>

      <!-- THE SHIFT -->
      <p
        class="text-[10px] uppercase tracking-[0.22em] text-[var(--color-accent)] font-bold mb-5"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        The shift
      </p>
      <h1
        class="font-display text-[3rem] sm:text-[4.5rem] lg:text-[5.5rem] leading-[0.98] tracking-tight mb-8 max-w-5xl"
        data-reveal="fade-up"
        data-reveal-delay="2"
      >
        Knowledge teams have stopped tolerating <span class="text-[var(--color-accent)]">tool fragmentation.</span>
      </h1>

      <div class="prose-block max-w-3xl mb-14" data-reveal="fade-up" data-reveal-delay="3">
        <p>
          For a decade we taught teams that the answer was more apps. Slack for chat. Notion for docs. Linear for tasks. Otter for meetings. A separate AI assistant bolted on top of each one. The cost was hidden in the context-switching tax — and it added up.
        </p>
        <p>
          That tolerance just snapped in late 2025. Two things broke at once. <strong class="text-[var(--color-ink)]">OpenAI's Realtime API made sub-second voice AI a deployable thing</strong> (Zunou shipped Voice Agent in 18 languages on top of it). And <strong class="text-[var(--color-ink)]">MIT showed context-window-stuffing collapses to ~0.04% accuracy on relational reasoning at scale</strong> — meaning the "bolt AI onto each silo" architecture has a hard ceiling. Zunou independently built an MIT-aligned <Term name="Tool-based selective retrieval" /> architecture (136+ production tools, ~100× token reduction) before that paper was published.
        </p>
        <p>
          <strong class="text-[var(--color-ink)]">When context lives in five places, the AI is useless. When context lives in one place — and the architecture is designed for it — the AI becomes a chief of staff.</strong> Teams that figure this out compound. Teams that don't fall behind on every cycle — every meeting, every decision, every follow-up.
        </p>
      </div>

      <!-- WINNERS & LOSERS -->
      <div
        class="grid md:grid-cols-2 gap-4 mb-16 max-w-5xl"
        data-reveal="fade-up"
        data-reveal-delay="4"
      >
        <div class="tile rounded-xl border border-[var(--color-line)] bg-[var(--color-paper-soft)] p-6">
          <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-faint)] font-bold mb-3">
            The losing path
          </div>
          <h3 class="font-semibold text-[var(--color-ink)] mb-2">Stay fragmented · bolt AI on each tool</h3>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
            Notion AI in Notion. Slack AI in Slack. Copilot in M365. Each one smart in its silo. None of them can connect the meeting decision in Slack to the action item that should live in Linear. The team still does that work manually. The AI is a feature, not a force.
          </p>
        </div>
        <div class="tile rounded-xl border-2 border-[var(--color-accent)] bg-[var(--color-paper)] p-6">
          <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent)] font-bold mb-3">
            The winning path
          </div>
          <h3 class="font-semibold text-[var(--color-ink)] mb-2">One workspace · context compounds</h3>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
            Chat, tasks, meetings, decisions — one surface. The AI sees everything. Today's meeting becomes tomorrow's prep brief automatically. The team's collective context becomes a competitive advantage. Switching to anything else means losing months of trained context.
          </p>
        </div>
      </div>

      <!-- THE PROMISED LAND -->
      <p
        class="text-[10px] uppercase tracking-[0.22em] text-[var(--color-accent)] font-bold mb-5"
        data-reveal="fade-up"
        data-reveal-delay="5"
      >
        Where we're going
      </p>
      <h2
        class="font-display text-[2.25rem] sm:text-[3.25rem] lg:text-[3.75rem] leading-[1.05] tracking-tight mb-6 max-w-4xl"
        data-reveal="fade-up"
        data-reveal-delay="6"
      >
        Tokyo's working teams stop thinking in apps.<br/>
        <span class="text-[var(--color-ink-soft)]">They think in Zunou.</span>
      </h2>

      <div class="prose-block max-w-3xl mb-14" data-reveal="fade-up" data-reveal-delay="7">
        <p>
          By the end of year 1: small Tokyo teams open Zunou in the morning the way they opened Slack five years ago. Their meeting prep happens automatically. Decisions surface where they need to be acted on. Their AI knows everyone they work with — because everyone they work with is in Zunou too.
        </p>
        <p>
          <strong class="text-[var(--color-ink)]">This isn't sold; it's experienced.</strong> When one Tokyo founder tells another "everyone I know is on Zunou" — that's the moment. From there it spreads passively.
        </p>
      </div>

      <!-- WHAT THIS PROPOSAL IS -->
      <div
        class="rounded-xl border-2 border-[var(--color-accent)]/30 bg-[var(--color-accent-soft)]/40 p-7 mb-14 max-w-4xl"
        data-reveal="fade-up"
        data-reveal-delay="7"
      >
        <p class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent-ink)] font-bold mb-3">
          What I'm proposing we discuss
        </p>
        <p class="text-base text-[var(--color-ink)] leading-relaxed mb-4">
          This is my first GTM proposal at Zunou. <strong>I'm not asking you to ratify a finished plan</strong> — I'm asking you to react to a specific shape, push back where the inputs feel wrong, and shape the next version with me. The strategy below is genuinely good, but it gets twice as good with your judgment in it.
        </p>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          Specifically I want us to align on: <strong class="text-[var(--color-ink)]">the launch shape</strong> (pilot-first vs synchronized), <strong class="text-[var(--color-ink)]">the pilot community</strong> (TAI is my recommendation, others on the attack list), <strong class="text-[var(--color-ink)]">the year-1 framing</strong> (PMF first, lock ARR after month-3 paid signal — see §09 + §09.5), and <strong class="text-[var(--color-ink)]">what we discover in pilot</strong> that should change the rest of this plan.
        </p>
      </div>

      <div
        class="flex flex-wrap items-center gap-3 mb-16"
        data-reveal="fade-up"
        data-reveal-delay="8"
      >
        <a
          href="#decisions"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-[var(--color-ink)] text-[var(--color-paper)] text-sm font-semibold hover:bg-[var(--color-accent)] transition-colors"
        >
          <CheckSquare class="w-4 h-4" />
          Vote on the open decisions
        </a>
        <a
          href="#trends"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-[var(--color-line)] text-sm font-semibold hover:border-[var(--color-ink)] transition-colors"
        >
          <BookOpen class="w-4 h-4" />
          Read the full story
          <ArrowDown class="w-3.5 h-3.5 ml-1" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Stat
          icon="users-round"
          value="6,500"
          label="Tokyo individuals we can plausibly reach"
          caveat="Across 13 prioritized communities (§06)"
          revealDelay={9}
        />
        <Stat
          icon="layers"
          value="One pilot first"
          label="TAI · 4,000+ AI builders"
          caveat="Then learn, then double, then scale"
          revealDelay={10}
        />
        <Stat
          icon="git-pull-request-arrow"
          value="~6 months"
          label="To stop-or-go decision"
          caveat="Pre-committed PMF stage-gate · §11"
          revealDelay={11}
        />
      </div>

      <p
        class="mt-6 text-xs text-[var(--color-ink-faint)] max-w-3xl"
        data-reveal="fade-up"
        data-reveal-delay="7"
      >
        Unfamiliar with <Term name="KGI" />, <Term name="NSM" />, <Term name="PMF" />, <Term name="MCP" />, <Term name="Ringi" />, <Term name="Keigo" />, or <Term name="APPI" />? Hover any underlined term for an inline definition, or jump to the <a href="#glossary" class="text-[var(--color-accent)] hover:underline">full glossary</a>.
      </p>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- EXECUTIVE SUMMARY · consistent across all three pages -->
  <section class="py-12 sm:py-14" id="exec-summary">
    <div class="max-w-6xl mx-auto px-6">
      <div class="exec-summary" data-reveal="fade-up">
        <div class="exec-summary-header">
          <span class="exec-summary-eyebrow">
            <CircleDot class="w-3 h-3" />
            Executive summary
          </span>
          <span class="exec-summary-meta">5 bullets · 60 seconds</span>
        </div>
        <ol class="exec-summary-list">
          <li>
            <strong>Japan-first, community-led GTM</strong> anchored on the TAI (Tokyo AI) pilot in late July / early August 2026 — Ilya-introduced — then layered with AI Tinkerers, Venture Café Toranomon, and a fourth community.
          </li>
          <li>
            <strong>Hybrid venue sponsorship model:</strong> flat fee + per-user-join bonus. We pay for actual conversion, not seats. Aligns sponsor incentives with our growth metrics.
          </li>
          <li>
            <strong>Spaces (Event-Spaces) as the Zoom-playbook viral surface</strong> alongside the community pilot: QR scan at the door → Nova installs → AI agent pre-loaded with the conference context. 1,000-person event = 1,000 installs that day.
          </li>
          <li>
            <strong>Pre-committed stage-gate February 2027:</strong> ≥4 of 6 PMF criteria → fuel · ≤2 → pivot · 3 → extend. Discipline over hope.
          </li>
          <li>
            <strong>This plan depends on engineering readiness.</strong> Without the <a href="/foundation" class="text-[var(--color-accent)] hover:underline font-semibold">Foundation</a> work (notification reliability, security, table-stakes UX) and the <a href="/quality" class="text-[var(--color-accent)] hover:underline font-semibold">Quality</a> contract (Definition of Done, standardized test stack), the pilot demos will surface gaps the buyers can't ignore. The three pillars are sequential, not independent.
          </li>
        </ol>
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- TL;DR · 90-second skim card for senior readers -->
  <section class="py-12 sm:py-16" id="tldr">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-baseline gap-3 mb-5 flex-wrap" data-reveal="fade-up">
        <span class="section-number">
          <span>TL;DR · 90-second read</span>
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">~25 min full read · skip to §12 for decisions only</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl mb-8 max-w-3xl leading-tight" data-reveal="fade-up" data-reveal-delay="1">
        Marco's first GTM proposal · the shape, for the team to react to and shape.
      </h2>

      <div class="grid lg:grid-cols-3 gap-4 mb-6" data-reveal="fade-up" data-reveal-delay="2">
        <!-- The shape, in one paragraph -->
        <div class="rounded-xl border-2 border-[var(--color-accent)] bg-[var(--color-paper)] p-6 lg:col-span-2">
          <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent-ink)] font-bold mb-3">
            The shape · in one paragraph
          </div>
          <p class="text-[var(--color-ink)] leading-relaxed mb-4">
            <strong class="text-[var(--color-ink)]">Pilot-first community-led launch</strong> in Tokyo. <strong class="text-[var(--color-ink)]">TAI pilot launches end July / early Aug 2026</strong> (Ilya-introduced), then layer in AI Tinkerers + Venture Café + one more. Hybrid venue sponsorship — flat fee + per-user-join bonus — that pays for actual conversion, not just seats (§06.4). Push <Term name="Spaces" /> Event-Spaces as the Zoom-playbook viral surface alongside it. <strong class="text-[var(--color-ink)]">Pre-committed stage-gate Feb 2027: ≥4 of 6 PMF criteria → fuel; ≤2 → pivot; 3 → extend.</strong>
          </p>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
            The architecture (MIT-aligned tool-based selective retrieval, 136+ tools, Voice Agent on Realtime API, autonomous Relays) means the product is already deeper than what zunou.ai shows publicly — the launch problem is distribution + density, not product readiness. <strong class="text-[var(--color-ink)]">The page below is the show-your-work version. This card is for the skim.</strong>
          </p>
        </div>
        <!-- The GTM horizon · 3 windows · PMF first, ARR last -->
        <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6">
          <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-faint)] font-bold mb-4">
            The horizon · 3 milestone windows
          </div>
          <div class="space-y-3.5">
            <div>
              <div class="text-[10px] uppercase tracking-[0.14em] text-[var(--color-accent)] font-bold">Months 1–3 · Activation</div>
              <div class="font-display text-lg text-[var(--color-ink)] leading-tight">Does the product produce dense behavior?</div>
              <div class="text-xs text-[var(--color-ink-soft)]">Magic-number completion · cohort retention · qualitative "would be very disappointed" signal.</div>
            </div>
            <div class="pt-3.5 border-t border-[var(--color-line-soft)]">
              <div class="text-[10px] uppercase tracking-[0.14em] text-[var(--color-accent)] font-bold">Months 3–6 · Paid validation</div>
              <div class="font-display text-lg text-[var(--color-ink)] leading-tight">Do people pay? At what tier?</div>
              <div class="text-xs text-[var(--color-ink-soft)]">First paying logos · Pro $19 vs Business $39 preference · willingness-to-pay · early churn.</div>
            </div>
            <div class="pt-3.5 border-t border-[var(--color-line-soft)]">
              <div class="text-[10px] uppercase tracking-[0.14em] text-[var(--color-accent)] font-bold">Months 6–12 · Compound growth</div>
              <div class="font-display text-lg text-[var(--color-ink)] leading-tight">Do parallel tracks compound?</div>
              <div class="text-xs text-[var(--color-ink-soft)]">+communities · +events · +content/PR · MoM acceleration. <strong class="text-[var(--color-ink)]">ARR number locks here</strong>, conditional on PMF + paid signal earned in 1–6.</div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--color-line)] text-xs text-[var(--color-ink-faint)] leading-relaxed italic">
            <strong class="not-italic text-[var(--color-ink-soft)]">This GTM is about PMF, not ARR.</strong> Crazy ARR comes after the signal is real — we won't fake-forecast our way there.
          </div>
        </div>
      </div>

      <!-- 4 anchor stats — the page in numbers -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8" data-reveal="fade-up" data-reveal-delay="3">
        <div class="stat-xl">
          <div class="stat-xl-eyebrow">Pilot community</div>
          <div class="stat-xl-figure">TAI</div>
          <div class="stat-xl-label">4,000+ AI builders · open membership · weekly events</div>
        </div>
