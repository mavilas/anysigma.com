---
import Layout from "../layouts/Layout.astro";
import {
  Map,
  CircleDot,
  ArrowRight,
  Flag,
  Gauge,
  Route,
  Layers,
  Target,
  Compass,
  Eye,
  ListChecks,
  BookOpen,
  Clock,
  Users,
  CheckCircle2,
  ScrollText,
  Sparkles,
  GitBranch,
} from "@lucide/astro";

const pillars = [
  {
    n: "01",
    name: "GTM",
    href: "/gtm",
    role: "The destination",
    summary: "Three beachhead waves: warm-circle pilots via VC + venture-studio partners — Kevin Brockland at Indelible Ventures (Malaysia) first, then Northface Media (or Headline). Then TAI Tokyo pilot late July / early August 2026 (Ilya-introduced). Then layered communities. Hybrid venue sponsorship + stage-gate Feb 2027 (≥4 of 6 PMF criteria → fuel · ≤2 → pivot · 3 → extend).",
    icon: "flag",
    sections: 25,
    readMin: 25,
    audience: "Founders · investors · advisors making strategic calls",
    gist: "What we're shipping into the market and why now.",
  },
  {
    n: "02",
    name: "Dashboard",
    href: "/dashboard",
    role: "The measurement layer",
    summary: "Five dashboards on PostHog Cloud US (no-PII event taxonomy) + Metabase + Grafana. The Monday-morning ritual that turns the magic number from a slogan into a contract.",
    icon: "gauge",
    sections: 5,
    readMin: 6,
    audience: "Founders + ops · what we'll watch every Monday",
    gist: "How we'll know whether the GTM is working.",
  },
  {
    n: "03",
    name: "Journeys",
    href: "/journeys",
    role: "The user lens",
    summary: "Six end-to-end customer journeys mapped against actual code. Specific bugs (incl. \"sign in twice\" + iOS keeping users out), where to fix them, and how each maps to the GTM magic number.",
    icon: "route",
    sections: 6,
    readMin: 12,
    audience: "Engineers + designers · UX-driven prioritization",
    gist: "Where users drop, why, and what each drop costs.",
  },
  {
    n: "04",
    name: "Foundation",
    href: "/foundation",
    role: "The build plan",
    summary: "Audit-driven Tier-1 pilot blockers (15 items, ROI-ranked, ~37 person-days, 3 weeks for 2 engineers). Mortality timeline ordering: UX/onboarding first, security second, reliability third.",
    icon: "layers",
    sections: 6,
    readMin: 10,
    audience: "Engineers + Marco · what to ship before the pilot",
    gist: "The engineering work that has to land before pilot #1.",
  },
  {
    n: "05",
    name: "Quality",
    href: "/quality",
    role: "The verification contract",
    summary: "Standardized test stack (Vitest · Playwright · Pest · Maestro · pytest · contract via GraphQL Codegen). Definition of Done. Why-100% thesis. The current scoreboard: D+, 21 services, 2 actually run tests in CI.",
    icon: "target",
    sections: 6,
    readMin: 8,
    audience: "Engineers + leadership · the standing contract",
    gist: "How we keep what we ship from breaking.",
  },
];

const totalSections = pillars.reduce((s, p) => s + p.sections, 0);
const totalReadMin = pillars.reduce((s, p) => s + p.readMin, 0);

const readingPaths = [
  {
    label: "5-minute skim",
    icon: "clock",
    steps: [
      { page: "Overview", href: "/", note: "← you're here" },
      { page: "GTM exec summary", href: "/gtm#exec-summary", note: "5 bullets" },
      { page: "Foundation exec summary", href: "/foundation#exec-summary", note: "5 bullets" },
    ],
    description: "Senior reviewer who needs the shape, not the detail. Five bullets per pillar, nothing else.",
  },
  {
    label: "30-minute review",
    icon: "scroll-text",
    steps: [
      { page: "Overview", href: "/", note: "" },
      { page: "GTM TL;DR", href: "/gtm#tldr", note: "long-form" },
      { page: "Journeys", href: "/journeys", note: "all 6" },
      { page: "Foundation Tier 1", href: "/foundation#tier-1", note: "the sprint" },
      { page: "Quality scoreboard + DoD", href: "/quality", note: "the contract" },
    ],
    description: "Recommended path for a first-pass team review. Skip the deep-dive sections marked § in each page; agenda navigation in the left rail.",
  },
  {
    label: "Deep dive",
    icon: "book-open",
    steps: [
      { page: "GTM in full", href: "/gtm", note: "25 sections" },
      { page: "Dashboard", href: "/dashboard", note: "metrics + setup" },
      { page: "Journeys (every step)", href: "/journeys", note: "with file:line citations" },
      { page: "Foundation (every recommendation)", href: "/foundation", note: "with where-to-fix paths" },
      { page: "Quality (Why 100% + Beyond coverage)", href: "/quality", note: "the philosophy" },
    ],
    description: "Engineering or strategy contributor preparing to act on this. Read in order; every claim has a source or a code citation.",
  },
];

const conventions = [
  { title: "Every page opens with an executive summary", body: "Five numbered bullets. Same visual treatment across all six pages. If you only read one block per page, read this one." },
  { title: "Section anchors use § notation", body: "References across docs (e.g. \"GTM §05\", \"Foundation §03\") are clickable in the agenda — left rail on desktop, top scroll on mobile/tablet." },
  { title: "Bug claims carry file:line evidence", body: "Recommendations carry where-to-fix paths. Every actionable item maps back to a specific spot in the zunou-services repo." },
  { title: "Source citations on directional claims", body: "Numbers like 'mobile users abandon pages >3s' link to the original source (Google study, AWS measurement, etc.) — short, clickable URLs." },
  { title: "Restraint, not decoration", body: "Animations honor prefers-reduced-motion. No emoji, no AI splash. The site is a working document, not a launch page." },
];

const recentChanges = [
  { date: "2026-05-15", note: "Five-pillar IA shipped. Dashboard, Journeys, Foundation pages added; Engineering renamed to Quality with no-timeline rewrite." },
  { date: "2026-05-15", note: "Source citations applied. Mobile bounce data, AWS inter-region latency, PostHog APAC absence verified against authoritative sources." },
  { date: "2026-05-15", note: "iOS \"keeps kicking users out\" + \"sign in twice\" root causes traced to specific code paths in zunou-services." },
];
---

<Layout
  title="Zunou — Overview · How to Read This Site"
  description="Six interlinked documents covering Zunou's Japan-led GTM, the user journeys, the build plan, the test contract, and the measurement layer. Start here."
  kind="scan"
  agenda={[
    { id: "exec-summary", label: "Executive summary", icon: "list" },
    { id: "pillars", label: "The six pillars", icon: "layers" },
    { id: "reading-paths", label: "Reading paths", icon: "compass" },
    { id: "conventions", label: "Conventions", icon: "list-checks" },
    { id: "changelog", label: "Recent changes", icon: "git-branch" },
  ]}
>
  <!-- Top banner · six-page nav -->
  <div class="border-b border-[var(--color-accent)]/40 bg-[var(--color-accent-soft)]/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between gap-x-4 gap-y-1 flex-wrap text-sm">
      <div class="flex items-baseline gap-x-2 gap-y-0.5 flex-wrap min-w-0">
        <span class="text-[10px] uppercase tracking-[0.16em] font-mono font-bold text-[var(--color-accent-ink)] shrink-0">Overview · the map</span>
        <span class="text-[var(--color-ink)]">Read me first. Then dive into any of the five pillars.</span>
      </div>
      <div class="flex items-center gap-x-4 shrink-0 text-xs">
        <a href="/gtm" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>GTM</span><span aria-hidden="true">→</span></a>
        <a href="/dashboard" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Dashboard</span><span aria-hidden="true">→</span></a>
        <a href="/journeys" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Journeys</span><span aria-hidden="true">→</span></a>
        <a href="/foundation" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Foundation</span><span aria-hidden="true">→</span></a>
        <a href="/quality" class="font-semibold text-[var(--color-accent-ink)] hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-1"><span>Quality</span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <!-- HERO -->
  <section class="pt-20 sm:pt-24 pb-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-8 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Map class="w-3.5 h-3.5" />
          Overview · how to read this site
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">Marco Avila · 2026-05-15 · v1</span>
      </div>

      <h1 class="font-display text-[2.5rem] sm:text-[3.5rem] lg:text-[4rem] leading-[0.98] tracking-tight mb-5 max-w-4xl" data-reveal="fade-up" data-reveal-delay="1">
        Six docs, one product story.<br />
        <span class="text-[var(--color-ink-soft)] italic">Pick where you want to start.</span>
      </h1>

      <p class="text-lg sm:text-xl text-[var(--color-ink-soft)] leading-relaxed mb-10 max-w-3xl" data-reveal="fade-up" data-reveal-delay="2">
        Zunou's working notes — the Japan-led GTM strategy and the engineering reality it depends on, written for the team to react to. Each doc stands alone, but the through-line is one product: from market posture down to test runner. This page is the map.
      </p>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" data-reveal="fade-up" data-reveal-delay="3">
        <div class="stat-xl featured">
          <div class="stat-xl-eyebrow">Pillars</div>
          <div class="stat-xl-figure accent">{pillars.length}</div>
          <div class="stat-xl-label">Sibling docs · same skeleton, different lens</div>
        </div>
        <div class="stat-xl">
          <div class="stat-xl-eyebrow">Sections total</div>
          <div class="stat-xl-figure">{totalSections}</div>
          <div class="stat-xl-label">Numbered §01–§NN per pillar · skim or deep-dive</div>
        </div>
        <div class="stat-xl">
          <div class="stat-xl-eyebrow">Full read-through</div>
          <div class="stat-xl-figure">~{totalReadMin}m</div>
          <div class="stat-xl-label">All five pillars front to back</div>
        </div>
        <div class="stat-xl">
          <div class="stat-xl-eyebrow">Skim path</div>
          <div class="stat-xl-figure">5m</div>
          <div class="stat-xl-label">Exec summaries only · one per pillar</div>
        </div>
      </div>
    </div>
  </section>

  <!-- EXECUTIVE SUMMARY -->
  <section class="pb-12" id="exec-summary">
    <div class="max-w-6xl mx-auto px-6">
      <div class="exec-summary" data-reveal="fade-up">
        <div class="exec-summary-header">
          <span class="exec-summary-eyebrow"><CircleDot class="w-3 h-3" /> Executive summary</span>
          <span class="exec-summary-meta">5 bullets · 30 seconds</span>
        </div>
        <ol class="exec-summary-list">
          <li><strong>This is six interlinked docs, not a launch page.</strong> Working notes for the team to react to, shape, and act on.</li>
          <li><strong>Five pillars in chronological order:</strong> GTM names what we're shipping · Dashboard measures whether it's working · Journeys shows where users drop · Foundation is the engineering work to ship · Quality is the verification contract that keeps it standing.</li>
          <li><strong>Every page is the same skeleton:</strong> top banner, hero, executive summary, numbered sections, dark closing. Once you've read one, you know how to read the others.</li>
          <li><strong>Three reading paths</strong> below — pick the one that fits your time. The 5-minute skim covers the exec summaries only.</li>
          <li><strong>Every claim has evidence:</strong> file:line for code, citation URLs for industry numbers, GTM ref for strategy ties. No hand-wave; press into anything that doesn't add up.</li>
        </ol>
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- §01 PILLARS -->
  <section class="py-16 sm:py-20" id="pillars">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-5" data-reveal="fade-up">
        <span class="section-number"><span>01</span></span>
        <span class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">The five pillars</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl mb-5 max-w-3xl leading-tight" data-reveal="fade-up" data-reveal-delay="1">
        Each pillar answers exactly one question.
      </h2>
      <p class="text-lg leading-relaxed text-[var(--color-ink-soft)] max-w-3xl mb-10" data-reveal="fade-up" data-reveal-delay="2">
        Hover or tap any card to open. They link laterally too — most claims in one pillar reference at least one other.
      </p>

      <div class="grid lg:grid-cols-2 gap-3">
        {pillars.map((p, i) => (
          <a href={p.href} class="pillar-card" data-reveal="fade-up" data-reveal-delay={Math.min(i, 4)}>
            <div class="pillar-head">
              <span class="pillar-num">{p.n}</span>
              <div class="pillar-icon">
                {p.icon === "flag" && <Flag class="w-4 h-4" />}
                {p.icon === "gauge" && <Gauge class="w-4 h-4" />}
                {p.icon === "route" && <Route class="w-4 h-4" />}
                {p.icon === "layers" && <Layers class="w-4 h-4" />}
                {p.icon === "target" && <Target class="w-4 h-4" />}
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="pillar-title">{p.name}</h3>
                <p class="pillar-role">{p.role}</p>
              </div>
              <span class="pillar-cta-icon">
                <ArrowRight class="w-4 h-4" />
              </span>
            </div>
            <p class="pillar-gist">{p.gist}</p>
            <p class="pillar-summary">{p.summary}</p>
            <div class="pillar-meta">
              <span class="pillar-meta-item">
                <ListChecks class="w-3 h-3" />
                <span>{p.sections} sections</span>
              </span>
              <span class="pillar-meta-item">
                <Clock class="w-3 h-3" />
                <span>~{p.readMin} min read</span>
              </span>
              <span class="pillar-meta-item">
                <Users class="w-3 h-3" />
                <span>{p.audience}</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- §02 READING PATHS -->
  <section class="py-16 sm:py-20 bg-[var(--color-paper-soft)]" id="reading-paths">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-5" data-reveal="fade-up">
        <span class="section-number"><span>02</span></span>
        <span class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">Reading paths</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl mb-5 max-w-3xl leading-tight" data-reveal="fade-up" data-reveal-delay="1">
        Three ways through. Pick the one that fits your time.
      </h2>
      <p class="text-lg leading-relaxed text-[var(--color-ink-soft)] max-w-3xl mb-10" data-reveal="fade-up" data-reveal-delay="2">
        Each path is sequential — every link opens the next stop directly at the relevant anchor.
      </p>

      <div class="grid lg:grid-cols-3 gap-3">
        {readingPaths.map((path, i) => (
          <div class="path-card" data-reveal="fade-up" data-reveal-delay={i}>
            <div class="path-head">
              {path.icon === "clock" && <Clock class="w-4 h-4 text-[var(--color-accent)]" />}
              {path.icon === "scroll-text" && <ScrollText class="w-4 h-4 text-[var(--color-accent)]" />}
              {path.icon === "book-open" && <BookOpen class="w-4 h-4 text-[var(--color-accent)]" />}
              <h3 class="path-title">{path.label}</h3>
            </div>
            <p class="path-description">{path.description}</p>
            <ol class="path-steps">
              {path.steps.map((step, idx) => (
                <li>
                  <span class="path-step-num">{String(idx + 1).padStart(2, "0")}</span>
                  <a href={step.href} class="path-step-link">{step.page}</a>
                  {step.note && <span class="path-step-note">{step.note}</span>}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- §03 CONVENTIONS -->
  <section class="py-16 sm:py-20" id="conventions">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-5" data-reveal="fade-up">
        <span class="section-number"><span>03</span></span>
        <span class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">Conventions</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl mb-5 max-w-3xl leading-tight" data-reveal="fade-up" data-reveal-delay="1">
        Five rules every page follows.
      </h2>
      <p class="text-lg leading-relaxed text-[var(--color-ink-soft)] max-w-3xl mb-10" data-reveal="fade-up" data-reveal-delay="2">
        Once you internalize these you can navigate any page on the site at a glance.
      </p>

      <div class="grid lg:grid-cols-2 gap-3 max-w-5xl">
        {conventions.map((c, i) => (
          <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-4 hover:border-[var(--color-accent)]/40 hover:-translate-y-0.5 transition-all" data-reveal="fade-up" data-reveal-delay={Math.min(i, 4)}>
            <div class="flex items-baseline gap-2 mb-2">
              <CheckCircle2 class="w-3.5 h-3.5 text-[var(--color-accent)] flex-shrink-0" />
              <h4 class="font-display text-base text-[var(--color-ink)] leading-tight">{c.title}</h4>
            </div>
            <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed pl-5">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- §04 RECENT CHANGES -->
  <section class="py-16 sm:py-20 bg-[var(--color-paper-soft)]" id="changelog">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-5" data-reveal="fade-up">
        <span class="section-number"><span>04</span></span>
        <span class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">Recent changes</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl mb-5 max-w-3xl leading-tight" data-reveal="fade-up" data-reveal-delay="1">
        What's moved this week.
      </h2>

      <div class="space-y-2 max-w-3xl mt-8">
        {recentChanges.map((c, i) => (
          <div class="grid grid-cols-[6.5rem_1fr] gap-4 items-baseline rounded-lg border border-[var(--color-line)] bg-[var(--color-paper)] p-3.5" data-reveal="fade-up" data-reveal-delay={Math.min(i, 3)}>
            <span class="font-mono text-xs text-[var(--color-accent-ink)] font-bold">{c.date}</span>
            <span class="text-sm text-[var(--color-ink)] leading-relaxed">{c.note}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="py-16 sm:py-20 bg-[var(--color-ink)] text-[var(--color-paper)]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-[10px] uppercase tracking-[0.22em] text-[var(--color-accent)] font-bold mb-3">Where to go next</p>
        <h2 class="font-display text-2xl sm:text-3xl leading-tight mb-5">
          Open the doc that answers the question you have.
        </h2>
        <p class="text-lg leading-relaxed text-[var(--color-paper-soft)] mb-5">
          If you only have time for one thing today: <strong class="text-[var(--color-paper)]">read the GTM TL;DR</strong>. If you're here to act: <strong class="text-[var(--color-paper)]">go to Foundation Tier 1</strong>. If you want to understand what users see: <strong class="text-[var(--color-paper)]">walk the Journeys</strong>.
        </p>
        <p class="text-lg leading-relaxed text-[var(--color-paper-soft)] font-display italic pt-4 border-t border-[var(--color-paper-soft)]/20">
          Six docs, one through-line: turn the magic number into a product reality.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/gtm" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[var(--color-accent)] text-[var(--color-paper)] font-semibold text-sm hover:bg-[var(--color-accent-ink)] transition-colors">
            <Flag class="w-4 h-4" />
            Open GTM
          </a>
          <a href="/journeys" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-[var(--color-paper-soft)]/30 text-[var(--color-paper)] font-semibold text-sm hover:bg-[var(--color-paper-soft)]/10 transition-colors">
            <Route class="w-4 h-4" />
            Walk the Journeys
          </a>
          <a href="/foundation" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-[var(--color-paper-soft)]/30 text-[var(--color-paper)] font-semibold text-sm hover:bg-[var(--color-paper-soft)]/10 transition-colors">
            <Layers class="w-4 h-4" />
            See the build plan
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* === Pillar cards === */
  .pillar-card {
    display: block;
    background: var(--color-paper);
    border: 1.5px solid var(--color-line);
    border-radius: 1rem;
    padding: 1.25rem 1.25rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: all 240ms cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }
  .pillar-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -22px rgba(74, 0, 224, 0.32);
  }
  .pillar-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 60%, color-mix(in srgb, var(--color-accent) 4%, transparent) 100%);
    opacity: 0;
    transition: opacity 240ms ease;
    pointer-events: none;
  }
  .pillar-card:hover::before { opacity: 1; }

  .pillar-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .pillar-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-ink-faint);
    letter-spacing: 0.08em;
  }
  .pillar-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: var(--color-accent-soft);
    color: var(--color-accent-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .pillar-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
