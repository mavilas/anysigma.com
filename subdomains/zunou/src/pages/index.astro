---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Decision from "../components/Decision.astro";
import Community from "../components/Community.astro";
import {
  Flag,
  CheckSquare,
  BookOpen,
  AlertTriangle,
  CircleCheck,
  CheckCircle2,
  Send,
  MessagesSquare,
  Calendar,
  ArrowDown,
} from "@lucide/astro";

const decisions = [
  { n: 1, title: "Geographic focus — Japan-led for 12 months", desc: "Home market; second geography sequenced post-PMF, not preemptively.", group: "core" },
  { n: 2, title: "KGI — ¥30M ARR within 12 months of synchronized launch", desc: "≥20% MoM in the second half. Open: when the 12-month clock starts, given platform readiness gates Phase 1.", group: "core" },
  { n: 3, title: "NSM — WAU past magic number, in a partner community", desc: "Knowing it grows slowly at first.", group: "core" },
  { n: 4, title: "Magic number (v0) — 5 / 1 / 3 in 14 days", desc: "5 colleagues from same community + 1 calendar + 3 AI actions accepted, in 14 days. Refit monthly.", group: "core" },
  { n: 5, title: "Synchronized 4-community launch", desc: "Yes, or phase 2+2?", group: "core" },
  { n: 6, title: "Sponsored-seat cap — ¥720k worst case", desc: "50 members × ¥600 × 6 months × 4 communities. Bounded liability vs blanket 'free for a year'.", group: "core" },
  { n: 7, title: "Public events feed — before / with / after waitlist?", desc: "Connpass + Doorkeeper APIs + Lu.ma at launch.", group: "core" },
  { n: 8, title: "Calendar as gate", desc: "Accept that users without calendar see a deliberately broken-feeling product.", group: "core" },
  { n: 9, title: "Budget approach — methodology over total", desc: "Per-user inference math + sponsored-seat caps + line-item placeholders. Total ~¥18–24M is a working estimate, not a commitment.", group: "core" },
  { n: 10, title: "Stage-gate rule — ~6 months after Phase 1 launch", desc: "≥4 of 6 PMF criteria → fuel; ≤2 → pivot; 3 → extend 60 days.", group: "core" },
  { n: 11, title: "Adopt Masaru's positioning angle as the lead message", desc: "“Strategy in Notion. Tasks in Asana. Decisions in Slack. Good luck.”", group: "core" },
  { n: 12, title: "Retire HN / PH / IH and cold-LinkedIn", desc: "Replace with warm-intro + community + earned media.", group: "core" },
  { n: 13, title: "Community-discovery direction (A / B / C)", desc: "A = passive emergence (default); B = lightweight in-product recs (Phase 3+ test); C = community discovery as core surface.", group: "core" },
  { n: 14, title: "Pricing v0 — adopt tier shape + self-serve upgrade flow", desc: "From §16.5 gap audit (S1). Free + ≥¥3,500/mo paid. Refined via validation calls.", group: "gap" },
  { n: 15, title: "Support model v0 — Marco + Malek covering JP/EN business hours", desc: "From §16.5 (S2). In-app widget + Slack channel. First CSM hire post-day-180 if Phase 5a fuel.", group: "gap" },
  { n: 16, title: "Attribution v0 — last-touch for cohort analysis", desc: "From §16.5 (M2). Revisit at day 90 once data flows.", group: "gap" },
  { n: 17, title: "Loop 6 commitment — invest product eng in meeting-prep viral loop", desc: "From §4.6 Loop 6. Loom rode this exact loop to 25M users — every shared video is an ad.", group: "gap" },
];

const coreDecisions = decisions.filter((d) => d.group === "core");
const gapDecisions = decisions.filter((d) => d.group === "gap");
---

<Layout title="Zunou — Japan-Led GTM Strategy">
  <!-- HERO -->
  <section class="pt-24 sm:pt-32 pb-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-10 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Flag class="w-3.5 h-3.5" />
          Internal — for review
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">
          Marco Avila · 2026-05-11 · v1
        </span>
      </div>

      <h1
        class="font-display text-[3.25rem] sm:text-[5rem] lg:text-[6.5rem] leading-[0.95] tracking-tight mb-10 max-w-5xl"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        Zunou works inside.<br />
        <span class="text-[var(--color-ink-soft)]">
          Now we make it work outside.
        </span>
      </h1>

      <div class="prose-block max-w-3xl mb-12" data-reveal="fade-up" data-reveal-delay="2">
        <p>
          The product is alive because the <em>density</em> is there — every meeting on the same calendar, every chat in the same workspace, every decision routed back to the right person. The AI is useful because it has context. Take the context away and the AI is a chat box.
        </p>
        <p>
          The 12-month question, then, is not <em>"how do we sell an AI Chief of Staff"</em> — it is <strong>"how do we manufacture that density inside small, defined groups in our home market, fast enough to matter, before the global incumbents close the window?"</strong>
        </p>
      </div>

      <div
        class="flex flex-wrap items-center gap-3 mb-16"
        data-reveal="fade-up"
        data-reveal-delay="3"
      >
        <a
          href="#decisions"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-[var(--color-ink)] text-[var(--color-paper)] text-sm font-semibold hover:bg-[var(--color-accent)] transition-colors"
        >
          <CheckSquare class="w-4 h-4" />
          Jump to the 17 decisions
        </a>
        <a
          href="#trends"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-[var(--color-line)] text-sm font-semibold hover:border-[var(--color-ink)] transition-colors"
        >
          <BookOpen class="w-4 h-4" />
          Read the story
          <ArrowDown class="w-3.5 h-3.5 ml-1" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Stat
          icon="target"
          value="¥30M ARR"
          label="Aspirational KGI"
          caveat="Within 12 mo of synchronized launch"
          revealDelay={4}
        />
        <Stat
          icon="users-round"
          value="4 + 4,000"
          label="Communities × TAI alone"
          caveat="Synchronized launch — sympathetic detonation"
          revealDelay={5}
        />
        <Stat
          icon="git-pull-request-arrow"
          value="~6 months"
          label="To stop-or-go decision"
          caveat="Pre-committed PMF stage-gate"
          revealDelay={6}
        />
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- 01 · POSTURE -->
  <Section
    id="posture"
    number="01"
    eyebrow="What this is"
    title="A proposal, not a verdict."
    lede="Every number here is a hypothesis. Every choice a defensible best-guess. If you finish reading and have no objections, we haven't written it well enough."
    tone="soft"
  >
    <div class="grid sm:grid-cols-2 gap-8 max-w-4xl">
      <div data-reveal="fade-up">
        <div class="flex items-center gap-2 mb-4">
          <CircleCheck class="w-5 h-5 text-[var(--color-success)]" />
          <h3 class="font-semibold">What this <em class="font-display">is</em></h3>
        </div>
        <ul class="space-y-2.5 text-[var(--color-ink-soft)] leading-relaxed">
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A proposal grounded in evidence, with citations.</span></li>
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A framework with a stop-or-go decision built in.</span></li>
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A contract for what we instrument from week one.</span></li>
        </ul>
      </div>
      <div data-reveal="fade-up" data-reveal-delay="1">
        <div class="flex items-center gap-2 mb-4">
          <AlertTriangle class="w-5 h-5 text-[var(--color-ink-soft)]" />
          <h3 class="font-semibold">What this <em class="font-display">isn't</em></h3>
        </div>
        <ul class="space-y-2.5 text-[var(--color-ink-soft)] leading-relaxed">
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A final answer — strategy is a living document.</span></li>
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A request for consensus — explicit objections preferred.</span></li>
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A sales pitch — this is internal alignment.</span></li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- 02 · TRENDS -->
  <Section
    id="trends"
    number="02"
    eyebrow="Three things changed"
    title="The window is open right now. It won't be in 12 months."
    lede="A category leader exited. Japan's adoption tipped past 30%. Every productivity app is racing to embed agents."
  >
    <div class="grid md:grid-cols-3 gap-4 mb-12">
      <Stat
        icon="skull"
        value="Xembly"
        label="US category leader exited"
        caveat="June 2024 — $20M raised, customers Salesforce / Twilio"
      />
      <Stat
        icon="trending-up"
        value="34.6%"
        label="JP firms now use generative AI"
        caveat="March 2026, Yomiuri / Teikoku Databank survey · n = 23,349 · +14.2% considering"
        revealDelay={1}
      />
      <Stat
        icon="bot"
        value="40%"
        label="Of enterprise apps will embed AI agents by EOY 2026"
        caveat="Up from < 5% in 2025 (Gartner)"
        revealDelay={2}
      />
    </div>

    <div
      class="border-l-4 border-[var(--color-warning)] pl-6 py-4 bg-[var(--color-warning-soft)]/40 rounded-r-lg"
      data-reveal="fade-up"
    >
      <p class="text-sm sm:text-base leading-relaxed">
        <strong class="text-[var(--color-ink)]">The counter-pressure:</strong>
        Gartner reports <strong class="text-[var(--color-ink)]">88% of AI agent pilots fail to graduate to production</strong> — evaluation gaps (64%), governance (57%), reliability (51%). Most buyers have been burned. Our positioning is the response to that wound: <em class="font-display">not another agent pilot — the morning briefing your team will actually use tomorrow.</em>
      </p>
    </div>
  </Section>

  <!-- 03 · MCP MOAT -->
  <Section
    id="moat"
    number="03"
    eyebrow="The architectural moat"
    title="MCP-native. The cross-app moat is in the protocol, not in marketing copy."
    lede="Notion AI sees Notion. Slack AI sees Slack. Microsoft Copilot sees M365. Zunou sees the entire Model Context Protocol ecosystem."
    tone="warm"
  >
    <div class="grid md:grid-cols-3 gap-4 mb-12">
      <Stat
        icon="plug"
        value="10,000+"
        label="Public MCP servers (Mar 2026)"
        caveat="Slack · Notion · Linear · Salesforce · GitHub · Google Workspace · M365 · Stripe · Sentry · Vercel · Supabase · Figma"
      />
      <Stat
        icon="trending-up"
        value="4,750%"
        label="MCP SDK download growth in 16 months"
        caveat="2M / month at launch (Nov 2024) → 97M / month (Mar 2026)"
        revealDelay={1}
      />
      <Stat
        icon="globe"
        value="92%"
        label="Of new agent frameworks ship with MCP built-in"
        caveat="LangGraph · CrewAI · AutoGen + OpenAI / Microsoft / Google all on board"
        revealDelay={2}
      />
    </div>

    <div class="prose-block mb-10" data-reveal="fade-up">
      <p>
        MCP went from <em>"Anthropic-led standard"</em> to <strong>industry-default standard</strong> between mid-2025 and early 2026. Anthropic donated the protocol to the Linux Foundation's Agentic AI Foundation in December 2025 — co-founded by Anthropic, Block, and OpenAI. Building bespoke OAuth clients per integration in 2026 is like building bespoke auth in 2018.
      </p>
      <p>
        We adopt the protocol as a <strong>host</strong> and inherit the entire server ecosystem. Engineering effort to support our top 25 integrations collapses from <strong>~25 OAuth implementations to 1 MCP host + 25 documentation pages</strong>.
      </p>
    </div>

    <div class="border-l-2 border-[var(--color-accent)] pl-6 max-w-2xl" data-reveal="fade-up" data-reveal-delay="1">
      <p class="pull-quote">
        Notion will not expose Slack via MCP. Slack will not expose Notion via MCP. <span class="not-italic font-semibold">We aggregate them.</span>
      </p>
    </div>
  </Section>

  <!-- 04 · MECHANIC -->
  <Section
    id="mechanic"
    number="04"
    eyebrow="The mechanic"
    title="Density manufactures product-market fit."
    lede="Not features. Not virality. Density — the threshold past which a small group's behavior changes."
  >
    <div class="prose-block mb-12" data-reveal="fade-up">
      <p>
        Slack only becomes Slack at ~2,000 team messages — past that, retention jumps to 93%. Facebook only became Facebook when users hit 7 friends in 10 days. Below that threshold, users churn. Above it, they stay for life.
      </p>
      <p>
        Zunou's working hypothesis — refit monthly against real cohort data:
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 mb-14">
      <Stat icon="users-round" value="5" label="Colleagues from the same community, active" />
      <Stat icon="calendar-check" value="1" label="Connected calendar" revealDelay={1} />
      <Stat icon="sparkles" value="3" label="AI actions accepted within 14 days" revealDelay={2} />
    </div>

    <div class="prose-block mb-10" data-reveal="fade-up">
      <p>
        The launch mechanic that produces this density is the part of the strategy that sounds unusual. Instead of launching one Tokyo community at a time (the Eventbrite playbook — city-by-city, the "campus model"), we light <strong>four overlapping communities in the same week</strong>, picked specifically because their members already see each other.
      </p>
      <p>
        The physics term for this is <strong>sympathetic detonation</strong> — adjacent explosive charges igniting each other through shockwave coupling. The growth-theory term is <strong>percolation threshold</strong> — the moment a sparse graph flips from disconnected clusters into one giant connected component.
      </p>
      <p>
        In plain terms: an attendee at AI Tinkerers Ginza on Tuesday sees three people at Venture Café Toranomon on Thursday. By the end of the launch week, "everyone I know is on Zunou" becomes literally true inside the Tokyo English-speaking founder graph.
      </p>
    </div>

    <div class="border-l-2 border-[var(--color-accent)] pl-6 max-w-2xl" data-reveal="fade-up" data-reveal-delay="1">
      <p class="pull-quote">
        One launch leaks. Four overlapping launches chain-react.
      </p>
    </div>
  </Section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- 05 · COMMUNITIES -->
  <Section
    id="communities"
    number="05"
    eyebrow="The four"
    title="Tokyo. Same week. Synchronized."
    lede="Not picked for prestige. Picked because their members already overlap — verified by roster sampling before launch."
  >
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      <Community
        name="TAI (Tokyo AI)"
        members="4,000+ members"
        channel="Monthly meetup · Connpass · Slack"
        rationale="Largest technical AI community in Japan. Engineers, researchers, investors, PMs. Cross-cuts every other community in our launch graph."
        url="https://www.tokyoai.jp/"
        icon="layers"
      />
      <Community
        name="AI Tinkerers Ginza"
        members="~200 selective"
        channel="Monthly demo nights"
        rationale="Highest-signal builders — the people who write the tools other engineers adopt. If they pick up Zunou, it spreads from there."
        url="https://tokyo.aitinkerers.org/"
        icon="wrench"
        revealDelay={1}
      />
      <Community
        name="Tokyo Founders Group"
        members="~150 operators"
        channel="Private list"
        rationale="Operator-founders — exactly Beachhead A ICP. Bilingual, English-first leadership at Tokyo scale-ups."
        icon="rocket"
        revealDelay={2}
      />
      <Community
        name="Venture Café Toranomon"
        members="Weekly rotating"
        channel="Thursday physical gathering"
        rationale="Highest-frequency repeated touchpoint in Tokyo. Same place every Thursday — compounding density through repetition."
        url="https://venturecafetokyo.org/"
        icon="coffee"
        revealDelay={3}
      />
    </div>
  </Section>

  <!-- 06 · CASE STUDIES -->
  <Section
    id="case-studies"
    number="06"
    eyebrow="Prior art"
    title="The pattern repeats. We're not improvising."
    lede="Four billion-dollar outcomes. Each manufactured density inside overlapping groups before going broad."
    tone="soft"
  >
    <div class="grid md:grid-cols-2 gap-4">
      <CaseStudy
        company="Notion"
        year="2018–19"
        play="Simultaneously seeded YC + 500 Startups + Techstars portfolios + designer Twitter."
        result="Over half of YC's recent batch became customers. 95% organic traffic."
        source={{ label: "First Round Review", url: "https://review.firstround.com/how-notion-does-marketing-a-deep-dive-into-its-community-influencers-growth-playbooks/" }}
        icon="layout"
      />
      <CaseStudy
        company="Discord"
        year="2015–16"
        play="Won gaming guild leaders ('supernodes') first; shipped Twitch integration as cross-community accelerant."
        result="133% MoM growth at 3M users."
        source={{ label: "Growthcurve case study", url: "https://growthcurve.co/how-discord-grew-to-hundreds-of-millions-of-users" }}
        icon="message-circle"
        revealDelay={1}
      />
      <CaseStudy
        company="Figma Community"
        year="2019–20"
        play="Public gallery of design files / templates / plugins → SEO + activation + pull-mechanism."
        result="300+ creators, 600+ public files. Became how non-users discovered Figma."
        source={{ label: "First Round on Figma's 5 phases", url: "https://review.firstround.com/the-5-phases-of-figmas-community-led-growth-from-stealth-to-enterprise/" }}
        icon="figma"
        revealDelay={2}
      />
      <CaseStudy
        company="Lenny's Newsletter"
        year="2020+"
        play="Free weekly newsletter for 9 months before charging anything; paid Slack as the dense layer."
        result="1M subscribers by 2024."
        source={{ label: "Growth In Reverse", url: "https://growthinreverse.com/lenny/" }}
        icon="mail"
        revealDelay={3}
      />
    </div>
  </Section>

  <!-- 07 · COMMITMENT -->
  <Section
    id="commitment"
    number="07"
    eyebrow="What we're committing"
    title="One number is a commitment. The rest are working hypotheses."
    lede="We're explicit about which is which. Pretending the budget envelope or per-user cost is locked-in would be dishonest at this stage."
  >
    <div class="grid md:grid-cols-3 gap-4 mb-10">
      <Stat
        icon="target"
        value="¥30M ARR"
        label="Aspirational KGI"
        caveat="Within 12 months of synchronized launch · ≥20% MoM in second half"
      />
      <Stat
        icon="circle-dollar-sign"
        value="¥600 / user / mo"
        label="Working free-tier inference cap"
        caveat="Hypothesis to test against real consumption. Will refit at month 1."
        revealDelay={1}
      />
      <Stat
        icon="receipt-text"
        value="¥18–24M"
        label="Working budget envelope (TBD)"
        caveat="Refine after Phase 0 produces real usage data."
        revealDelay={2}
      />
    </div>

    <div class="prose-block max-w-3xl" data-reveal="fade-up">
      <p class="text-[var(--color-ink-soft)] italic">
        Real envelope = (observed per-user inference × user count) + (community partnerships we choose to fund) + (line items we ratify). Don't make hasty assumptions.
      </p>
    </div>
  </Section>

  <!-- 08 · TENSION -->
  <Section
    id="tension"
    number="08"
    eyebrow="What could break this"
    title="88% of AI agent pilots fail to graduate to production."
    lede="That's the Gartner finding for 2026. Most enterprise buyers have been burned, or seen peers burned. Our discipline is the response."
    tone="ink"
  >
    <div class="space-y-5 max-w-3xl" data-reveal="fade-up">
      <div class="flex gap-4 items-start">
        <CircleCheck class="w-6 h-6 mt-0.5 shrink-0 text-[var(--color-accent)]" />
        <p class="text-[var(--color-paper-soft)] leading-relaxed">
          <strong class="text-[var(--color-paper)]">Source citations on every AI output.</strong>
          Addresses Gartner's #1 blocker — evaluation gaps (64% of failed pilots). Every action Zunou takes is anchored to the meeting / message / document it came from.
        </p>
      </div>
      <div class="flex gap-4 items-start" data-reveal-delay="1">
        <CircleCheck class="w-6 h-6 mt-0.5 shrink-0 text-[var(--color-accent)]" />
        <p class="text-[var(--color-paper-soft)] leading-relaxed">
          <strong class="text-[var(--color-paper)]">Human-in-the-loop on every external action.</strong>
          Addresses governance friction (57% of failed pilots). AI drafts; humans send. We never auto-act on someone's behalf.
        </p>
      </div>
      <div class="flex gap-4 items-start" data-reveal-delay="2">
        <CircleCheck class="w-6 h-6 mt-0.5 shrink-0 text-[var(--color-accent)]" />
        <p class="text-[var(--color-paper-soft)] leading-relaxed">
          <strong class="text-[var(--color-paper)]">Refuse to ship anything below 65% acceptance in beta.</strong>
          Addresses model reliability (51% of failed pilots). The metric is gated — if a feature can't beat the bar, it doesn't reach launch.
        </p>
      </div>
    </div>
  </Section>

  <!-- 09 · STAGE-GATE -->
  <Section
    id="stage-gate"
    number="09"
    eyebrow="The moment we'll know"
    title="A pre-committed stop-or-go decision in ~6 months."
    lede="No 18-month death march. Six PMF criteria; three possible outcomes; one explicit rule we agree to in advance."
  >
    <div class="grid md:grid-cols-3 gap-4 mb-10">
      <div
        class="tile border-2 border-[var(--color-success)]/30 rounded-xl p-7 bg-[var(--color-success-soft)]/30"
        data-reveal="fade-up"
      >
        <div class="font-display text-4xl mb-2 text-[var(--color-success)] tracking-tight">
          ≥ 4 of 6
        </div>
        <div class="font-semibold mb-3">Fuel</div>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          Open communities #5–10. Raise sponsored-seat caps. Push toward the KGI.
        </p>
      </div>
      <div
        class="tile border-2 border-[var(--color-warning)]/30 rounded-xl p-7 bg-[var(--color-warning-soft)]/30"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        <div class="font-display text-4xl mb-2 text-[var(--color-warning)] tracking-tight">
          3 of 6
        </div>
        <div class="font-semibold mb-3">Extend 60 days</div>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          Then re-decide. Don't force it; don't kill it prematurely either.
        </p>
      </div>
      <div
        class="tile border-2 border-[var(--color-danger)]/30 rounded-xl p-7 bg-[var(--color-danger-soft)]/30"
        data-reveal="fade-up"
        data-reveal-delay="2"
      >
        <div class="font-display text-4xl mb-2 text-[var(--color-danger)] tracking-tight">
          ≤ 2 of 6
        </div>
        <div class="font-semibold mb-3">Pivot</div>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          Most likely candidates: Ringi-first vertical, or events-only product.
        </p>
      </div>
    </div>

    <div class="prose-block max-w-3xl" data-reveal="fade-up">
      <p>
        <strong>The six criteria:</strong>
        NSM ≥ 200 weekly active users past the magic number · One launch community at 25%+ density · 35%+ activation in 14 days · ≥ 3 paid logos · Inference cost ≤ ¥600 / AU / mo · Member-of-N ≥ 15%.
      </p>
    </div>
  </Section>

  <!-- 10 · DECISIONS -->
  <Section
    id="decisions"
    number="10"
    eyebrow="The ask"
    title="Seventeen decisions. Default = ship."
    lede="We don't need consensus — we need explicit objections so we can address them or proceed with the disagreement noted. React on each."
    tone="soft"
  >
    <div class="grid lg:grid-cols-2 gap-x-10 gap-y-6 max-w-6xl">
      <div data-reveal="fade-up">
        <div class="flex items-center gap-2 mb-3 text-xs uppercase tracking-[0.18em] text-[var(--color-ink-faint)] font-semibold">
          <span>Strategy & launch · 1–13</span>
        </div>
        <div class="border border-[var(--color-line)] rounded-xl bg-[var(--color-paper)] p-3 sm:p-5">
          {coreDecisions.map((d) => (
            <Decision number={d.n} title={d.title} description={d.desc} group="core" />
          ))}
        </div>
      </div>

      <div data-reveal="fade-up" data-reveal-delay="1">
        <div class="flex items-center gap-2 mb-3 text-xs uppercase tracking-[0.18em] text-[var(--color-accent-ink)] font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" />
          <span>Operational gaps · 14–17</span>
        </div>
        <div class="border border-[var(--color-line)] rounded-xl bg-[var(--color-paper)] p-3 sm:p-5">
          {gapDecisions.map((d) => (
            <Decision number={d.n} title={d.title} description={d.desc} group="gap" />
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- 11 · GAPS -->
  <Section
    id="gaps"
    number="11"
    eyebrow="Honest about what's missing"
    title="What we still need to build before launch."
    lede="A real plan names its gaps. Four operational gaps surfaced in the audit became Decisions 14–17 above. Here's the rest of the list."
  >
    <div class="grid md:grid-cols-2 gap-4 max-w-5xl">
      <div class="tile border border-[var(--color-line)] rounded-xl p-6 bg-[var(--color-paper)]" data-reveal="fade-up">
        <div class="flex items-center gap-2 mb-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-accent-ink)] bg-[var(--color-accent-soft)] px-2 py-0.5 rounded">
            Strategic · 5 gaps
          </span>
        </div>
        <ul class="text-sm text-[var(--color-ink-soft)] space-y-1.5 leading-relaxed">
          <li>· Pricing v0 (tier shape + self-serve upgrade)</li>
          <li>· Customer support model (who answers in JP / EN, on what channel)</li>
          <li>· Crisis / outage playbook for launch week</li>
          <li>· Hiring plan tied to day-180 stage-gate</li>
          <li>· Advisor / investor update cadence</li>
        </ul>
      </div>

      <div class="tile border border-[var(--color-line)] rounded-xl p-6 bg-[var(--color-paper)]" data-reveal="fade-up" data-reveal-delay="1">
        <div class="flex items-center gap-2 mb-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-accent-ink)] bg-[var(--color-accent-soft)] px-2 py-0.5 rounded">
            Product · 7 gaps
          </span>
        </div>
        <ul class="text-sm text-[var(--color-ink-soft)] space-y-1.5 leading-relaxed">
          <li>· Mobile / PWA experience details</li>
          <li>· Account deletion + data export (APPI)</li>
          <li>· Team admin / permissions UX</li>
          <li>· Notification preferences</li>
          <li>· Performance budget + JP CDN</li>
          <li>· Accessibility (WCAG AA)</li>
          <li>· Error recovery during meetings</li>
        </ul>
      </div>

      <div class="tile border border-[var(--color-line)] rounded-xl p-6 bg-[var(--color-paper)]" data-reveal="fade-up" data-reveal-delay="2">
        <div class="flex items-center gap-2 mb-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-accent-ink)] bg-[var(--color-accent-soft)] px-2 py-0.5 rounded">
            GTM artifacts · 8 gaps
          </span>
        </div>
        <ul class="text-sm text-[var(--color-ink-soft)] space-y-1.5 leading-relaxed">
          <li>· Onboarding email copy (cadence ready)</li>
          <li>· Founder demo script for AI Tinkerers</li>
          <li>· Community-owner pitch deck (separate from this)</li>
          <li>· Investor pitch deck</li>
          <li>· Partnership MoU template</li>
          <li>· PR Times release calendar</li>
          <li>· JP press relationships</li>
          <li>· Customer reference library (Phase 2)</li>
        </ul>
      </div>

      <div class="tile border border-[var(--color-line)] rounded-xl p-6 bg-[var(--color-paper)]" data-reveal="fade-up" data-reveal-delay="3">
        <div class="flex items-center gap-2 mb-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-accent-ink)] bg-[var(--color-accent-soft)] px-2 py-0.5 rounded">
            Measurement + risk · 8 gaps
          </span>
        </div>
        <ul class="text-sm text-[var(--color-ink-soft)] space-y-1.5 leading-relaxed">
          <li>· Cohort analysis cadence (Mon / first Friday)</li>
          <li>· Attribution model (last-touch v0)</li>
          <li>· Qualitative feedback loop post-launch</li>
          <li>· Churn / exit interview process</li>
          <li>· Single-founder dependency contingency</li>
          <li>· Competitive-event response (Notion AI launch, etc.)</li>
          <li>· Launch-community-cancellation backup</li>
          <li>· Anthropic API outage graceful degradation</li>
        </ul>
      </div>
    </div>

    <p
      class="mt-10 text-sm text-[var(--color-ink-soft)] max-w-3xl italic leading-relaxed"
      data-reveal="fade-up"
    >
      Tagged: <strong class="text-[var(--color-ink)]">MUST</strong> before Phase 1 · <strong class="text-[var(--color-ink)]">SHOULD</strong> before Phase 2 · <strong class="text-[var(--color-ink)]">DEFER</strong> to Phase 3+. The 17 decisions above resolve the highest-priority gaps. The remaining 24 need owners, dates, and tracking — Phase 0 work items.
    </p>
  </Section>

  <!-- 12 · ENGAGE -->
  <Section
    id="engage"
    number="12"
    eyebrow="How to engage"
    title="React on the 17. Push back specifically. Default = ship."
    lede="We don't need consensus — we need explicit objections so we can address them or proceed with the disagreement noted."
    tone="ink"
  >
    <div class="grid md:grid-cols-2 gap-5 max-w-4xl mb-14">
      <div
        class="rounded-xl p-7 border border-[var(--color-paper-soft)]/20 bg-[var(--color-paper)]/5"
        data-reveal="fade-up"
      >
        <CheckCircle2 class="w-6 h-6 text-[var(--color-accent)] mb-5" />
        <h3 class="font-semibold mb-3 text-[var(--color-paper)] text-lg">
          If you're on board
        </h3>
        <p class="text-sm text-[var(--color-paper-soft)] leading-relaxed">
          A single thumbs-up reply on the 17 is enough. We move forward and lock the Phase 0 owners + dates.
        </p>
      </div>

      <div
        class="rounded-xl p-7 border border-[var(--color-warning)]/40 bg-[var(--color-warning)]/5"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        <AlertTriangle class="w-6 h-6 text-[var(--color-warning)] mb-5" />
        <h3 class="font-semibold mb-3 text-[var(--color-paper)] text-lg">
          If you have a concern
        </h3>
        <p class="text-sm text-[var(--color-paper-soft)] leading-relaxed">
          Name the specific decision number + the alternative you'd ratify instead. We'll add it to the agenda for the live discussion.
        </p>
      </div>
    </div>

    <div class="border-t border-[var(--color-paper-soft)]/15 pt-12 max-w-5xl" data-reveal="fade-up" data-reveal-delay="2">
      <h3 class="font-display text-3xl mb-8 text-[var(--color-paper)]">
        Three ways to respond
      </h3>
      <div class="grid sm:grid-cols-3 gap-8">
        <div class="flex gap-4">
          <Send class="w-6 h-6 text-[var(--color-accent)] shrink-0 mt-0.5" />
          <div>
            <div class="text-base font-semibold text-[var(--color-paper)] mb-1.5">
              Reply to Marco
            </div>
            <p class="text-sm text-[var(--color-paper-soft)] leading-relaxed">
              Email or Slack DM. Decision number + ✅ / ⚠️ / ❌. One line each is fine.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <MessagesSquare class="w-6 h-6 text-[var(--color-accent)] shrink-0 mt-0.5" />
          <div>
            <div class="text-base font-semibold text-[var(--color-paper)] mb-1.5">
              Team thread
            </div>
            <p class="text-sm text-[var(--color-paper-soft)] leading-relaxed">
              Slack thread on the launch channel. Everyone sees the reactions at once — fastest path to alignment.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <Calendar class="w-6 h-6 text-[var(--color-accent)] shrink-0 mt-0.5" />
          <div>
            <div class="text-base font-semibold text-[var(--color-paper)] mb-1.5">
              Live review slot
            </div>
            <p class="text-sm text-[var(--color-paper-soft)] leading-relaxed">
              30-min decision meeting once we have written reactions. Calendar invite from Marco when scheduled.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 max-w-3xl" data-reveal="fade-up" data-reveal-delay="3">
      <p class="pull-quote text-[var(--color-paper)]">
        "If you finish reading this and have no objections, we haven't written it well enough."
      </p>
    </div>
  </Section>
</Layout>
