---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Decision from "../components/Decision.astro";
import Community from "../components/Community.astro";
import Term from "../components/Term.astro";
import { glossary, groupTitles, groupOrder } from "../data/glossary";

// Pre-bucket glossary entries for the rendered Glossary section
const glossaryByGroup = groupOrder.map((group) => ({
  group,
  title: groupTitles[group],
  entries: Object.entries(glossary).filter(([, e]) => e.group === group),
}));
import {
  Flag,
  CheckSquare,
  BookOpen,
  AlertTriangle,
  CircleCheck,
  CheckCircle2,
  Check,
  X,
  Send,
  MessagesSquare,
  Calendar,
  ArrowDown,
} from "@lucide/astro";

const decisions = [
  // SETTLED — already ratified; shown for context, no vote
  { n: 1, title: "Geographic focus — Japan-led for 12 months", desc: "Home market; second geography sequenced post-PMF, not preemptively.", group: "core", status: "settled" },
  { n: 2, title: "NSM = WAU past magic number, in a partner community", desc: "Knowing it grows slowly at first.", group: "core", status: "settled" },
  { n: 3, title: "Calendar as gate", desc: "Accept that users without calendar see a deliberately broken-feeling product.", group: "core", status: "settled" },
  { n: 4, title: "Stage-gate rule — ~6 months after Phase 1 launch", desc: "≥4 of 6 PMF criteria → fuel; ≤2 → pivot; 3 → extend 60 days.", group: "core", status: "settled" },
  { n: 5, title: "Retire HN / PH / IH and cold-LinkedIn", desc: "Replace with warm-intro + community + earned media.", group: "core", status: "settled" },

  // OPEN — pending team ratification
  { n: 6, title: "KGI — what's the year-1 ARR target?", desc: "Working estimate ~¥11.5M (math in §09 panel A). Original aspiration was ¥30M. Stretch ~¥65M. Which scenario do we ratify?", group: "core", status: "open" },
  { n: 7, title: "Magic number (v0) — 5 / 1 / 3 in 14 days", desc: "Working hypothesis. Derivation in §05. Refit monthly against real cohort data once pilot starts. Pushback now if you think the inputs are off.", group: "core", status: "open" },
  { n: 8, title: "Launch shape — pilot-first vs synchronized 4-community?", desc: "Current recommendation in §06: pilot one community deep first (TAI), learn, then double. Original §05 plan was 4-at-once synchronized. Pilot-first means slower but lower risk. Vote on which approach.", group: "core", status: "open" },
  { n: 9, title: "Sponsored-seat cap + free-trial duration", desc: "Working estimate: 50 members × ¥600 × N months × 4 communities. Candidate Ns: 3 months vs 6 months. Question to test with community owners. Bounded liability either way — not 'free forever'.", group: "core", status: "open" },
  { n: 10, title: "Public events feed — before / with / after waitlist?", desc: "Connpass + Doorkeeper APIs + Lu.ma at launch. The discovery question (§06.7): do we put this in front of unsigned-in users to drive top-of-funnel?", group: "core", status: "open" },
  { n: 11, title: "Budget approach — methodology over total", desc: "Per-user inference math + sponsored-seat caps + line-item placeholders. §09 panel D shows ¥15–25M working envelope. Ratify the methodology, not the total.", group: "core", status: "open" },
  { n: 12, title: "Adopt Masaru's positioning angle as the lead message", desc: "“Strategy in Notion. Tasks in Asana. Decisions in Slack. Good luck.” Effective for builders / operators; less so for enterprise.", group: "core", status: "open" },
  { n: 13, title: "Community-discovery direction (A / B / C)", desc: "A = passive emergence (default); B = lightweight in-product recs (Phase 3+ test); C = community discovery as a core surface.", group: "core", status: "open" },

  // OPEN — from §16.5 gap audit
  { n: 14, title: "Pricing v0 — what tier shape + price point?", desc: "Three patterns spec'd in §09 panel B (Notion-style / Linear-style / usage-metered). Validate with community owners + early users before locking.", group: "gap", status: "open" },
  { n: 15, title: "Support model v0 — Marco + Malek covering JP/EN business hours", desc: "In-app widget + Slack channel. First CSM hire post-day-180 if Phase 5a fuel.", group: "gap", status: "open" },
  { n: 16, title: "Attribution v0 — last-touch for cohort analysis", desc: "Revisit at day 90 once data flows.", group: "gap", status: "open" },
  { n: 17, title: "Loop 6 commitment — invest product eng in meeting-prep viral loop", desc: "Loom rode this exact loop to 25M users — every shared video is an ad.", group: "gap", status: "open" },
];

const settledDecisions = decisions.filter((d) => d.status === "settled");
const openCoreDecisions = decisions.filter((d) => d.status === "open" && d.group === "core");
const openGapDecisions = decisions.filter((d) => d.status === "open" && d.group === "gap");
const openCount = decisions.filter((d) => d.status === "open").length;
---

<Layout title="Zunou — Japan-Led GTM Strategy">
  <!-- HERO -->
  <section class="pt-24 sm:pt-32 pb-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-10 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Flag class="w-3.5 h-3.5" />
          Internal · first proposal · for discussion
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">
          Marco Avila · 2026-05-11 · v1
        </span>
      </div>

      <!-- THE SHIFT -->
      <p
        class="text-[10px] uppercase tracking-[0.22em] text-[var(--color-accent)] font-bold mb-5"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        The shift
      </p>
      <h1
        class="font-display text-[3rem] sm:text-[4.5rem] lg:text-[5.5rem] leading-[0.98] tracking-tight mb-8 max-w-5xl"
        data-reveal="fade-up"
        data-reveal-delay="2"
      >
        Knowledge teams have stopped tolerating <span class="text-[var(--color-accent)]">tool fragmentation.</span>
      </h1>

      <div class="prose-block max-w-3xl mb-14" data-reveal="fade-up" data-reveal-delay="3">
        <p>
          For a decade we taught teams that the answer was more apps. Slack for chat. Notion for docs. Linear for tasks. Otter for meetings. A separate AI assistant bolted on top of each one. The cost was hidden in the context-switching tax — and it added up.
        </p>
        <p>
          That tolerance just snapped. <strong class="text-[var(--color-ink)]">AI in 2026 made it obvious: when context lives in five places, the AI is useless. When context lives in one place, the AI becomes a chief of staff.</strong> Teams that figure this out compound. Teams that don't fall behind on every cycle — every meeting, every decision, every follow-up.
        </p>
      </div>

      <!-- WINNERS & LOSERS -->
      <div
        class="grid md:grid-cols-2 gap-4 mb-16 max-w-5xl"
        data-reveal="fade-up"
        data-reveal-delay="4"
      >
        <div class="tile rounded-xl border border-[var(--color-line)] bg-[var(--color-paper-soft)] p-6">
          <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-faint)] font-bold mb-3">
            The losing path
          </div>
          <h3 class="font-semibold text-[var(--color-ink)] mb-2">Stay fragmented · bolt AI on each tool</h3>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
            Notion AI in Notion. Slack AI in Slack. Copilot in M365. Each one smart in its silo. None of them can connect the meeting decision in Slack to the action item that should live in Linear. The team still does that work manually. The AI is a feature, not a force.
          </p>
        </div>
        <div class="tile rounded-xl border-2 border-[var(--color-accent)] bg-[var(--color-paper)] p-6">
          <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent)] font-bold mb-3">
            The winning path
          </div>
          <h3 class="font-semibold text-[var(--color-ink)] mb-2">One workspace · context compounds</h3>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
            Chat, tasks, meetings, decisions — one surface. The AI sees everything. Today's meeting becomes tomorrow's prep brief automatically. The team's collective context becomes a competitive advantage. Switching to anything else means losing months of trained context.
          </p>
        </div>
      </div>

      <!-- THE PROMISED LAND -->
      <p
        class="text-[10px] uppercase tracking-[0.22em] text-[var(--color-accent)] font-bold mb-5"
        data-reveal="fade-up"
        data-reveal-delay="5"
      >
        Where we're going
      </p>
      <h2
        class="font-display text-[2.25rem] sm:text-[3.25rem] lg:text-[3.75rem] leading-[1.05] tracking-tight mb-6 max-w-4xl"
        data-reveal="fade-up"
        data-reveal-delay="6"
      >
        Tokyo's working teams stop thinking in apps.<br/>
        <span class="text-[var(--color-ink-soft)]">They think in Zunou.</span>
      </h2>

      <div class="prose-block max-w-3xl mb-14" data-reveal="fade-up" data-reveal-delay="7">
        <p>
          By the end of year 1: small Tokyo teams open Zunou in the morning the way they opened Slack five years ago. Their meeting prep happens automatically. Decisions surface where they need to be acted on. Their AI knows everyone they work with — because everyone they work with is in Zunou too.
        </p>
        <p>
          <strong class="text-[var(--color-ink)]">This isn't sold; it's experienced.</strong> When one Tokyo founder tells another "everyone I know is on Zunou" — that's the moment. From there it spreads passively.
        </p>
      </div>

      <!-- WHAT THIS PROPOSAL IS -->
      <div
        class="rounded-xl border-2 border-[var(--color-accent)]/30 bg-[var(--color-accent-soft)]/40 p-7 mb-14 max-w-4xl"
        data-reveal="fade-up"
        data-reveal-delay="7"
      >
        <p class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent-ink)] font-bold mb-3">
          What I'm proposing we discuss
        </p>
        <p class="text-base text-[var(--color-ink)] leading-relaxed mb-4">
          This is my first GTM proposal at Zunou. <strong>I'm not asking you to ratify a finished plan</strong> — I'm asking you to react to a specific shape, push back where the inputs feel wrong, and shape the next version with me. The strategy below is genuinely good, but it gets twice as good with your judgment in it.
        </p>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          Specifically I want us to align on: <strong class="text-[var(--color-ink)]">the launch shape</strong> (pilot-first vs synchronized), <strong class="text-[var(--color-ink)]">the pilot community</strong> (TAI is my recommendation, others on the attack list), <strong class="text-[var(--color-ink)]">the year-1 ARR target</strong> (math is in §09 — different scenarios, different implications), and <strong class="text-[var(--color-ink)]">what we discover in pilot</strong> that should change the rest of this plan.
        </p>
      </div>

      <div
        class="flex flex-wrap items-center gap-3 mb-16"
        data-reveal="fade-up"
        data-reveal-delay="8"
      >
        <a
          href="#decisions"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-[var(--color-ink)] text-[var(--color-paper)] text-sm font-semibold hover:bg-[var(--color-accent)] transition-colors"
        >
          <CheckSquare class="w-4 h-4" />
          Vote on the open decisions
        </a>
        <a
          href="#trends"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-[var(--color-line)] text-sm font-semibold hover:border-[var(--color-ink)] transition-colors"
        >
          <BookOpen class="w-4 h-4" />
          Read the full story
          <ArrowDown class="w-3.5 h-3.5 ml-1" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Stat
          icon="users-round"
          value="6,500"
          label="Tokyo individuals we can plausibly reach"
          caveat="Across 13 prioritized communities (§06)"
          revealDelay={9}
        />
        <Stat
          icon="layers"
          value="One pilot first"
          label="TAI · 4,000+ AI builders"
          caveat="Then learn, then double, then scale"
          revealDelay={10}
        />
        <Stat
          icon="git-pull-request-arrow"
          value="~6 months"
          label="To stop-or-go decision"
          caveat="Pre-committed PMF stage-gate · §11"
          revealDelay={11}
        />
      </div>

      <p
        class="mt-6 text-xs text-[var(--color-ink-faint)] max-w-3xl"
        data-reveal="fade-up"
        data-reveal-delay="7"
      >
        Unfamiliar with <Term name="KGI" />, <Term name="NSM" />, <Term name="PMF" />, <Term name="MCP" />, <Term name="Ringi" />, <Term name="Keigo" />, or <Term name="APPI" />? Hover any underlined term for an inline definition, or jump to the <a href="#glossary" class="text-[var(--color-accent)] hover:underline">full glossary</a>.
      </p>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- BACKGROUND -->
  <section class="py-16 sm:py-20 bg-[var(--color-paper-soft)]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-6" data-reveal="fade-up">
        <span class="section-number">
          <span>00 · Background</span>
        </span>
      </div>

      <h2
        class="font-display text-3xl sm:text-4xl mb-6 max-w-3xl leading-tight"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        Zunou is an AI Chief of Staff company, based in Japan.
      </h2>

      <div class="prose-block max-w-3xl" data-reveal="fade-up" data-reveal-delay="2">
        <p>
          <strong>The opening:</strong> the AI productivity stack is fragmenting, not consolidating. Personal-tier exec assistants — <a href="https://get-alfred.ai/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">alfred_</a>, <a href="https://klaio.com/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Klaio</a>, <a href="https://tryalyna.com/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Alyna</a> — solve email + scheduling for one person, not teams. AI workspace tools — <a href="https://glean.com/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Glean</a>, <a href="https://mem.ai/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Mem</a>, <a href="https://lindy.ai/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Lindy</a> — solve search and agents for English-speaking enterprise. Meeting tools — <a href="https://otter.ai/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Otter</a>, <a href="https://fireflies.ai/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Fireflies</a>, <a href="https://granola.ai/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Granola</a> — transcribe but don't act. The category's most-funded team-focused AI Chief of Staff, <a href="https://www.geekwire.com/2024/enterprise-ai-company-xembly-abruptly-ends-service-for-users-says-its-working-on-new-chapter/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Xembly</a>, shut down in 2024. The platform incumbents — <a href="https://www.notion.com/product/ai" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Notion AI</a>, <a href="https://slack.com/features/ai" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Slack AI</a>, <a href="https://copilot.microsoft.com/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">Microsoft Copilot</a> — have each shipped AI surfaces bounded to their own walled gardens.
        </p>
        <p>
          <strong>What no one ships today:</strong> a unified workspace — chat that rivals Slack + task management + AI native — that <em class="font-display">lands via integrations</em> rather than asking teams to migrate cold, AND speaks fluent Japanese (<Term name="Keigo" />, <Term name="Ringi" />). That's the gap Zunou is positioned to close — provided we ship + distribute before any incumbent decides to unify their own stack. The window isn't a fixed countdown; it closes when an incumbent breaks out of its walled garden.
        </p>
        <p>
          <strong>The proposal you're about to read</strong> answers one question: <em class="font-display">how do we manufacture density inside small Tokyo communities, fast enough to matter, while that window is still open?</em>
        </p>
      </div>

      <!-- Zunou's two product use cases (verbatim from zunou.ai) — neither is exactly the launch target -->
      <p
        class="mt-14 text-sm text-[var(--color-ink-faint)] uppercase tracking-[0.16em] font-semibold max-w-3xl"
        data-reveal="fade-up"
        data-reveal-delay="3"
      >
        Zunou's site has two use cases · neither is exactly the launch target
      </p>

      <div
        class="mt-4 grid md:grid-cols-2 gap-4 max-w-4xl"
        data-reveal="fade-up"
        data-reveal-delay="4"
      >
        <div class="tile border border-[var(--color-line)] rounded-xl p-6 bg-[var(--color-paper)] flex flex-col">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class="text-xs uppercase tracking-[0.18em] text-[var(--color-accent)] font-semibold">
              zunou.ai use case · 1
            </span>
            <span class="text-[10px] uppercase tracking-[0.14em] px-2 py-0.5 rounded bg-[var(--color-warning-soft)] text-[var(--color-warning)] font-bold">
              Not enough alone
            </span>
          </div>
          <h3 class="font-display text-2xl mb-2">For Founders</h3>
          <p class="text-sm text-[var(--color-ink)] italic mb-3 font-display">
            "Routine tasks are now automated."
          </p>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-4 flex-1">
            Intelligent agents run in the background — route tasks, approvals, follow-ups. Approve / review only when human input is needed.
          </p>
          <div class="text-xs text-[var(--color-ink-faint)] border-t border-[var(--color-line-soft)] pt-3 leading-relaxed">
            <strong class="text-[var(--color-ink-soft)]">Founders alone don't give us critical mass.</strong> Tokyo has too few of them, and they're too spread across companies to hit the magic-number density threshold by themselves. The launch goes broader — see resolution below.
          </div>
        </div>

        <div class="tile border border-[var(--color-line)] rounded-xl p-6 bg-[var(--color-paper)] flex flex-col">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class="text-xs uppercase tracking-[0.18em] text-[var(--color-accent)] font-semibold">
              zunou.ai use case · 2
            </span>
            <span class="text-[10px] uppercase tracking-[0.14em] px-2 py-0.5 rounded bg-[var(--color-ink-soft)]/15 text-[var(--color-ink-soft)] font-bold">
              Too early
            </span>
          </div>
          <h3 class="font-display text-2xl mb-2">For Enterprises</h3>
          <p class="text-sm text-[var(--color-ink)] italic mb-3 font-display">
            "Strategic decisions are now real-time."
          </p>
          <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-4 flex-1">
            Live exec dashboard — progress, workload, and outcomes across teams, projects, priorities. No more chasing updates.
          </p>
          <div class="text-xs text-[var(--color-ink-faint)] border-t border-[var(--color-line-soft)] pt-3 leading-relaxed">
            <strong class="text-[var(--color-ink-soft)]">Out of scope until the platform is proven.</strong> Enterprises buy validated tools, not waitlist betas. They need paying logos, operational maturity, <Term name="APPI" /> compliance posture, referenceable customers. Realistic open: Phase 5a (post-stage-gate). Pre-building advisor relationships earlier is fine — selling is not.
          </div>
        </div>
      </div>

      <!-- Resolution: what the launch actually targets -->
      <div
        class="mt-6 max-w-4xl rounded-xl border-2 border-[var(--color-accent)]/30 bg-[var(--color-accent-soft)]/35 p-6"
        data-reveal="fade-up"
        data-reveal-delay="5"
      >
        <div class="flex items-baseline gap-3 mb-3 flex-wrap">
          <span class="text-xs uppercase tracking-[0.18em] text-[var(--color-accent-ink)] font-bold">
            What the launch actually targets
          </span>
        </div>
        <h3 class="font-display text-2xl mb-3 text-[var(--color-ink)]">
          Tokyo's broader builder + operator + founder community.
        </h3>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          The four launch communities cover that whole population — not just founders. <strong class="text-[var(--color-ink)]">TAI</strong> (4,000+ AI engineers / researchers / PMs — mostly builders) · <strong class="text-[var(--color-ink)]">AI Tinkerers Ginza</strong> (~200 builders shipping in production) · <strong class="text-[var(--color-ink)]">Tokyo Founders</strong> (~150 operator-founders) · <strong class="text-[var(--color-ink)]">Venture Café Toranomon</strong> (the mix, every Thursday). The magic-number mechanic applies wherever there's a small team + many meetings + decisions to track — which is true across the segment, not just at the founder layer.
        </p>
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- 01 · POSTURE -->
  <Section
    id="posture"
    number="01"
    eyebrow="What this is"
    title="A proposal, not a verdict."
    lede="Every number here is a hypothesis. Every choice a defensible best-guess. If you finish reading and have no objections, we haven't written it well enough."
    tone="soft"
  >
    <div class="grid lg:grid-cols-2 gap-5 max-w-5xl">
      <!-- IS card -->
      <div
        class="tile rounded-xl border border-[var(--color-success)]/25 bg-[var(--color-success-soft)]/30 p-7"
        data-reveal="fade-up"
      >
        <div class="flex items-center gap-2.5 mb-6">
          <CircleCheck class="w-5 h-5 text-[var(--color-success)]" />
          <h3 class="text-[11px] uppercase tracking-[0.18em] font-bold text-[var(--color-success)]">
            What this <em class="font-display normal-case tracking-normal text-sm">is</em>
          </h3>
        </div>
        <ul class="space-y-5">
          <li class="flex gap-3">
            <Check class="w-4 h-4 mt-1 shrink-0 text-[var(--color-success)]" />
            <div>
              <div class="font-semibold text-[var(--color-ink)] mb-0.5">Evidence-grounded</div>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">Every numerical claim is sourced and verifiable. The References section at the end is exhaustive.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <Check class="w-4 h-4 mt-1 shrink-0 text-[var(--color-success)]" />
            <div>
              <div class="font-semibold text-[var(--color-ink)] mb-0.5">Stop-or-go-able</div>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">A pre-committed <Term name="PMF" /> stage-gate at ~6 months. Three explicit outcomes, agreed in advance.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <Check class="w-4 h-4 mt-1 shrink-0 text-[var(--color-success)]" />
            <div>
              <div class="font-semibold text-[var(--color-ink)] mb-0.5">Instrumented week one</div>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">The <Term name="KPI" /> tree is the implementation contract. If we can't measure it, we don't claim it.</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- ISN'T card -->
      <div
        class="tile rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-7"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        <div class="flex items-center gap-2.5 mb-6">
          <AlertTriangle class="w-5 h-5 text-[var(--color-ink-soft)]" />
          <h3 class="text-[11px] uppercase tracking-[0.18em] font-bold text-[var(--color-ink-soft)]">
            What this <em class="font-display normal-case tracking-normal text-sm">isn't</em>
          </h3>
        </div>
        <ul class="space-y-5">
          <li class="flex gap-3">
