---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Decision from "../components/Decision.astro";
import Community from "../components/Community.astro";
import Term from "../components/Term.astro";
import { glossary, groupTitles, groupOrder } from "../data/glossary";

// Pre-bucket glossary entries for the rendered Glossary section
const glossaryByGroup = groupOrder.map((group) => ({
  group,
  title: groupTitles[group],
  entries: Object.entries(glossary).filter(([, e]) => e.group === group),
}));
import {
  Flag,
  CheckSquare,
  BookOpen,
  AlertTriangle,
  CircleCheck,
  CheckCircle2,
  Send,
  MessagesSquare,
  Calendar,
  ArrowDown,
} from "@lucide/astro";

const decisions = [
  { n: 1, title: "Geographic focus — Japan-led for 12 months", desc: "Home market; second geography sequenced post-PMF, not preemptively.", group: "core" },
  { n: 2, title: "KGI — ¥30M ARR within 12 months of synchronized launch", desc: "≥20% MoM in the second half. Open: when the 12-month clock starts, given platform readiness gates Phase 1.", group: "core" },
  { n: 3, title: "NSM — WAU past magic number, in a partner community", desc: "Knowing it grows slowly at first.", group: "core" },
  { n: 4, title: "Magic number (v0) — 5 / 1 / 3 in 14 days", desc: "5 colleagues from same community + 1 calendar + 3 AI actions accepted, in 14 days. Refit monthly.", group: "core" },
  { n: 5, title: "Synchronized 4-community launch", desc: "Yes, or phase 2+2?", group: "core" },
  { n: 6, title: "Sponsored-seat cap — ¥720k worst case", desc: "50 members × ¥600 × 6 months × 4 communities. Bounded liability vs blanket 'free for a year'.", group: "core" },
  { n: 7, title: "Public events feed — before / with / after waitlist?", desc: "Connpass + Doorkeeper APIs + Lu.ma at launch.", group: "core" },
  { n: 8, title: "Calendar as gate", desc: "Accept that users without calendar see a deliberately broken-feeling product.", group: "core" },
  { n: 9, title: "Budget approach — methodology over total", desc: "Per-user inference math + sponsored-seat caps + line-item placeholders. Total ~¥18–24M is a working estimate, not a commitment.", group: "core" },
  { n: 10, title: "Stage-gate rule — ~6 months after Phase 1 launch", desc: "≥4 of 6 PMF criteria → fuel; ≤2 → pivot; 3 → extend 60 days.", group: "core" },
  { n: 11, title: "Adopt Masaru's positioning angle as the lead message", desc: "“Strategy in Notion. Tasks in Asana. Decisions in Slack. Good luck.”", group: "core" },
  { n: 12, title: "Retire HN / PH / IH and cold-LinkedIn", desc: "Replace with warm-intro + community + earned media.", group: "core" },
  { n: 13, title: "Community-discovery direction (A / B / C)", desc: "A = passive emergence (default); B = lightweight in-product recs (Phase 3+ test); C = community discovery as core surface.", group: "core" },
  { n: 14, title: "Pricing v0 — adopt tier shape + self-serve upgrade flow", desc: "From §16.5 gap audit (S1). Free + ≥¥3,500/mo paid. Refined via validation calls.", group: "gap" },
  { n: 15, title: "Support model v0 — Marco + Malek covering JP/EN business hours", desc: "From §16.5 (S2). In-app widget + Slack channel. First CSM hire post-day-180 if Phase 5a fuel.", group: "gap" },
  { n: 16, title: "Attribution v0 — last-touch for cohort analysis", desc: "From §16.5 (M2). Revisit at day 90 once data flows.", group: "gap" },
  { n: 17, title: "Loop 6 commitment — invest product eng in meeting-prep viral loop", desc: "From §4.6 Loop 6. Loom rode this exact loop to 25M users — every shared video is an ad.", group: "gap" },
];

const coreDecisions = decisions.filter((d) => d.group === "core");
const gapDecisions = decisions.filter((d) => d.group === "gap");
---

<Layout title="Zunou — Japan-Led GTM Strategy">
  <!-- HERO -->
  <section class="pt-24 sm:pt-32 pb-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-10 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Flag class="w-3.5 h-3.5" />
          Internal — for review
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">
          Marco Avila · 2026-05-11 · v1
        </span>
      </div>

      <h1
        class="font-display text-[3.25rem] sm:text-[5rem] lg:text-[6.5rem] leading-[0.95] tracking-tight mb-10 max-w-5xl"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        Zunou works inside.<br />
        <span class="text-[var(--color-ink-soft)]">
          Now we make it work outside.
        </span>
      </h1>

      <div class="prose-block max-w-3xl mb-12" data-reveal="fade-up" data-reveal-delay="2">
        <p>
          The product is alive because the <em>density</em> is there — every meeting on the same calendar, every chat in the same workspace, every decision routed back to the right person. The AI is useful because it has context. Take the context away and the AI is a chat box.
        </p>
        <p>
          The 12-month question, then, is not <em>"how do we sell an AI Chief of Staff"</em> — it is <strong>"how do we manufacture that density inside small, defined groups in our home market, fast enough to matter, before the global incumbents close the window?"</strong>
        </p>
      </div>

      <div
        class="flex flex-wrap items-center gap-3 mb-16"
        data-reveal="fade-up"
        data-reveal-delay="3"
      >
        <a
          href="#decisions"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-[var(--color-ink)] text-[var(--color-paper)] text-sm font-semibold hover:bg-[var(--color-accent)] transition-colors"
        >
          <CheckSquare class="w-4 h-4" />
          Jump to the 17 decisions
        </a>
        <a
          href="#trends"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-[var(--color-line)] text-sm font-semibold hover:border-[var(--color-ink)] transition-colors"
        >
          <BookOpen class="w-4 h-4" />
          Read the story
          <ArrowDown class="w-3.5 h-3.5 ml-1" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Stat
          icon="target"
          value="¥30M ARR"
          label="Aspirational KGI"
          caveat="Within 12 mo of synchronized launch"
          revealDelay={4}
        />
        <Stat
          icon="users-round"
          value="4 + 4,000"
          label="Communities × TAI alone"
          caveat="Synchronized launch — sympathetic detonation"
          revealDelay={5}
        />
        <Stat
          icon="git-pull-request-arrow"
          value="~6 months"
          label="To stop-or-go decision"
          caveat="Pre-committed PMF stage-gate"
          revealDelay={6}
        />
      </div>

      <p
        class="mt-6 text-xs text-[var(--color-ink-faint)] max-w-3xl"
        data-reveal="fade-up"
        data-reveal-delay="7"
      >
        Unfamiliar with <Term name="KGI" />, <Term name="NSM" />, <Term name="PMF" />, <Term name="MCP" />, <Term name="Ringi" />, <Term name="Keigo" />, or <Term name="APPI" />? Hover any underlined term for an inline definition, or jump to the <a href="#glossary" class="text-[var(--color-accent)] hover:underline">full glossary</a>.
      </p>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- BACKGROUND -->
  <section class="py-16 sm:py-20 bg-[var(--color-paper-soft)]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-4 mb-6" data-reveal="fade-up">
        <span class="section-number">
          <span>00 · Background</span>
        </span>
      </div>

      <h2
        class="font-display text-3xl sm:text-4xl mb-6 max-w-3xl leading-tight"
        data-reveal="fade-up"
        data-reveal-delay="1"
      >
        Zunou is an AI Chief of Staff company, based in Japan.
      </h2>

      <div class="prose-block max-w-3xl" data-reveal="fade-up" data-reveal-delay="2">
        <p>
          <strong>The opening:</strong> the "AI Chief of Staff" category has an empty seat in Japan. Xembly (the US category leader, $20M raised) shut down in June 2024. The remaining US entrants (alfred_, Klaio, Ashley AI) are consumer-priced individual tools with no Japanese localization. The category window in Japan is open for roughly 6–9 months before Notion AI / Slack AI / Microsoft Copilot ship comparable cross-app surfaces.
        </p>
        <p>
          <strong>The proposal you're about to read</strong> answers one question: <em class="font-display">how do we manufacture density inside small Tokyo communities, fast enough to matter, before that window closes?</em>
        </p>
      </div>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- 01 · POSTURE -->
  <Section
    id="posture"
    number="01"
    eyebrow="What this is"
    title="A proposal, not a verdict."
    lede="Every number here is a hypothesis. Every choice a defensible best-guess. If you finish reading and have no objections, we haven't written it well enough."
    tone="soft"
  >
    <div class="grid sm:grid-cols-2 gap-8 max-w-4xl">
      <div data-reveal="fade-up">
        <div class="flex items-center gap-2 mb-4">
          <CircleCheck class="w-5 h-5 text-[var(--color-success)]" />
          <h3 class="font-semibold">What this <em class="font-display">is</em></h3>
        </div>
        <ul class="space-y-2.5 text-[var(--color-ink-soft)] leading-relaxed">
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A proposal grounded in evidence, with citations.</span></li>
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A framework with a stop-or-go decision built in.</span></li>
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A contract for what we instrument from week one.</span></li>
        </ul>
      </div>
      <div data-reveal="fade-up" data-reveal-delay="1">
        <div class="flex items-center gap-2 mb-4">
          <AlertTriangle class="w-5 h-5 text-[var(--color-ink-soft)]" />
          <h3 class="font-semibold">What this <em class="font-display">isn't</em></h3>
        </div>
        <ul class="space-y-2.5 text-[var(--color-ink-soft)] leading-relaxed">
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A final answer — strategy is a living document.</span></li>
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A request for consensus — explicit objections preferred.</span></li>
          <li class="flex gap-2"><span class="text-[var(--color-ink-faint)]">·</span><span>A sales pitch — this is internal alignment.</span></li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- 02 · TRENDS -->
  <Section
    id="trends"
    number="02"
    eyebrow="Three things changed"
    title="The window is open right now. It won't be in 12 months."
    lede="A category leader exited. Japan's adoption tipped past 30%. Every productivity app is racing to embed agents."
  >
    <div class="grid md:grid-cols-3 gap-4 mb-12">
      <Stat
        icon="skull"
        value="Xembly"
        label="US category leader exited"
        caveat="June 2024 — $20M raised, customers Salesforce / Qualtrics / Twilio."
        source={{ label: "GeekWire", url: "https://www.geekwire.com/2024/enterprise-ai-company-xembly-abruptly-ends-service-for-users-says-its-working-on-new-chapter/" }}
      />
      <Stat
        icon="trending-up"
        value="34.6%"
        label="Japanese firms now use generative AI"
        caveat="March 2026 · Yomiuri Shimbun / Teikoku Databank · n = 23,349 firms · +14.2% considering."
        source={{ label: "BigGo Finance summary", url: "https://finance.biggo.com/news/t_86650BX0tZvRTvK4Pz" }}
        revealDelay={1}
      />
      <Stat
        icon="bot"
        value="40%"
        label="Of enterprise apps will embed AI agents by EOY 2026"
        caveat="Up from < 5% in 2025."
        source={{ label: "Gartner press release", url: "https://www.gartner.com/en/newsroom/press-releases/2025-08-26-gartner-predicts-40-percent-of-enterprise-apps-will-feature-task-specific-ai-agents-by-2026-up-from-less-than-5-percent-in-2025" }}
        revealDelay={2}
      />
    </div>

    <div
      class="border-l-4 border-[var(--color-warning)] pl-6 py-4 bg-[var(--color-warning-soft)]/40 rounded-r-lg"
      data-reveal="fade-up"
    >
      <p class="text-sm sm:text-base leading-relaxed">
        <strong class="text-[var(--color-ink)]">The counter-pressure:</strong>
        Gartner reports <strong class="text-[var(--color-ink)]">88% of AI agent pilots fail to graduate to production</strong> — evaluation gaps (64%), governance (57%), reliability (51%). Most buyers have been burned. Our positioning is the response to that wound: <em class="font-display">not another agent pilot — the morning briefing your team will actually use tomorrow.</em>
      </p>
    </div>
  </Section>

  <!-- 03 · MCP MOAT -->
  <Section
    id="moat"
    number="03"
    eyebrow="The architectural moat"
    title="MCP-native. The cross-app moat is in the protocol, not in marketing copy."
    lede="Notion AI sees Notion. Slack AI sees Slack. Microsoft Copilot sees M365. Zunou sees the entire Model Context Protocol ecosystem."
    tone="warm"
  >
    <div class="grid md:grid-cols-3 gap-4 mb-12">
      <Stat
        icon="plug"
        value="10,000+"
        label="Public MCP servers (Mar 2026)"
        caveat="Slack · Notion · Linear · Salesforce · GitHub · Google Workspace · M365 · Stripe · Sentry · Vercel · Supabase · Figma."
        source={{ label: "DigitalApplied adoption stats", url: "https://www.digitalapplied.com/blog/mcp-adoption-statistics-2026-model-context-protocol" }}
      />
      <Stat
        icon="trending-up"
        value="4,750%"
        label="MCP SDK download growth in 16 months"
        caveat="2M / month at launch (Nov 2024) → 97M / month (Mar 2026)."
        source={{ label: "Pento — Year of MCP", url: "https://www.pento.ai/blog/a-year-of-mcp-2025-review" }}
        revealDelay={1}
      />
      <Stat
        icon="globe"
        value="92%"
        label="Of new agent frameworks ship with MCP built-in"
        caveat="LangGraph · CrewAI · AutoGen + OpenAI / Microsoft / Google all on board."
        source={{ label: "The New Stack — Why MCP won", url: "https://thenewstack.io/why-the-model-context-protocol-won/" }}
        revealDelay={2}
      />
    </div>

    <div class="prose-block mb-10" data-reveal="fade-up">
      <p>
        MCP went from <em>"Anthropic-led standard"</em> to <strong>industry-default standard</strong> between mid-2025 and early 2026. Anthropic donated the protocol to the Linux Foundation's Agentic AI Foundation in December 2025 — co-founded by Anthropic, Block, and OpenAI. Building bespoke OAuth clients per integration in 2026 is like building bespoke auth in 2018.
      </p>
      <p>
        We adopt the protocol as a <strong>host</strong> and inherit the entire server ecosystem. Engineering effort to support our top 25 integrations collapses from <strong>~25 OAuth implementations to 1 MCP host + 25 documentation pages</strong>.
      </p>
    </div>

    <div class="border-l-2 border-[var(--color-accent)] pl-6 max-w-2xl" data-reveal="fade-up" data-reveal-delay="1">
      <p class="pull-quote">
        Notion will not expose Slack via MCP. Slack will not expose Notion via MCP. <span class="not-italic font-semibold">We aggregate them.</span>
      </p>
    </div>
  </Section>

  <!-- 04 · COMPETITIVE -->
  <Section
    id="competitive"
    number="04"
    eyebrow="The category right now"
    title="An empty seat in Japan. Six commoditising entrants globally. Three incumbents that will eventually compete."
    lede="The accurate answer to 'who else is doing this in Japan' is short. The answer to 'who could do this from a position of distribution' is longer."
  >
    <div class="overflow-x-auto -mx-6 px-6" data-reveal="fade-up">
      <table class="w-full text-sm border border-[var(--color-line)] rounded-xl overflow-hidden">
        <thead class="bg-[var(--color-paper-soft)]">
          <tr>
            <th class="text-left p-3 font-semibold">Competitor</th>
            <th class="text-left p-3 font-semibold">Where</th>
            <th class="text-left p-3 font-semibold">Status (May 2026)</th>
            <th class="text-left p-3 font-semibold">Threat to Zunou</th>
          </tr>
        </thead>
        <tbody class="bg-[var(--color-paper)]">
          <tr class="border-t border-[var(--color-line-soft)]">
            <td class="p-3 font-semibold">Xembly</td>
            <td class="p-3 text-[var(--color-ink-soft)]">US</td>
            <td class="p-3"><span class="inline-block px-2 py-0.5 rounded bg-[var(--color-danger-soft)] text-[var(--color-danger)] text-xs font-semibold">Discontinued June 2024</span></td>
            <td class="p-3 text-[var(--color-ink-soft)]">None — exited the market</td>
          </tr>
          <tr class="border-t border-[var(--color-line-soft)]">
            <td class="p-3 font-semibold">alfred_</td>
            <td class="p-3 text-[var(--color-ink-soft)]">US / global</td>
            <td class="p-3 text-[var(--color-ink-soft)]">$24.99/mo, individual</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Low — wrong price point, no JP localization</td>
          </tr>
          <tr class="border-t border-[var(--color-line-soft)]">
            <td class="p-3 font-semibold">Ashley AI · Klaio · Alyna</td>
            <td class="p-3 text-[var(--color-ink-soft)]">US / EU</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Active, individual-tier</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Low — no JP presence</td>
          </tr>
          <tr class="border-t border-[var(--color-line-soft)] bg-[var(--color-warning-soft)]/20">
            <td class="p-3 font-semibold">Notion AI</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Global · JP language ✓</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Notion-internal data only</td>
            <td class="p-3 text-[var(--color-ink-soft)]">High on commodity surfaces · low on cross-app agentic</td>
          </tr>
          <tr class="border-t border-[var(--color-line-soft)] bg-[var(--color-warning-soft)]/20">
            <td class="p-3 font-semibold">Slack AI · MS Copilot</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Global · APAC growing 19% YoY</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Single-app surface; embedded distribution</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Highest long-run threat — but neither will localize Keigo / Ringi</td>
          </tr>
          <tr class="border-t border-[var(--color-line-soft)]">
            <td class="p-3 font-semibold">Otter · Fireflies</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Global · partial JP</td>
            <td class="p-3 text-[var(--color-ink-soft)]">Meeting transcription</td>
            <td class="p-3 text-[var(--color-ink-soft)]">High on transcription · low on agentic CoS</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-10 grid md:grid-cols-2 gap-6 max-w-4xl">
      <div data-reveal="fade-up">
        <h3 class="font-display text-xl mb-3">Japanese AI companies = partners, not competitors</h3>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          Sakana AI ($135M Series B, Nov 2025), LayerX ($100M Series B, Sep 2025), ELYZA (KDDI-backed), Rakuten AI 3.0 — all sell foundation models or back-office automation. None compete with the exec CoS surface. The right move is co-marketing (joint PR Times release, joint AiSalon Tokyo demo) — not competing.
        </p>
      </div>
      <div data-reveal="fade-up" data-reveal-delay="1">
        <h3 class="font-display text-xl mb-3">The 6–9 month window</h3>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
          Notion AI / Slack AI / Microsoft Copilot will ship cross-app agentic surfaces in the medium term. Zunou's defensibility is three things they will not build: cross-app context (architectural — see §03 MCP moat), JP-localized affordances (Keigo, Ringi), and the community-distributed habit loop.
        </p>
      </div>
    </div>
  </Section>

  <!-- 05 · MECHANIC -->
  <Section
    id="mechanic"
    number="05"
    eyebrow="The mechanic"
    title="Density manufactures product-market fit."
    lede="Not features. Not virality. Density — the threshold past which a small group's behavior changes."
  >
    <div class="prose-block mb-12" data-reveal="fade-up">
      <p>
        Slack only becomes Slack at ~2,000 team messages — past that, retention jumps to 93%. Facebook only became Facebook when users hit 7 friends in 10 days. Below that threshold, users churn. Above it, they stay for life.
      </p>
      <p>
        Zunou's working hypothesis — refit monthly against real cohort data:
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 mb-14">
      <Stat icon="users-round" value="5" label="Colleagues from the same community, active" />
      <Stat icon="calendar-check" value="1" label="Connected calendar" revealDelay={1} />
      <Stat icon="sparkles" value="3" label="AI actions accepted within 14 days" revealDelay={2} />
    </div>

    <div class="prose-block mb-10" data-reveal="fade-up">
      <p>
        The launch mechanic that produces this density is the part of the strategy that sounds unusual. Instead of launching one Tokyo community at a time (the Eventbrite playbook — city-by-city, the "campus model"), we light <strong>four overlapping communities in the same week</strong>, picked specifically because their members already see each other.
      </p>
      <p>
        The physics term for this is <strong>sympathetic detonation</strong> — adjacent explosive charges igniting each other through shockwave coupling. The growth-theory term is <strong>percolation threshold</strong> — the moment a sparse graph flips from disconnected clusters into one giant connected component.
      </p>
      <p>
        In plain terms: an attendee at AI Tinkerers Ginza on Tuesday sees three people at Venture Café Toranomon on Thursday. By the end of the launch week, "everyone I know is on Zunou" becomes literally true inside the Tokyo English-speaking founder graph.
      </p>
    </div>

    <div class="border-l-2 border-[var(--color-accent)] pl-6 max-w-2xl" data-reveal="fade-up" data-reveal-delay="1">
      <p class="pull-quote">
        One launch leaks. Four overlapping launches chain-react.
      </p>
    </div>
  </Section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- 05 · COMMUNITIES -->
  <Section
    id="communities"
    number="06"
    eyebrow="The four"
    title="Tokyo. Same week. Synchronized."
    lede="Not picked for prestige. Picked because their members already overlap — verified by roster sampling before launch."
  >
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      <Community
        name="TAI (Tokyo AI)"
        members="4,000+ members"
        channel="Monthly meetup · Connpass · Slack"
        rationale="Largest technical AI community in Japan. Engineers, researchers, investors, PMs. Cross-cuts every other community in our launch graph."
        url="https://www.tokyoai.jp/"
        icon="layers"
      />
      <Community
        name="AI Tinkerers Ginza"
        members="~200 selective"
        channel="Monthly demo nights"
        rationale="Highest-signal builders — the people who write the tools other engineers adopt. If they pick up Zunou, it spreads from there."
        url="https://tokyo.aitinkerers.org/"
        icon="wrench"
        revealDelay={1}
      />
      <Community
        name="Tokyo Founders Group"
        members="~150 operators"
        channel="Private list"
        rationale="Operator-founders — exactly Beachhead A ICP. Bilingual, English-first leadership at Tokyo scale-ups."
        icon="rocket"
        revealDelay={2}
      />
      <Community
        name="Venture Café Toranomon"
        members="Weekly rotating"
        channel="Thursday physical gathering"
