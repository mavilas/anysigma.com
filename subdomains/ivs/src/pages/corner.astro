---
import Layout from "../layouts/Layout.astro";
import {
  Mic,
  Brain,
  UsersRound,
  Clock,
  Calendar,
  Bell,
  ArrowRight,
  KeyRound,
  Coffee,
  Armchair,
  MapPin,
  Check,
  User,
  ChevronRight,
} from "@lucide/astro";

const steps = [
  {
    n: "01",
    title: "Record 30 seconds",
    body: "One prompt on screen: \"What are you working on, and who do you want to meet?\" Phones up, headphones offered if it's noisy. You can re-record once.",
  },
  {
    n: "02",
    title: "Zunou extracts the intent",
    body: "Transcribes, then pulls four fields: working on, looking for, can help with, vibe. You see a card before submitting. Edit if needed.",
  },
  {
    n: "03",
    title: "Match in 60 seconds",
    body: "Embedding-based pairing against everyone else in queue. You see the other person's name, photo, summary card, and a play button for their 30s. Not blind.",
  },
  {
    n: "04",
    title: "Meet. Anywhere. 15 minutes.",
    body: "Matched pairs choose their venue: the Corner, a panel break, a café, the hotel lobby, the conference floor. The Corner is one option, not the requirement.",
  },
  {
    n: "05",
    title: "Leave with the artifact",
    body: "Both phones get the Zunou note: conversation highlights, the other person's contact, and a one-tap follow-up dropped into the calendar two weeks out.",
  },
  {
    n: "06",
    title: "The nudge two weeks later",
    body: "Email and push: \"how did the conversation with X go?\" Then a second nudge to schedule the follow-up. This is how the network compounds.",
  },
];

const chipsForFrame2 = ["working on", "looking for", "can help with", "vibe"];
---

<Layout title="The Corner · how it works">
  <!-- HERO -->
  <section class="pt-14 sm:pt-20 pb-10">
    <div class="max-w-6xl mx-auto px-6">
      <div data-reveal="fade-up" class="text-xs uppercase tracking-[0.18em] text-[var(--color-accent)] font-semibold mb-4">Slide 02 · The Corner</div>
      <h1 data-reveal="fade-up" data-reveal-delay="1" class="font-display text-[2.75rem] sm:text-[4rem] leading-[1.05] tracking-tight mb-6 max-w-4xl">
        Voice in. Insight out. <span class="text-[var(--color-accent)]">Match made.</span>
      </h1>
      <p data-reveal="fade-up" data-reveal-delay="2" class="text-lg sm:text-xl text-[var(--color-ink-soft)] max-w-[60ch] leading-[1.6]">
        Six steps. Two minutes from queue to seated. Fifteen minutes of conversation. A lifetime of follow-up if the match was right.
      </p>
    </div>
  </section>

  <!-- FILM STRIP -->
  <section class="pb-10" aria-label="Step-by-step animation of how the Corner works">
    <div class="max-w-6xl mx-auto px-6">
      <div
        id="film-strip"
        data-reveal="fade-up"
        class="film-strip"
        role="region"
        aria-roledescription="animated carousel"
      >
        <!-- frame 01 · voice -->
        <article class="frame" data-frame="0" aria-label="Step 1: record 30 seconds">
          <div class="frame-stage stage-voice">
            <div class="stage-glow" aria-hidden="true"></div>
            <div class="rec-label" aria-hidden="true">
              <span class="rec-dot"></span>
              <span>REC</span>
            </div>
            <div class="rec-timer" aria-hidden="true">0:14</div>
            <span class="wave-baseline" aria-hidden="true"></span>
            <div class="waveform" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
              <span></span><span></span><span></span><span></span><span></span>
              <span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
          <div class="frame-meta">
            <span class="frame-num">01</span>
            <span class="frame-title">Record 30s</span>
          </div>
        </article>

        <ChevronRight class="strip-arrow" aria-hidden="true" />

        <!-- frame 02 · extract -->
        <article class="frame" data-frame="1" aria-label="Step 2: Zunou extracts intent">
          <div class="frame-stage">
            <div class="chips" aria-hidden="true">
              {chipsForFrame2.map((c, i) => (
                <span class="chip" style={`--chip-i: ${i}`}>{c}</span>
              ))}
            </div>
          </div>
          <div class="frame-meta">
            <span class="frame-num">02</span>
            <span class="frame-title">Extract intent</span>
          </div>
        </article>

        <ChevronRight class="strip-arrow" aria-hidden="true" />

        <!-- frame 03 · match -->
        <article class="frame" data-frame="2" aria-label="Step 3: match found">
          <div class="frame-stage">
            <div class="match" aria-hidden="true">
              <span class="avatar a"><User class="w-4 h-4" /></span>
              <span class="match-line"></span>
              <span class="avatar b"><User class="w-4 h-4" /></span>
              <span class="match-pill"><Check class="w-3 h-3" /> Matched</span>
            </div>
          </div>
          <div class="frame-meta">
            <span class="frame-num">03</span>
            <span class="frame-title">Match in 60s</span>
          </div>
        </article>

        <ChevronRight class="strip-arrow" aria-hidden="true" />

        <!-- frame 04 · venue -->
        <article class="frame" data-frame="3" aria-label="Step 4: meet anywhere">
          <div class="frame-stage">
            <div class="venue-carousel" aria-hidden="true">
              <span class="venue v0"><Coffee class="w-6 h-6" /></span>
              <span class="venue v1"><Armchair class="w-6 h-6" /></span>
              <span class="venue v2"><MapPin class="w-6 h-6" /></span>
            </div>
          </div>
          <div class="frame-meta">
            <span class="frame-num">04</span>
            <span class="frame-title">Meet anywhere</span>
          </div>
        </article>

        <ChevronRight class="strip-arrow" aria-hidden="true" />

        <!-- frame 05 · calendar -->
        <article class="frame" data-frame="4" aria-label="Step 5: artifact in calendar">
          <div class="frame-stage">
            <div class="cal" aria-hidden="true">
              <div class="cal-grid">
                {Array.from({ length: 21 }).map((_, i) => (
                  <span class={`cal-cell${i === 16 ? " cal-active" : ""}`}></span>
                ))}
              </div>
              <span class="cal-event">+ Follow-up</span>
            </div>
          </div>
          <div class="frame-meta">
            <span class="frame-num">05</span>
            <span class="frame-title">Artifact dropped</span>
          </div>
        </article>

        <ChevronRight class="strip-arrow" aria-hidden="true" />

        <!-- frame 06 · nudge -->
        <article class="frame" data-frame="5" aria-label="Step 6: day-14 nudge">
          <div class="frame-stage">
            <div class="bell-wrap" aria-hidden="true">
              <span class="bell"><Bell class="w-8 h-8" /></span>
              <span class="bell-badge">1</span>
              <span class="bell-glow"></span>
            </div>
          </div>
          <div class="frame-meta">
            <span class="frame-num">06</span>
            <span class="frame-title">Day-14 nudge</span>
          </div>
        </article>
      </div>

      <!-- progress dots (mobile + a11y) -->
      <div class="strip-dots" aria-hidden="true">
        {steps.map((_, i) => <span class="strip-dot" data-dot={i}></span>)}
      </div>
    </div>
  </section>

  <!-- DETAIL: title + body for each step -->
  <section class="pb-20">
    <div class="max-w-6xl mx-auto px-6">
      <div data-reveal="fade-up" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {steps.map((s, i) => (
          <div data-detail={i} class="border border-[var(--color-line)] bg-[var(--color-paper)] rounded-lg p-5 transition-all duration-300">
            <div class="flex items-center gap-2 mb-2">
              <span class="font-mono text-[10px] tracking-[0.18em] text-[var(--color-ink-faint)]">{s.n}</span>
              <span class="detail-active-pill">active</span>
            </div>
            <div class="font-display text-lg leading-tight mb-1.5">{s.title}</div>
            <p class="text-sm text-[var(--color-ink-soft)] leading-[1.55]">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY VOICE + key points -->
  <section class="py-20 bg-[var(--color-paper-soft)] border-y border-[var(--color-line)]">
    <div class="max-w-6xl mx-auto px-6">
      <div data-reveal="fade-up" class="grid lg:grid-cols-[1fr_360px] gap-10 items-start">
        <div>
          <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-accent)] font-semibold mb-4">Why voice, not a form</div>
          <h2 class="font-display text-3xl sm:text-4xl leading-[1.12] tracking-tight mb-5">
            The platform that runs the Corner is Zunou. Audio in, insight out is what we already do.
          </h2>
          <p class="text-lg text-[var(--color-ink-soft)] leading-[1.6] mb-3">
            A LinkedIn URL tells you what someone did. A 30-second recording tells you what's on their mind this week. The Corner matches on the second one because that's what makes a 15-minute conversation worth the seat.
          </p>
          <p class="text-lg text-[var(--color-ink-soft)] leading-[1.6]">
            For attendees, the signup is the demo. They record once. They feel Zunou's value before they sit down. The conference becomes the onboarding for the platform they'll keep using long after Kyoto.
          </p>
        </div>
        <div class="space-y-4">
          <div class="border border-[var(--color-line)] bg-[var(--color-paper)] rounded-lg p-6">
            <div class="flex items-center gap-2 mb-3">
              <KeyRound class="w-4 h-4 text-[var(--color-accent)]" />
              <span class="text-xs uppercase tracking-[0.18em] text-[var(--color-accent)] font-semibold">Key point</span>
            </div>
            <p class="font-display text-lg leading-snug mb-3">The Corner is one venue. The platform is the whole event.</p>
            <p class="text-sm text-[var(--color-ink-soft)] leading-[1.55]">
              Matches happen wherever pairs choose to meet. The Corner exists for the people who want a branded, photogenic, scarcity-marketed place to land. Everyone else uses the floor IVS already has.
            </p>
          </div>
          <div class="border border-[var(--color-line)] bg-[var(--color-paper)] rounded-lg p-6">
            <div class="flex items-center gap-2 mb-3">
              <KeyRound class="w-4 h-4 text-[var(--color-accent)]" />
              <span class="text-xs uppercase tracking-[0.18em] text-[var(--color-accent)] font-semibold">Bored, come</span>
            </div>
            <p class="font-display text-lg leading-snug mb-3">"I had a 30-minute gap" is easier to say than "I'm desperate to network."</p>
            <p class="text-sm text-[var(--color-ink-soft)] leading-[1.55]">
              Limited Corner spots create scarcity. Voice matching guarantees quality. The Corner becomes a thing people queue for because it works, not because they're forced.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6 flex flex-wrap gap-3">
      <a href="/value" class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-[var(--color-accent)] text-white hover:opacity-90 transition-opacity font-medium">
        What IVS gets <ArrowRight class="w-4 h-4" />
      </a>
      <a href="/" class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-[var(--color-line)] hover:bg-[var(--color-paper-soft)] transition-colors">
        Back to the pitch
      </a>
    </div>
  </section>

  <!-- FILM STRIP STYLES + LOGIC -->
  <style is:global>
    /* ───────────────────────── FILM STRIP CONTAINER ───────────────────────── */
    .film-strip {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 26px 18px;
      border: 1px solid var(--color-line);
      background: var(--color-paper);
      border-radius: 18px;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    @media (max-width: 900px) {
      .film-strip {
        gap: 4px;
        padding: 20px 14px;
      }
    }
    .film-strip::-webkit-scrollbar { height: 0; }

    /* ───────────────────────── FRAME (per step) ───────────────────────── */
    .frame {
      position: relative;
      flex: 0 0 auto;
      width: 152px;
      min-height: 192px;
      padding: 14px 12px 12px;
      border: 1px solid var(--color-line);
      background: var(--color-paper-soft);
      border-radius: 14px;
      scroll-snap-align: center;
      transition: transform .35s cubic-bezier(.2,.7,.2,1),
                  border-color .35s,
                  background-color .35s,
                  box-shadow .35s;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    @media (max-width: 900px) {
      .frame { width: 170px; }
    }
    .frame.active {
      background: var(--color-paper);
      border-color: var(--color-accent);
      transform: translateY(-3px);
      box-shadow: 0 16px 36px -20px rgba(74, 0, 224, 0.32),
                  0 0 0 3px rgba(74, 0, 224, 0.06);
    }

    .frame-stage {
      position: relative;
      flex: 1;
      min-height: 110px;
      border-radius: 10px;
      background: linear-gradient(180deg,
        rgba(236, 229, 251, 0.55) 0%,
        rgba(236, 229, 251, 0.18) 100%);
      border: 1px solid var(--color-line-soft);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .frame-icon {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: var(--color-paper);
      border: 1px solid var(--color-line);
      color: var(--color-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: .75;
    }

    .frame-meta {
      display: flex;
      align-items: flex-start;
      gap: 6px;
      padding: 0 2px;
      min-width: 0;
    }
    .frame-num {
      flex: 0 0 auto;
      font-family: var(--font-mono);
      font-size: 9.5px;
      letter-spacing: 0.16em;
      color: var(--color-ink-faint);
      padding-top: 2px;
    }
    .frame-title {
      flex: 1 1 auto;
      min-width: 0;
      font-family: var(--font-display);
      font-size: 12.5px;
      line-height: 1.18;
      color: var(--color-ink);
      letter-spacing: -0.003em;
      word-wrap: break-word;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    /* ───────────────────────── ARROW BETWEEN FRAMES ───────────────────────── */
    .strip-arrow {
      width: 14px;
      height: 14px;
      flex: 0 0 auto;
      color: var(--color-line);
      opacity: .65;
      transition: color .35s, transform .35s, opacity .35s;
    }
    .strip-arrow.lit {
      color: var(--color-accent);
      opacity: 1;
      transform: scale(1.15);
    }
    @media (max-width: 900px) {
      .strip-arrow { display: none; }
    }

    /* ───────────────────────── PROGRESS DOTS ───────────────────────── */
    .strip-dots {
      display: flex;
      justify-content: center;
      gap: 7px;
      margin-top: 18px;
    }
    .strip-dot {
      width: 6px; height: 6px;
      border-radius: 999px;
      background: var(--color-line);
      transition: background-color .3s, transform .3s, width .3s;
    }
    .strip-dot.active {
      background: var(--color-accent);
      width: 18px;
    }

    /* ───────────────────────── 01 · WAVEFORM (Siri-style mirrored) ───────────────────────── */
    .stage-voice { padding: 0; overflow: hidden; }

    .stage-glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 60%,
        rgba(74, 0, 224, 0.15) 0%,
        rgba(74, 0, 224, 0.04) 40%,
        transparent 70%);
      opacity: 0;
      transition: opacity .5s;
      pointer-events: none;
    }
    .frame.active .stage-glow {
      opacity: 1;
      animation: stage-glow-pulse 2.4s ease-in-out infinite;
    }
    @keyframes stage-glow-pulse {
      0%, 100% { opacity: .7; }
      50%      { opacity: 1; }
    }

    .wave-baseline {
      position: absolute;
      left: 14px;
      right: 14px;
      top: 50%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent 0%,
        rgba(74, 0, 224, 0.18) 25%,
        rgba(74, 0, 224, 0.28) 50%,
        rgba(74, 0, 224, 0.18) 75%,
        transparent 100%);
      pointer-events: none;
      z-index: 0;
    }

    .rec-label {
      position: absolute;
      top: 8px;
      left: 8px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-family: var(--font-mono);
      font-size: 8.5px;
      letter-spacing: 0.18em;
      color: var(--color-danger);
      font-weight: 700;
      z-index: 2;
    }
    .rec-dot {
      width: 6px; height: 6px;
      border-radius: 999px;
      background: var(--color-danger);
      box-shadow: 0 0 6px rgba(231, 49, 31, 0.45);
    }
    .frame.active .rec-dot {
      animation: rec-blink 1.2s ease-in-out infinite;
    }
    @keyframes rec-blink {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%      { opacity: .35; transform: scale(.82); }
    }

    .rec-timer {
      position: absolute;
      top: 8px;
      right: 8px;
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.04em;
      color: var(--color-ink-faint);
      font-weight: 500;
      z-index: 2;
      font-variant-numeric: tabular-nums;
    }

    .waveform {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2.5px;
      width: 100%;
      height: 100%;
      padding: 0 14px;
      z-index: 1;
    }
    .waveform span {
      flex: 0 0 auto;
      width: 2.5px;
      height: 36px;
      background: var(--color-accent);
      border-radius: 2px;
      transform-origin: center center;
      transform: scaleY(0.12);
      opacity: .35;
      transition: opacity .3s, transform .3s;
    }
    .frame.active .waveform span {
      opacity: 1;
      animation: wave-bar var(--wave-dur, 0.9s) ease-in-out infinite alternate;
      animation-delay: var(--wave-delay, 0s);
    }
    @keyframes wave-bar {
      from { transform: scaleY(var(--wave-min, 0.18)); }
      to   { transform: scaleY(var(--wave-max, 1.0)); }
    }
    /* Per-bar parameters: durations are primes-ish to break sync,
       max heights vary so the wave looks like real speech (taller in middle,
       short at edges, with random taller bars sprinkled). */
    .frame.active .waveform span:nth-child(1)  { --wave-dur: 0.71s; --wave-delay: -0.05s; --wave-min: 0.18; --wave-max: 0.42; }
    .frame.active .waveform span:nth-child(2)  { --wave-dur: 0.43s; --wave-delay: -0.22s; --wave-min: 0.22; --wave-max: 0.58; }
    .frame.active .waveform span:nth-child(3)  { --wave-dur: 0.91s; --wave-delay: -0.39s; --wave-min: 0.26; --wave-max: 0.78; }
    .frame.active .waveform span:nth-child(4)  { --wave-dur: 0.58s; --wave-delay: -0.11s; --wave-min: 0.30; --wave-max: 0.65; }
    .frame.active .waveform span:nth-child(5)  { --wave-dur: 1.07s; --wave-delay: -0.47s; --wave-min: 0.32; --wave-max: 0.92; }
    .frame.active .waveform span:nth-child(6)  { --wave-dur: 0.49s; --wave-delay: -0.18s; --wave-min: 0.40; --wave-max: 0.84; }
    .frame.active .waveform span:nth-child(7)  { --wave-dur: 0.83s; --wave-delay: -0.31s; --wave-min: 0.42; --wave-max: 1.00; }
    .frame.active .waveform span:nth-child(8)  { --wave-dur: 0.61s; --wave-delay: -0.08s; --wave-min: 0.45; --wave-max: 0.95; }
    .frame.active .waveform span:nth-child(9)  { --wave-dur: 0.95s; --wave-delay: -0.44s; --wave-min: 0.42; --wave-max: 1.00; }
    .frame.active .waveform span:nth-child(10) { --wave-dur: 0.52s; --wave-delay: -0.25s; --wave-min: 0.38; --wave-max: 0.78; }
    .frame.active .waveform span:nth-child(11) { --wave-dur: 0.78s; --wave-delay: -0.13s; --wave-min: 0.34; --wave-max: 0.88; }
    .frame.active .waveform span:nth-child(12) { --wave-dur: 0.46s; --wave-delay: -0.36s; --wave-min: 0.28; --wave-max: 0.62; }
    .frame.active .waveform span:nth-child(13) { --wave-dur: 0.88s; --wave-delay: -0.07s; --wave-min: 0.24; --wave-max: 0.74; }
    .frame.active .waveform span:nth-child(14) { --wave-dur: 0.53s; --wave-delay: -0.29s; --wave-min: 0.20; --wave-max: 0.48; }
    .frame.active .waveform span:nth-child(15) { --wave-dur: 0.69s; --wave-delay: -0.16s; --wave-min: 0.16; --wave-max: 0.36; }

    .mic-orb {
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 22px; height: 22px;
      border-radius: 999px;
      background: var(--color-accent);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px -4px rgba(74, 0, 224, 0.55);
      z-index: 2;
    }
    .frame.active .mic-orb {
      animation: mic-breathe 1.6s ease-in-out infinite;
    }
    @keyframes mic-breathe {
      0%, 100% { transform: translateX(-50%) scale(1);    box-shadow: 0 4px 14px -4px rgba(74, 0, 224, 0.55); }
      50%      { transform: translateX(-50%) scale(1.08); box-shadow: 0 6px 18px -2px rgba(74, 0, 224, 0.7); }
    }

    .pulse-ring {
      position: absolute;
      left: 50%;
      bottom: 8px;
      width: 22px; height: 22px;
      margin-left: -11px;
      border-radius: 999px;
      border: 1.5px solid var(--color-accent);
      opacity: 0;
      pointer-events: none;
    }
    .frame.active .pulse-ring { animation: pulse 2.2s cubic-bezier(.2,.7,.2,1) infinite; }
    .frame.active .pulse-ring-2 { animation-delay: 1.1s; }
    @keyframes pulse {
      0%   { transform: scale(0.8); opacity: .55; }
      80%  { transform: scale(3.2); opacity: 0; }
      100% { transform: scale(3.2); opacity: 0; }
    }

    /* ───────────────────────── 02 · CHIPS ───────────────────────── */
    .chips {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 4px 6px;
    }
    .chip {
      font-family: var(--font-sans);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.04em;
      padding: 3px 8px;
      border-radius: 999px;
      background: var(--color-paper);
      border: 1px solid var(--color-line);
      color: var(--color-ink-soft);
      transform: translateX(-8px);
      opacity: 0;
      transition: transform .3s, opacity .3s, background-color .3s, border-color .3s, color .3s;
    }
    .frame.active .chip {
      opacity: 1;
      transform: translateX(0);
      transition-delay: calc(var(--chip-i) * 180ms);
    }
    .frame.active .chip {
      animation: chip-highlight 4.8s ease-in-out infinite;
      animation-delay: calc(var(--chip-i) * 1.2s);
    }
    @keyframes chip-highlight {
      0%, 92%, 100% {
        background: var(--color-paper);
        border-color: var(--color-line);
        color: var(--color-ink-soft);
      }
      8%, 18% {
        background: var(--color-accent-soft);
        border-color: var(--color-accent);
        color: var(--color-accent-ink);
      }
    }

    /* ───────────────────────── 03 · MATCH ───────────────────────── */
    .match {
      position: relative;
      width: 100%;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .avatar {
      width: 30px; height: 30px;
      border-radius: 999px;
      background: var(--color-paper);
      border: 1px solid var(--color-line);
      color: var(--color-ink-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      transition: left .8s cubic-bezier(.2,.7,.2,1),
                  right .8s cubic-bezier(.2,.7,.2,1),
                  border-color .3s, color .3s;
    }
    .avatar.a { left: 10%; }
    .avatar.b { right: 10%; }
    .match-line {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scaleX(0);
      transform-origin: center;
      height: 2px;
      width: 36px;
      background: var(--color-accent);
      opacity: 0;
      transition: transform .5s ease-out .55s, opacity .3s .55s;
      border-radius: 2px;
    }
    .match-pill {
      position: absolute;
      bottom: -2px;
      left: 50%;
      transform: translateX(-50%) translateY(10px);
      font-family: var(--font-sans);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 999px;
      background: var(--color-accent);
      color: #fff;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      opacity: 0;
      transition: opacity .3s 0.95s, transform .35s 0.95s cubic-bezier(.2,.7,.2,1);
    }
    .frame.active .avatar.a { left: 32%; border-color: var(--color-accent); color: var(--color-accent); }
    .frame.active .avatar.b { right: 32%; border-color: var(--color-accent); color: var(--color-accent); }
    .frame.active .match-line { transform: translate(-50%, -50%) scaleX(1); opacity: 1; }
    .frame.active .match-pill { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* ───────────────────────── 04 · VENUE CAROUSEL ───────────────────────── */
    .venue-carousel {
      position: relative;
      width: 56px;
      height: 56px;
    }
    .venue {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-accent);
      opacity: 0;
      transform: translateY(8px) scale(.85);
      transition: opacity .5s, transform .5s;
    }
    .frame.active .venue {
      animation: venue-cycle 4.5s ease-in-out infinite;
    }
    .frame.active .venue.v0 { animation-delay: 0s; }
    .frame.active .venue.v1 { animation-delay: 1.5s; }
    .frame.active .venue.v2 { animation-delay: 3.0s; }
    @keyframes venue-cycle {
      0%, 100% { opacity: 0; transform: translateY(8px) scale(.85); }
      8%, 25%  { opacity: 1; transform: translateY(0) scale(1); }
      33%, 99% { opacity: 0; transform: translateY(-8px) scale(.85); }
    }

    /* ───────────────────────── 05 · CALENDAR ───────────────────────── */
    .cal {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 4px;
    }
    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 9px);
      gap: 4px;
    }
    .cal-cell {
      width: 9px; height: 9px;
      border-radius: 2px;
      background: var(--color-line);
      transition: background-color .3s;
    }
    .frame.active .cal-cell.cal-active {
      animation: cal-fill 4.5s ease-in-out infinite;
    }
    @keyframes cal-fill {
      0%, 30%  { background: var(--color-line); transform: scale(1); }
      45%, 80% { background: var(--color-accent); transform: scale(1.25); }
      95%, 100%{ background: var(--color-accent); transform: scale(1); }
    }
    .cal-event {
      font-family: var(--font-sans);
      font-size: 8.5px;
      font-weight: 600;
      letter-spacing: 0.04em;
      padding: 2px 7px;
      border-radius: 999px;
      background: var(--color-accent);
      color: #fff;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(-2px);
      transition: opacity .35s, transform .35s;
    }
    .frame.active .cal-event {
      animation: cal-event 4.5s ease-in-out infinite;
    }
    @keyframes cal-event {
      0%, 35%  { opacity: 0; transform: translateY(-2px) scale(.9); }
      55%, 95% { opacity: 1; transform: translateY(0) scale(1); }
      100%     { opacity: 0; transform: translateY(-2px) scale(.9); }
    }

    /* ───────────────────────── 06 · BELL ───────────────────────── */
    .bell-wrap {
      position: relative;
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .bell {
      color: var(--color-accent);
      display: flex;
      transform-origin: top center;
    }
    .frame.active .bell {
      animation: bell-ring 1.6s ease-in-out infinite;
    }
    @keyframes bell-ring {
      0%, 60%, 100% { transform: rotate(0deg); }
      66%           { transform: rotate(-12deg); }
      72%           { transform: rotate(10deg); }
      78%           { transform: rotate(-7deg); }
      84%           { transform: rotate(4deg); }
      90%           { transform: rotate(-2deg); }
    }
    .bell-badge {
      position: absolute;
      top: 0px;
      right: 2px;
      min-width: 16px;
      height: 16px;
      padding: 0 4px;
      border-radius: 999px;
      background: var(--color-danger);
      color: #fff;
      font-family: var(--font-sans);
      font-size: 9px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      transform: scale(0);
      transition: transform .3s cubic-bezier(.34, 1.56, .64, 1);
    }
    .bell-glow {
      position: absolute;
      inset: -6px;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(74, 0, 224, 0.18) 0%, transparent 65%);
      opacity: 0;
      transition: opacity .35s;
    }
    .frame.active .bell-badge { transform: scale(1); }
    .frame.active .bell-glow { opacity: 1; }

    /* ───────────────────────── DETAIL CARDS (cycle highlight) ───────────────────────── */
    [data-detail] {
      border-color: var(--color-line);
    }
    [data-detail] .detail-active-pill {
      display: none;
      font-size: 9px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 1px 6px;
      border-radius: 999px;
      background: var(--color-accent-soft);
      color: var(--color-accent-ink);
      font-weight: 600;
    }
    [data-detail].is-active {
      border-color: var(--color-accent);
      box-shadow: 0 8px 20px -16px rgba(74, 0, 224, 0.35);
    }
    [data-detail].is-active .detail-active-pill { display: inline-block; }

    /* ───────────────────────── REDUCED MOTION ───────────────────────── */
    @media (prefers-reduced-motion: reduce) {
      .frame, .strip-arrow, .strip-dot,
      .waveform span, .pulse-ring, .chip,
      .avatar, .match-line, .match-pill,
      .venue, .cal-cell, .cal-event,
      .bell, .bell-badge, .bell-glow,
      [data-detail] {
        animation: none !important;
        transition: none !important;
      }
      .frame.active .waveform span { transform: scaleY(0.75); }
      .frame.active .match-line { transform: translate(-50%, -50%) scaleX(1); opacity: 1; }
      .frame.active .match-pill { opacity: 1; transform: translateX(-50%); }
      .frame.active .chip { opacity: 1; transform: none; }
      .frame.active .venue.v0 { opacity: 1; transform: none; }
      .frame.active .cal-event { opacity: 1; transform: none; }
      .frame.active .bell-badge { transform: scale(1); }
    }
  </style>

  <script is:inline>
    (function () {
      const strip = document.getElementById("film-strip");
      if (!strip) return;
      const frames = Array.from(strip.querySelectorAll(".frame"));
      const arrows = Array.from(strip.querySelectorAll(".strip-arrow"));
      const dots = Array.from(document.querySelectorAll(".strip-dot"));
      const details = Array.from(document.querySelectorAll("[data-detail]"));
      if (!frames.length) return;

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let i = 0;
      let timer = null;
      let paused = false;

      function paint(idx) {
        frames.forEach((f, n) => f.classList.toggle("active", n === idx));
        arrows.forEach((a, n) => a.classList.toggle("lit", n === idx));
        dots.forEach((d, n) => d.classList.toggle("active", n === idx));
        details.forEach((d, n) => d.classList.toggle("is-active", n === idx));
      }

      function tick() {
        if (paused) return;
        i = (i + 1) % frames.length;
        paint(i);
      }

      // Initial paint
      paint(0);
      dots[0] && dots[0].classList.add("active");

      if (!reduced) {
        timer = setInterval(tick, 3500);
        strip.addEventListener("mouseenter", () => { paused = true; });
        strip.addEventListener("mouseleave", () => { paused = false; });
      }

      // Click a frame to jump
      frames.forEach((f) => {
        f.addEventListener("click", () => {
          const n = parseInt(f.dataset.frame, 10);
          if (!Number.isNaN(n)) {
            i = n;
            paint(i);
          }
        });
        f.style.cursor = "pointer";
      });

      // Pause when off-screen (saves CPU)
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          paused = !e.isIntersecting;
        }
      }, { threshold: 0.1 });
      io.observe(strip);
    })();
  </script>
</Layout>
