---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  tone?: "default" | "soft" | "warm" | "ink";
}

const { id, eyebrow, title, lede, tone = "default" } = Astro.props;

const toneClass = {
  default: "",
  soft: "bg-[var(--color-paper-soft)]",
  warm: "bg-[var(--color-paper-warm)]",
  ink: "bg-[var(--color-ink)] text-[var(--color-paper)]",
}[tone];

const ledeClass =
  tone === "ink"
    ? "text-[var(--color-paper-soft)]"
    : "text-[var(--color-ink-soft)]";
---

<section
  id={id}
  class={`py-14 sm:py-20 scroll-mt-20 ${toneClass}`}
>
  <div class="max-w-6xl mx-auto px-6 w-full">
    {
      eyebrow && (
        <div
          data-reveal="fade-up"
          class="text-sm sm:text-base uppercase tracking-[0.18em] font-bold mb-4 text-[var(--color-accent)]"
        >
          {eyebrow}
        </div>
      )
    }
    <h2
      data-reveal="fade-up"
      data-reveal-delay="1"
      class="font-display text-[2rem] sm:text-4xl md:text-5xl mb-5 max-w-5xl leading-[1.08] break-words"
    >
      {title}
    </h2>
    {
      lede && (
        <p
          data-reveal="fade-up"
          data-reveal-delay="2"
          class={`text-lg sm:text-xl max-w-4xl leading-relaxed mb-10 ${ledeClass}`}
          set:html={lede}
        />
      )
    }
    <div>
      <slot />
    </div>
  </div>
</section>
