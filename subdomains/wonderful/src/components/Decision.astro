---
import { Check, AlertTriangle, X } from "@lucide/astro";

interface Props {
  number: number;
  title: string;
  description?: string;
  /** "core" = default decision; "gap" shows an accent dot to distinguish a subgroup. */
  group?: "core" | "gap";
  /** Customize the chip labels if you want something other than the default ratification chips. */
  chips?: { onBoard?: string; concern?: string; object?: string };
  /** Footer note. Defaults to "default = ship". Set to null to hide. */
  footerNote?: string | null;
}

const {
  number,
  title,
  description,
  group = "core",
  chips = {},
  footerNote = "default = ship",
} = Astro.props;

const onBoard = chips.onBoard ?? "On board";
const concern = chips.concern ?? "Concern";
const object = chips.object ?? "Object";
---

<div class="flex gap-4 py-5 border-b border-[var(--color-line-soft)] last:border-b-0 group">
  <div class="shrink-0 flex flex-col items-center pt-0.5">
    <span class="font-mono text-[11px] text-[var(--color-ink-faint)] mb-1.5">
      {String(number).padStart(2, "0")}
    </span>
    {
      group === "gap" && (
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" />
      )
    }
  </div>

  <div class="flex-1 min-w-0">
    <div class="font-medium text-[var(--color-ink)] mb-1 leading-snug">
      {title}
    </div>
    {
      description && (
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed mb-2.5">
          {description}
        </p>
      )
    }
    <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--color-ink-soft)]">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[var(--color-success-soft)] text-[var(--color-success)] font-medium">
        <Check class="w-3 h-3" />
        {onBoard}
      </span>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[var(--color-warning-soft)] text-[var(--color-warning)] font-medium">
        <AlertTriangle class="w-3 h-3" />
        {concern}
      </span>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[var(--color-danger-soft)] text-[var(--color-danger)] font-medium">
        <X class="w-3 h-3" />
        {object}
      </span>
      {footerNote && <span class="italic">{footerNote}</span>}
    </div>
  </div>
</div>
