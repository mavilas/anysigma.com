---
interface Item {
  number: string;
  title: string;
  href: string;
}

interface Props {
  items?: Item[];
}

const defaultItems: Item[] = [
  { number: "01", title: "Why Japan moves now", href: "#shift" },
  { number: "02", title: "Who wins, who loses", href: "#winners-losers" },
  { number: "03", title: "12-month position", href: "#promised-land" },
  { number: "04", title: "Platform + execution", href: "#magic-gifts" },
  { number: "05", title: "Evidence", href: "#evidence" },
  { number: "06", title: "The plan", href: "#plan" },
  { number: "07", title: "Open questions", href: "#open-questions" },
  { number: "·", title: "Closing", href: "#closing" },
  { number: "·", title: "References", href: "#references" },
];

const { items = defaultItems } = Astro.props;

if (items.length === 0) {
  // Caller opted out — render nothing
}
---

{items.length > 0 && (

<aside
  id="toc"
  class="hidden xl:block fixed left-6 top-24 w-48 z-10"
  aria-label="Table of contents"
>
  <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-faint)] font-semibold mb-3 pl-2">
    On this page
  </div>
  <nav class="space-y-0.5">
    {
      items.map((item) => (
        <a
          href={item.href}
          data-toc-link
          data-toc-target={item.href.slice(1)}
          class="toc-link flex items-baseline gap-2 px-2 py-1 rounded-md text-xs text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] hover:bg-[var(--color-paper-soft)] transition-colors"
        >
          <span class="font-mono text-[9px] text-[var(--color-ink-faint)] w-5 shrink-0">{item.number}</span>
          <span class="truncate">{item.title}</span>
        </a>
      ))
    }
  </nav>
</aside>

)}

<script is:inline>
  (function () {
    const links = document.querySelectorAll("[data-toc-link]");
    if (!links.length || !("IntersectionObserver" in window)) return;

    const linkByTarget = new Map();
    links.forEach((l) => linkByTarget.set(l.dataset.tocTarget, l));

    const activate = (id) => {
      links.forEach((l) => {
        const active = l.dataset.tocTarget === id;
        l.classList.toggle("bg-[var(--color-accent-soft)]", active);
        l.classList.toggle("text-[var(--color-accent-ink)]", active);
        l.classList.toggle("font-semibold", active);
      });
    };

    const sections = Array.from(linkByTarget.keys())
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    if (!sections.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) activate(visible[0].target.id);
      },
      { rootMargin: "-30% 0px -55% 0px", threshold: 0 }
    );

    sections.forEach((s) => io.observe(s));
  })();
</script>
