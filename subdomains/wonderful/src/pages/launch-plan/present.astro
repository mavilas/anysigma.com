      .reveal .card.mini .num { font-size: 36px; }
      .reveal .card h3 { margin-bottom: 8px; }
      .reveal .card p { font-size: 17px; color: var(--ink-body); margin-bottom: 8px; line-height: 1.4; }

      /* === 3x2 grid (§02) === */
      .reveal .grid-3x2 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        flex: 1;
      }
      .reveal .tile {
        border: 2px solid var(--line);
        border-radius: 12px;
        padding: 14px 16px;
        background: var(--paper);
        display: flex;
        flex-direction: column;
      }
      .reveal .tile .num {
        font-family: "Bree Serif", serif;
        font-size: 40px;
        line-height: 1;
        color: var(--highlight);
        letter-spacing: -0.02em;
      }
      .reveal .tile-label {
        font-family: "JetBrains Mono", monospace;
        font-size: 16px;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-weight: 700;
        color: var(--accent);
        margin-top: 6px;
      }
      .reveal .tile p { font-size: 17px; color: var(--ink-body); margin-top: 4px; line-height: 1.4; }

      /* === Demographic chart (§03) === */
      .reveal .demo-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-top: 6px;
      }
      .reveal .demo-head {
        display: flex; justify-content: space-between; align-items: baseline;
        margin-bottom: 6px;
      }
      .reveal .demo-year {
        font-family: "Bree Serif", serif; font-size: 22px; color: var(--ink); font-weight: 700;
      }
      .reveal .demo-total {
        font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--ink-faint);
      }
      .reveal .demo-bar {
        display: flex; flex-direction: column;
        height: 220px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--line);
      }
      .reveal .demo-band {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        background: var(--paper-soft); color: var(--ink-body);
        text-align: center;
      }
      .reveal .demo-band.hl-band { background: var(--accent); color: white; }
      .reveal .demo-band.elderly { background: var(--ink-soft); color: white; }
      .reveal .demo-val {
        font-family: "Bree Serif", serif; font-size: 19px; font-weight: 700; line-height: 1;
      }
      .reveal .demo-band-label {
        font-size: 11px; line-height: 1.2; margin-top: 4px; opacity: 0.9;
      }

      /* Source line: natural flow, pinned bottom via margin-top:auto.
         Small, muted, right-aligned so it never competes with content. */
      .reveal p.source {
        flex: 0 0 auto;
        margin-top: 12px;
        margin-bottom: 0;
        padding-top: 8px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        font-style: italic;
        color: var(--ink-faint);
        text-align: right;
        opacity: 0.6;
        line-height: 1.35;
        letter-spacing: 0.02em;
      }
      .reveal p.source a {
        color: var(--ink-faint);
        text-decoration: none;
        border-bottom: none;
        transition: color 0.15s ease, opacity 0.15s ease;
      }
      .reveal p.source a:hover { opacity: 1; color: var(--accent); }
      /* On dark/ink slides, lighten the source so it stays visible */
      .reveal section[data-state="ink"] p.source { color: rgba(255,255,255,0.5); }
      .reveal section[data-state="ink"] p.source a { color: rgba(255,255,255,0.5); }

      /* === Sources grid (§Verification) === */
      .reveal .sources-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
        flex: 1 1 0; min-height: 0;
      }
      .reveal .source-block {
        border: 2px solid var(--line); border-radius: 12px;
        padding: 18px 22px;
        background: var(--paper);
        display: flex; flex-direction: column; gap: 8px;
        position: relative; overflow: hidden;
      }
      .reveal .source-block::after {
        content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
        background: linear-gradient(90deg, var(--accent), var(--highlight)); opacity: 0.55;
      }
      .reveal .source-block ul { margin: 0; padding: 0; }
      .reveal .source-block li { font-size: 14px; line-height: 1.42; }
      .reveal .source-block li a { color: var(--accent); }
      .reveal .source-block code {
        font-family: "JetBrains Mono", monospace;
        background: var(--accent-soft); color: var(--accent);
        padding: 2px 7px; border-radius: 4px; font-size: 14px;
      }

      /* === End slide === */
      .reveal .end-card { justify-content: center; align-items: flex-start; gap: 14px; }
      .reveal .end-eyebrow {
        font-family: "JetBrains Mono", monospace; font-size: 16px;
        text-transform: uppercase; letter-spacing: 0.16em; color: var(--accent);
        font-weight: 700;
      }
      .reveal .last-synced {
        font-family: "JetBrains Mono", monospace; font-size: 16px; color: var(--ink-soft);
      }
      .reveal code {
        font-family: "JetBrains Mono", monospace;
        background: var(--accent-soft);
        color: var(--accent);
        padding: 2px 7px;
        border-radius: 4px;
        font-size: 0.92em;
      }
      .reveal .reader-link a {
        font-family: "JetBrains Mono", monospace; font-size: 16px;
      }

      /* === Card details === */
      .reveal .card-detail {
        font-size: 16px; color: var(--ink-soft); font-style: italic;
        border-top: 1px solid var(--line); padding-top: 10px;
        margin-top: auto !important;
      }
      .reveal .card-stat {
        font-family: "JetBrains Mono", monospace;
        font-size: 16px;
        color: var(--ink-soft);
        font-weight: 700;
        background: var(--accent-soft);
        border-radius: 6px;
        padding: 8px 12px;
        margin-top: 8px;
      }
      .reveal .card-stat .hl {
        font-family: "Bree Serif", serif;
        font-size: 22px;
        color: var(--highlight);
        margin-right: 6px;
        letter-spacing: -0.02em;
      }
      /* PoC card (§11) — header row + key-value pairs */
      .reveal .poc-card { padding: 24px 28px 28px !important; gap: 14px !important; }
      .reveal .poc-head {
        display: flex; align-items: baseline; gap: 14px;
        border-bottom: 2px solid var(--line); padding-bottom: 12px;
      }
      .reveal .poc-num {
        font-family: "Bree Serif", serif;
        font-size: 44px; color: var(--highlight);
        line-height: 1; letter-spacing: -0.02em;
      }
      .reveal .poc-kv { display: flex; flex-direction: column; gap: 4px; }
      .reveal .poc-val { font-size: 17px; color: var(--ink); line-height: 1.4; }
      .reveal hr {
        border: 0; border-top: 1px solid var(--line); margin: 8px 0;
      }

      /* === Two-column layout (chart + side, pyramid + donut) === */
      .reveal .two-col {
        display: grid; grid-template-columns: 1.2fr 1fr; gap: 18px; flex: 1; min-height: 0;
      }
      .reveal .two-col.arch { grid-template-columns: 1.1fr 1fr; }

      /* === Chart card (§05) === */
      .reveal .chart-card {
        border: 2px solid var(--line); border-radius: 12px;
        padding: 18px 22px; background: var(--paper);
        display: flex; flex-direction: column; gap: 10px;
      }
      .reveal .rank-row { display: flex; align-items: baseline; gap: 10px; }
      .reveal .rank {
        font-family: "Bree Serif", serif; font-size: 56px; line-height: 1;
        color: var(--highlight); letter-spacing: -0.02em;
      }
      .reveal .rank-label { font-size: 16px; color: var(--ink-soft); }
      .reveal .chart-title {
        font-family: "JetBrains Mono", monospace; font-size: 11px;
        text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-faint);
        font-weight: 700; margin-top: 6px;
      }
      .reveal .bars { display: flex; flex-direction: column; gap: 6px; }
      .reveal .bar-row {
        display: grid; grid-template-columns: 60px 1fr 160px;
        align-items: center; gap: 12px; font-size: 17px;
      }
      .reveal .bar-year { font-family: "JetBrains Mono", monospace; color: var(--ink-soft); font-size: 17px; font-weight: 700; }
      .reveal .bar-track { background: var(--paper-soft); border-radius: 4px; height: 22px; overflow: hidden; }
      .reveal .bar-fill {
        height: 100%; background: linear-gradient(90deg, var(--accent-soft), var(--accent));
        border-radius: 4px;
      }
      .reveal .bar-value {
        font-family: "JetBrains Mono", monospace; font-weight: 700; color: var(--ink);
        text-align: right; font-size: 17px;
      }
      .reveal .bar-usd { color: var(--ink-soft); font-weight: 400; font-size: 16px; }
      .reveal .side-stack { display: flex; flex-direction: column; gap: 14px; }
      .reveal .side-stack .card .num { font-size: 52px; margin-bottom: 6px; }
      .reveal .side-stack .card p { font-size: 16px; }

      /* §05 Why Japan grid — chart (60%) + stacked 2-stat column (40%), strictly 2-row */
      .reveal .japan-grid {
        display: grid; grid-template-columns: 1.4fr 1fr;
        gap: 16px; flex: 1 1 0; min-height: 0;
      }
      .reveal .japan-stack {
        display: grid; grid-template-rows: 1fr 1fr; gap: 14px; min-height: 0;
      }
      .reveal .japan-stat { padding: 22px 24px !important; min-height: 0 !important; }
      .reveal .japan-stat .num { font-size: 56px; line-height: 1; margin-bottom: 8px; }
      .reveal .japan-stat p { font-size: 18px; line-height: 1.36; }

      /* === Comparison table (§06 Competitors, §14 Risks) === */
      .reveal .comp-table {
        display: flex; flex-direction: column; flex: 1; min-height: 0;
        border: 2px solid var(--line); border-radius: 12px; overflow: hidden;
        background: var(--paper);
      }
      .reveal .comp-head {
        display: grid; grid-template-columns: 220px 1fr 1fr;
        background: var(--ink); color: white;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700;
      }
      .reveal .comp-head > div { padding: 12px 18px; border-right: 1px solid rgba(255,255,255,0.15); font-size: 16px; }
      .reveal .comp-head > div:last-child { border-right: 0; }
      .reveal .comp-row {
        display: grid; grid-template-columns: 240px 1fr 1fr;
        border-top: 1px solid var(--line); flex: 1; min-height: 0;
      }
      .reveal .comp-row > div { padding: 14px 18px; font-size: 17px; line-height: 1.42; }
      .reveal .comp-name {
        font-family: "Bree Serif", serif; font-size: 19px; color: var(--ink); font-weight: 700;
      }
      .reveal .comp-them { color: var(--ink-body); border-left: 1px solid var(--line); border-right: 1px solid var(--line); }
      .reveal .comp-us { background: var(--highlight-soft); color: var(--ink); font-weight: 600; }

      /* === Gantt timeline (§08) === */
      .reveal .gantt { display: flex; flex-direction: column; gap: 8px; flex: 1; min-height: 0; }
      .reveal .gantt-ruler {
        display: grid; grid-template-columns: repeat(12, 1fr);
        font-family: "JetBrains Mono", monospace; font-size: 16px; color: var(--ink-soft);
        letter-spacing: 0.1em; font-weight: 700;
      }
      .reveal .gantt-ruler > div { padding: 4px 8px; border-left: 1px solid var(--line); }
      .reveal .gantt-panel {
        border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px;
        background: var(--paper-soft);
      }
      .reveal .gantt-panel.hl-panel { background: var(--highlight-soft); border-color: var(--highlight); }
      .reveal .gantt-panel-label {
        font-family: "JetBrains Mono", monospace; font-size: 16px;
        text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-soft);
        font-weight: 700; margin-bottom: 8px;
      }
      .reveal .gantt-panel-label.hl { color: var(--highlight); }
      .reveal .gantt-row {
        display: grid; grid-template-columns: repeat(13, 1fr); gap: 4px;
        margin-bottom: 6px;
      }
      .reveal .gantt-task {
        font-family: "JetBrains Mono", monospace; font-size: 16px; font-weight: 700;
        padding: 6px 10px; border-radius: 4px; white-space: nowrap; overflow: hidden;
        text-overflow: ellipsis;
      }

      /* === Pyramid + donut (§09) === */
      .reveal .arch-pyramid svg { width: 100%; height: 100%; max-height: 320px; display: block; }
      .reveal .arch-donut {
        display: flex; flex-direction: column; justify-content: center; gap: 10px;
      }
      .reveal .donut-row { display: grid; grid-template-columns: 220px 1fr; gap: 20px; align-items: center; }
      .reveal .donut-svg { width: 100%; height: auto; max-width: 220px; }
      .reveal .donut-legend { display: flex; flex-direction: column; gap: 10px; padding: 0; list-style: none; }
      .reveal .donut-legend li { display: flex; align-items: flex-start; gap: 12px; font-size: 17px; line-height: 1.35; }
      .reveal .donut-legend li::before { content: ""; }
      .reveal .swatch { display: inline-block; width: 16px; height: 16px; border-radius: 3px; flex-shrink: 0; margin-top: 3px; }
      .reveal .legend-co { color: var(--ink-soft); font-size: 17px; display: block; margin-top: 2px; }

      /* === Funnel (§10) === */
      .reveal .funnel { display: flex; flex-direction: column; gap: 10px; flex: 1; min-height: 0; padding: 12px 0; }
      .reveal .funnel-row { display: flex; align-items: center; gap: 14px; }
      .reveal .funnel-band {
        padding: 14px 20px; border-radius: 8px;
        display: flex; align-items: center; gap: 16px;
        transition: all .3s ease;
      }
      .reveal .funnel-count {
        font-family: "Bree Serif", serif; font-size: 42px; font-weight: 700; line-height: 1;
      }
      .reveal .funnel-label { font-size: 16px; line-height: 1.35; max-width: 420px; }
      .reveal .funnel-pct {
        font-family: "JetBrains Mono", monospace; font-size: 16px;
        text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-soft);
        font-weight: 700; white-space: nowrap;
      }

      /* === Two-card layout (§11 PoC Tracks) === */
      .reveal .cards-2 {
        display: grid; grid-template-columns: 1fr 1fr; gap: 18px; flex: 1; min-height: 0;
      }

      /* === Sprint grid (§12) === */
      .reveal .sprint-grid {
        display: flex; flex-direction: column; gap: 4px; flex: 1; min-height: 0;
        border: 2px solid var(--line); border-radius: 12px; overflow: hidden;
      }
      .reveal .sprint-head {
        display: grid; grid-template-columns: 200px 1fr 1fr 1fr 200px;
        background: var(--ink); color: white;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700;
      }
      .reveal .sprint-head > div { padding: 12px 16px; border-right: 1px solid rgba(255,255,255,0.15); font-size: 16px; }
      .reveal .sprint-row {
        display: grid; grid-template-columns: 220px 1fr 1fr 1fr 220px;
        background: var(--paper); flex: 1; min-height: 0;
        border-top: 1px solid var(--line);
      }
      .reveal .sprint-row > div { padding: 14px 16px; font-size: 16px; line-height: 1.4; border-right: 1px solid var(--line); }
      .reveal .sprint-row > div:last-child { border-right: 0; }
      .reveal .sprint-track-name {
        background: var(--paper-soft); font-family: "Bree Serif", serif; font-size: 18px;
        font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: 10px;
      }
      .reveal .sprint-dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; }
      .reveal .sprint-milestone {
        background: var(--highlight-soft); color: var(--ink); font-weight: 700;
        font-family: "JetBrains Mono", monospace; font-size: 16px;
      }

      /* === Team grid (§13) === */
      .reveal .team-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 18px; flex: 1; min-height: 0;
      }
      .reveal .team-panel {
        border: 2px solid var(--line); border-radius: 12px; padding: 18px 22px;
        background: var(--paper); display: flex; flex-direction: column; gap: 10px;
      }
      .reveal .role-list { display: flex; flex-direction: column; gap: 10px; }
      .reveal .role-list li {
        padding: 8px 0; border-bottom: 1px solid var(--line); list-style: none; padding-left: 0;
      }
      .reveal .role-list li::before { content: ""; }
      .reveal .role-list li:last-child { border-bottom: 0; }
      .reveal .role-row {
        display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;
      }
      .reveal .role-name {
        font-family: "JetBrains Mono", monospace; font-size: 12px;
        text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); font-weight: 700;
      }
      .reveal .role-person {
        font-family: "Bree Serif", serif; font-size: 17px; color: var(--ink); font-weight: 700;
      }
      .reveal .role-note { font-size: 12px; color: var(--ink-soft); line-height: 1.36; }

      /* === Ink (dark) slide variant (§15 HQ Asks, Closing) === */
      .reveal .slides section[data-state="ink"] {
        background: var(--ink);
        color: var(--paper);
      }
      .reveal .slides section[data-state="ink"] h1,
      .reveal .slides section[data-state="ink"] h2,
      .reveal .slides section[data-state="ink"] h3 { color: var(--paper); }
      .reveal .ink-mode { color: var(--paper) !important; }
      .reveal .eyebrow.ink-mode { color: var(--highlight); }
      .reveal .ink-label { color: var(--highlight) !important; }
      .reveal .ink-card {
        background: rgba(255,255,255,0.04) !important;
        border-color: rgba(255,255,255,0.16) !important;
      }
      .reveal .ask-num {
        font-family: "Bree Serif", serif; font-size: 48px;
        color: var(--highlight); line-height: 1; margin-bottom: 8px;
        letter-spacing: -0.02em;
      }
      .reveal .ink-card p { color: var(--paper); }

      /* === Closing slide (§17) === */
      .reveal .closing-slide { padding: 56px 64px !important; justify-content: space-between !important; }
      .reveal .closing {
        display: flex; flex-direction: column; justify-content: space-between;
        gap: 20px; height: 100%;
      }
      .reveal .closing-statement {
        font-size: 56px; line-height: 1.08; color: var(--paper); font-weight: 400;
        font-family: "Bree Serif", serif; letter-spacing: -0.01em;
        margin-top: 8px;
      }
      .reveal .closing-statement em.hl {
        color: var(--highlight); font-style: italic; font-weight: 700;
      }
      .reveal .closing-sub { font-size: 22px; color: var(--paper); opacity: 0.85; max-width: 1000px; }
      .reveal .closing-stats {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px;
        padding: 24px 0;
        border-top: 1px solid rgba(255,255,255,0.18);
        border-bottom: 1px solid rgba(255,255,255,0.18);
      }
      .reveal .closing-stat .num {
        font-family: "Bree Serif", serif; font-size: 56px; color: var(--highlight);
        line-height: 1; letter-spacing: -0.02em;
      }
      .reveal .closing-stat .label {
        font-family: "JetBrains Mono", monospace; font-size: 13px;
        color: var(--paper); opacity: 0.7;
        text-transform: uppercase; letter-spacing: 0.16em;
        margin-top: 8px; font-weight: 700;
      }
      .reveal .closing-meta {
        font-family: "JetBrains Mono", monospace; font-size: 16px;
        color: var(--paper); opacity: 0.55; margin-top: 8px;
      }

      /* === Hide chrome in print-pdf mode === */
      @media print {
        .reveal .controls, .reveal .progress { display: none !important; }
      }
    </style>
  </body>
</html>
