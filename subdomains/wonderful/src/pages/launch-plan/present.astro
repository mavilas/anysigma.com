---
// Wonderful Japan · Launch Acceleration Plan
// Reveal.js presentation deck. Single source of truth = src/data/launch-plan.ts
//
// Usage:
//   /launch-plan/present           — fullscreen-capable deck
//   /launch-plan/present?print-pdf — Reveal's native PDF export mode
//   Press F for fullscreen, S for speaker notes, ESC for overview.

import {
  execSummary,
  globalProof,
  demographics,
  workingAgeDelta,
  workingAgePctChange,
  macroCatalyst,
  japanMarket,
  competitors,
  pillars,
  industryMix,
  funnel,
  pocTracks,
  sprintTracks,
  coreSquad,
  hiringPhasing,
  risks,
  hqAsks,
  LAST_SYNCED,
} from "../../data/launch-plan";

// Precompute donut segments for §09 (must match the r= used in the SVG circle below)
const DONUT_R = 32;
const DONUT_C = 2 * Math.PI * DONUT_R;
let _o = 0;
const donutSegments = industryMix.map((s) => {
  const dash = (s.pct / 100) * DONUT_C;
  const seg = { ...s, dash, offset: _o };
  _o += dash;
  return seg;
});

const maxChartValue = Math.max(...japanMarket.chart.map((c) => c.value));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wonderful AI · Japan · Launch Acceleration Plan (Deck)</title>
    <meta name="robots" content="noindex" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bree+Serif&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="reveal">
      <div class="slides">
        {/* === Slide 1 · Title === */}
        <section class="slide-title" data-state="ink">
          <div class="eyebrow">Wonderful AI · Japan</div>
          <h1>
            Launch Acceleration <em>Plan.</em>
          </h1>
          <p class="lede">Strategic Blueprint &amp; 90-Day Execution Sprint.</p>
          <div class="stats stats-4">
            <div class="stat"><div class="num">$286M</div><div class="label">Raised cumulative</div><div class="sub">$150M Series B · $2B val</div></div>
            <div class="stat"><div class="num">30+</div><div class="label">Countries live</div><div class="sub">EMEA · APAC · Americas</div></div>
            <div class="stat"><div class="num">80+</div><div class="label">Enterprise customers</div><div class="sub">Telco · BFSI · health · mfg</div></div>
            <div class="stat"><div class="num">$5M ARR</div><div class="label">FY26 Japan target</div><div class="sub">5 wins from 500 mega-cap</div></div>
          </div>
          <div class="footer-meta">
            Satoshi Hosoi · President, Japan · May 2026 · Confidential · for HQ leadership
          </div>
          <aside class="notes">
            Opening slide. Anchor on $286M raised and the 90-day commitment.
            HQ needs to leave this room knowing Japan has a serious plan, not a wish-list.
          </aside>
        </section>

        {/* === Slide 2 · Executive Summary — hero-row + 2-col grid === */}
        <section>
          <div class="eyebrow">01 · Executive summary</div>
          <h2>Three numbers tell the story.</h2>
          <p class="lede">
            <strong>$286M raised globally.</strong> <strong>$1B+ TAM</strong> in Japan.
            <strong class="hl">90 days</strong> to compress the first paid revenue cycle.
          </p>
          {/* Hero numbers row — full width, 3 across */}
          <div class="hero-row">
            {execSummary.map((c) => (
              <div class="hero-tile">
                <div class="num hl">{c.stat}</div>
                <div class="hero-tile-label">{c.label}</div>
              </div>
            ))}
          </div>
          {/* Supporting evidence — 2 column grid full width */}
          <div class="evidence-grid">
            <div class="evidence-card">
              <div class="tile-label">Proven globally</div>
              <h3>$286M raised in 18 months at $2B valuation.</h3>
              <ul>
                <li>$150M Series B (Mar 2026) led by Insight Partners.</li>
                <li>$100M Series A (Nov 2025) led by Index Ventures.</li>
                <li>30+ countries · 80+ enterprise customers · &lt;5% churn.</li>
                <li>Containment rates &gt;80% in production.</li>
              </ul>
            </div>
            <div class="evidence-card">
              <div class="tile-label">Japan is next</div>
              <h3>$1B+ TAM, 500 mega-cap targets, 155 must-win accounts.</h3>
              <ul>
                <li>Working-age population collapses 24% by 2040 (IPSS).</li>
                <li>¥10T public AI commitment to 2030 (METI framework).</li>
                <li>Enterprise pivots from legacy RPA to autonomous agents.</li>
                <li>90-day sprint compresses first paid revenue to 6-8 months.</li>
              </ul>
            </div>
          </div>
          <aside class="notes">
            Three claims, three supports. Every other slide in this deck supports one of these three.
            $286M = credibility. $1B+ = opportunity size. 90 days = how fast we move.
          </aside>
        </section>

        {/* === Slide 3 · Global Momentum === */}
        <section data-state="soft">
          <div class="eyebrow">02 · Global momentum</div>
          <h2>Proof exists. APAC is next.</h2>
          <p class="lede">
            <strong>Six headline numbers</strong> from European deployments. The board has seen these.
            <strong class="hl">Japan is the missing logo.</strong>
          </p>
          <div class="grid-3x2">
            {globalProof.map((p) => (
              <div class="tile">
                <div class="num hl">{p.stat}</div>
                <div class="tile-label">{p.label}</div>
                <p>{p.body}</p>
              </div>
            ))}
          </div>
          <p class="source">
            <a href="https://techcrunch.com/2026/03/12/wonderful-raises-150m-series-b-at-2b-valuation/">TechCrunch · $150M Series B</a> ·
            <a href="https://www.indexventures.com/perspectives/index-ventures-triples-down-as-wonderful-raises-150m-series-b-to-scale-its-hyper-local-enterprise-ai-platform/">Index Ventures</a> ·
            <a href="https://www.prnewswire.com/news-releases/wonderful-raises-150m-series-b-to-accelerate-enterprise-ai-adoption-in-30-markets-302712238.html">PR Newswire · 30+ markets, &gt;80% containment</a>.
          </p>
          <aside class="notes">
            The European deployment numbers are HQ's strongest assets. Lead with $286M raised,
            close with the multi-workflow expansion %. Bezeq is the named telco proof point.
          </aside>
        </section>

        {/* === Slide 4 · Demographic Crisis === */}
        <section>
          <div class="eyebrow">03 · Demographic crisis</div>
          <h2>Demographic demand forces the buy.</h2>
          <p class="lede">
            <strong>Working-age 15-64 collapses {workingAgePctChange}% by 2040.</strong>
            <strong class="hl">Enterprise has no choice but autonomous workflows.</strong>
          </p>
          <div class="demo-row">
            {demographics.map((d) => (
              <div class="demo-col">
                <div class="demo-head">
                  <span class="demo-year">{d.year}</span>
                  <span class="demo-total">{d.total}M total</span>
                </div>
                <div class="demo-bar">
                  {d.bands.map((b) => (
                    <div
                      class={`demo-band ${b.highlight ? "hl-band" : ""} ${b.label === "65 +" ? "elderly" : ""}`}
                      style={`flex:${b.pct}`}
                    >
                      <div class="demo-val">{b.value.toFixed(1)}M</div>
                      <div class="demo-band-label">{b.label}</div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <div class="cards-3 tight">
            <div class="card mini">
              <div class="num hl">-{workingAgeDelta.toFixed(1)}M</div>
              <p>Working-age population (2010 → 2040). Equivalent to losing Italy's workforce.</p>
            </div>
            <div class="card mini">
              <div class="num hl">1.6 : 1</div>
              <p>Workers per elderly by 2040. Down from 3.1:1 in 2010. Headcount-driven CS is over.</p>
            </div>
            <div class="card mini">
              <div class="num hl">35%</div>
              <p>Of Japan over 65 by 2040. The dependency ratio breaks every cost model JP enterprise built in the 90s.</p>
            </div>
          </div>
          <p class="source">
            Source: <a href="https://www.ipss.go.jp/pp-zenkoku/e/zenkoku_e2023/pp2023e_Summary.pdf">IPSS 2023 Population Projection for Japan</a>.
          </p>
          <aside class="notes">
            This is the single most important slide for HQ skeptics. Japan does not have a choice.
            Autonomous workflows are not a preference — they are arithmetic.
          </aside>
        </section>

        {/* === Slide 5 · §04 Macro Catalyst === */}
        <section data-state="warm">
          <div class="eyebrow">04 · Macro catalyst</div>
          <h2>¥10T policy. $5-6B TAM. The shift is funded and forced.</h2>
          <p class="lede">
            <strong>Government injects capital.</strong> Enterprise pivots from legacy RPA to autonomous agents.
            <strong class="hl">Adoption accelerating 30-40% YoY.</strong>
          </p>
          <div class="cards-3">
            <div class="card">
              <div class="tile-label">Driver</div>
              <h3>Demographic crisis</h3>
              <p>Rapidly aging population and shrinking workforce creating unprecedented labor shortages.</p>
              <div class="card-stat"><span class="hl">-19.2M</span> working-age by 2040</div>
              <p class="card-detail"><strong>Headcount-driven CS is no longer viable.</strong></p>
            </div>
            <div class="card">
              <div class="tile-label">Catalyst</div>
              <h3>Government intervention</h3>
              <p>2025 AI Promotion Act and centralised AI Strategy HQ established.</p>
              <div class="card-stat"><span class="hl">¥10T</span> public commitment to 2030</div>
              <p class="card-detail"><strong>¥10T (~$65B) framework. GENIAC funds domestic LLMs.</strong></p>
            </div>
            <div class="card">
              <div class="tile-label">Outcome</div>
              <h3>Enterprise reality</h3>
              <p>Urgent shift from legacy RPA to end-to-end Agentic AI to replace white-collar shortfalls.</p>
              <div class="card-stat"><span class="hl">$5-6B</span> Agentic AI TAM</div>
              <p class="card-detail"><strong>Adoption accelerating at 30-40% YoY.</strong></p>
            </div>
          </div>
          <p class="source">
            <a href="https://www.meti.go.jp/english/policy/index.html">METI AI &amp; Semiconductor Strengthening Framework</a> · 2025 AI Promotion Act.
          </p>
          <aside class="notes">
            ¥10T is the public-support number to 2030; ¥50T combined public + private.
            The 30-40% adoption growth is the enterprise survey signal driving urgency.
          </aside>
        </section>

        {/* === Slide 6 · §05 Why Japan Now === */}
        <section>
          <div class="eyebrow">05 · Why Japan running fast</div>
          <h2>Patience rewarded with scale.</h2>
          <p class="lede">
            Japan is the <strong class="hl">world&apos;s #3 enterprise SaaS market</strong> by spend.
            <strong>Lowest churn, highest ACV per logo</strong> in APAC.
          </p>
          <div class="japan-grid">
            <div class="chart-card">
              <div class="rank-row">
                <div class="rank">{japanMarket.rank}</div>
                <div class="rank-label">{japanMarket.rankLabel}</div>
              </div>
              <div class="chart-title">Japan enterprise AI spend · ¥B</div>
              <div class="bars">
                {japanMarket.chart.map((c) => (
                  <div class="bar-row">
                    <div class="bar-year">{c.year}</div>
                    <div class="bar-track">
                      <div class="bar-fill" style={`width:${(c.value / maxChartValue) * 100}%`} />
                    </div>
                    <div class="bar-value">¥{c.value}B <span class="bar-usd">(~${(c.value / 150).toFixed(1)}B)</span></div>
                  </div>
                ))}
              </div>
              <p class="source">Industry analyst consensus, 2024-2028E. FX assumed ~¥150/$.</p>
            </div>
            <div class="japan-stack">
              {japanMarket.highlights.map((h) => (
                <div class="card japan-stat">
                  <div class="num hl">{h.stat}</div>
                  <p>{h.label}</p>
                </div>
              ))}
            </div>
          </div>
          <p class="source">
            Source: industry analyst consensus 2024-2028E (IDC Japan, Gartner JP). FX ~¥150/$. ACV peer benchmark via SaaSOptics &amp; SaaStr APAC regional reports.
          </p>
          <aside class="notes">
            Lean on the chart trajectory. Japan AI spend is more than 5× over 4 years.
            The 2.4× ACV premium is what justifies the on-ground investment.
          </aside>
        </section>

        {/* === Slide 7 · §06 Competitive Landscape === */}
        <section data-state="soft">
          <div class="eyebrow">06 · Competitive landscape</div>
          <h2>Local incumbents have surface. Wonderful has the moat.</h2>
          <p class="lede">Four named JP competitors. For each: <strong>what they have</strong>, <strong class="hl">where Wonderful wins</strong>.</p>
          <div class="comp-table">
            <div class="comp-head">
              <div>Competitor</div>
              <div>Their position</div>
              <div>Wonderful's edge</div>
            </div>
            {competitors.map((c) => (
              <div class="comp-row">
                <div class="comp-name">{c.name}</div>
                <div class="comp-them">{c.them}</div>
                <div class="comp-us">{c.us}</div>
              </div>
            ))}
          </div>
          <p class="source">
            <a href="https://huggingface.co/Rakuten/RakutenAI-3.0">Rakuten AI 3.0 model card</a> (671B total / 37B active MoE) ·
            <a href="https://global.rakuten.com/corp/news/press/2026/0317_01.html">Rakuten GENIAC press release</a> ·
            NEC cotomi, Fujitsu Kozuchi, Sakana AI: vendor public-disclosure surveys 2026.
          </p>
          <aside class="notes">
            Don't dwell on Rakuten AI 3.0 — point to the production-ROI line. Sakana is the
            wildcard; pre-empt with Keigo-native + consumption model framing.
          </aside>
        </section>

        {/* === Slide 8 · §07 Strategic Pillars === */}
        <section data-state="warm">
          <div class="eyebrow">07 · Strategic pillars</div>
          <h2>Three pillars carry the Japan launch.</h2>
          <p class="lede"><strong>Credibility, commitment, and clearly differentiated value.</strong> Anything less is a <strong class="hl">Western SaaS misfire</strong>.</p>
          <div class="cards-3">
            {pillars.map((p, i) => (
              <div class="card">
                <div class="tile-label">Pillar 0{i + 1}</div>
                <h3>{p.title}</h3>
                <ul>
                  {p.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            ))}
          </div>
          <aside class="notes">
            These are HQ's bar for "we'll do Japan right." Each pillar maps to one section
            of the 90-day sprint.
          </aside>
        </section>

        {/* === Slide 9 · §08 Time to Revenue Gantt === */}
        <section>
          <div class="eyebrow">08 · Time to revenue</div>
          <h2>6-8 months to first paid revenue, not 12-18.</h2>
          <p class="lede">Industry default runs sandbox-to-paid sequentially. Wonderful runs Legal, Talent, Pipeline <strong class="hl">strictly in parallel</strong>.</p>
          <div class="gantt">
            <div class="gantt-ruler">
              {["M1","M2","M3","M4","M5","M6","M7","M8","M9","M10","M11","M12"].map((m) => <div>{m}</div>)}
            </div>
            <div class="gantt-panel">
              <div class="gantt-panel-label">Industry default</div>
              <div class="gantt-row">
                <div class="gantt-task" style="grid-column:1/4; background:var(--ink-soft); color:white;">Legal · entity setup</div>
              </div>
              <div class="gantt-row">
                <div class="gantt-task" style="grid-column:4/7; background:var(--ink-soft); color:white;">Talent · hiring</div>
              </div>
              <div class="gantt-row">
                <div class="gantt-task" style="grid-column:7/12; background:var(--ink-soft); color:white;">Pipeline · sandbox POCs</div>
              </div>
              <div class="gantt-row">
                <div class="gantt-task" style="grid-column:12/14; background:var(--ink-faint); color:white;">First paid</div>
              </div>
            </div>
            <div class="gantt-panel hl-panel">
              <div class="gantt-panel-label hl">Wonderful · strict parallel</div>
              <div class="gantt-row">
                <div class="gantt-task" style="grid-column:1/4; background:var(--accent); color:white;">Legal · KK live by M3</div>
              </div>
              <div class="gantt-row">
                <div class="gantt-task" style="grid-column:1/4; background:#7a5cff; color:white;">Talent · founding 5 by M3</div>
              </div>
              <div class="gantt-row">
                <div class="gantt-task" style="grid-column:1/4; background:#0b8f6b; color:white;">Pipeline · 3 paid PoCs by M3</div>
              </div>
              <div class="gantt-row">
                <div class="gantt-task" style="grid-column:5/8; background:var(--highlight); color:white;">First paid revenue · M6-8</div>
              </div>
            </div>
          </div>
          <aside class="notes">
            The parallel-track move is what makes the 90-day claim credible.
            Reference back to the three tracks called out on slide 1.
          </aside>
        </section>

        {/* === Slide 10 · §09 Architecture (pyramid + donut) === */}
        <section data-state="mist">
          <div class="eyebrow">09 · Where the wins live</div>
          <h2>500 mega-cap targets out of 3.67 million companies.</h2>
          <p class="lede">SMEs are 99.7% of JP companies. Only <strong class="hl">0.01%</strong> are the mega-cap targets that move the needle on $5M ARR.</p>
          <div class="two-col arch">
            <div class="arch-pyramid">
              <svg viewBox="0 0 620 400" preserveAspectRatio="xMidYMid meet">
                <g>
                  <polygon points="240,30 360,30 380,100 220,100" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" />
                  <text x="300" y="62" font-family="Bree Serif, serif" font-size="28" fill="white" text-anchor="middle" font-weight="700">~500</text>
                  <text x="300" y="84" font-family="Bricolage Grotesque, sans-serif" font-size="14" fill="white" text-anchor="middle" font-weight="600">Mega-sized · target</text>
                  <text x="405" y="56" font-family="JetBrains Mono, monospace" font-size="18" fill="var(--ink)" text-anchor="start" font-weight="700">0.01%</text>
                  <text x="405" y="74" font-family="JetBrains Mono, monospace" font-size="14" fill="var(--ink-soft)" text-anchor="start">5,000+ employees</text>
                  <text x="405" y="90" font-family="JetBrains Mono, monospace" font-size="14" fill="var(--ink-soft)" text-anchor="start">Direct sales</text>
                </g>
                <g>
                  <polygon points="210,115 390,115 425,205 175,205" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
                  <text x="300" y="152" font-family="Bree Serif, serif" font-size="30" fill="var(--ink)" text-anchor="middle" font-weight="700">~11,000</text>
                  <text x="300" y="178" font-family="Bricolage Grotesque, sans-serif" font-size="16" fill="var(--ink)" text-anchor="middle" font-weight="600">Large companies</text>
                  <text x="440" y="148" font-family="JetBrains Mono, monospace" font-size="18" fill="var(--ink-soft)" text-anchor="start" font-weight="700">0.3%</text>
                  <text x="440" y="168" font-family="JetBrains Mono, monospace" font-size="14" fill="var(--ink-soft)" text-anchor="start">Partner-led</text>
                </g>
                <g>
                  <polygon points="175,215 425,215 470,365 130,365" fill="var(--paper-soft)" stroke="var(--line)" stroke-width="1" />
                  <text x="300" y="268" font-family="Bree Serif, serif" font-size="32" fill="var(--ink-soft)" text-anchor="middle" font-weight="700">~3.66M</text>
                  <text x="300" y="298" font-family="Bricolage Grotesque, sans-serif" font-size="16" fill="var(--ink-soft)" text-anchor="middle" font-weight="600">SMEs &amp; small businesses</text>
                  <text x="300" y="328" font-family="JetBrains Mono, monospace" font-size="14" fill="var(--ink-faint)" text-anchor="middle" font-style="italic">Non-target</text>
                  <text x="485" y="268" font-family="JetBrains Mono, monospace" font-size="18" fill="var(--ink-faint)" text-anchor="start" font-weight="700">99.7%</text>
                </g>
                <g font-family="JetBrains Mono, monospace" font-size="14" fill="var(--ink-soft)">
                  <text x="120" y="60" text-anchor="end" font-weight="700">Must-Win</text>
                  <text x="120" y="78" text-anchor="end" font-weight="700">155+</text>
                  <line x1="130" y1="60" x2="220" y2="60" stroke="var(--ink-soft)" stroke-width="1" />
                  <text x="120" y="150" text-anchor="end" font-weight="700">SI partners</text>
                  <text x="120" y="168" text-anchor="end">NTT · Hitachi</text>
                  <text x="120" y="184" text-anchor="end">Fujitsu · NEC</text>
                  <line x1="130" y1="150" x2="175" y2="150" stroke="var(--ink-soft)" stroke-width="1" />
                </g>
              </svg>
            </div>
            <div class="arch-donut">
              <div class="tile-label">Mega-cap industry mix</div>
              <div class="donut-row">
                <svg viewBox="0 0 100 100" class="donut-svg">
                  <circle cx="50" cy="50" r="40" fill="var(--paper-soft)" />
                  {donutSegments.map((s) => (
                    <circle cx="50" cy="50" r="30" fill="none" stroke={s.color} stroke-width="20" stroke-dasharray={`${s.dash} ${DONUT_C}`} stroke-dashoffset={-s.offset} transform="rotate(-90 50 50)" />
                  ))}
                  <circle cx="50" cy="50" r="15" fill="var(--paper)" />
                  <text x="50" y="49" font-family="Bree Serif, serif" font-size="20" font-weight="700" text-anchor="middle" fill="var(--ink)">500</text>
                  <text x="50" y="62" font-family="JetBrains Mono, monospace" font-size="7" text-anchor="middle" fill="var(--ink-soft)">mega-cap</text>
                </svg>
                <ul class="donut-legend">
                  {industryMix.map((s) => (
                    <li>
                      <span class="swatch" style={`background:${s.color}`}></span>
                      <span><strong>{s.pct}%</strong> {s.label}{s.co && <span class="legend-co"> · {s.co}</span>}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
          <p class="source">
            <a href="https://www.meti.go.jp/english/press/2024/0329_001.html">METI 2023 Basic Survey on SMEs</a> ·
            <a href="https://www.chusho.meti.go.jp/sme_english/">SME Agency (99.7%)</a>.
          </p>
          <aside class="notes">
            Hammer the 0.01% number. Wonderful is not playing in SMB. Direct sales motion
            on 500, partner-led on 11,000, ignore the 3.66M.
          </aside>
        </section>

        {/* === Slide 11 · §10 Pipeline Funnel === */}
        <section data-state="soft">
          <div class="eyebrow">10 · Pipeline funnel</div>
          <h2>500 → 5. The funnel that compresses to $5M ARR.</h2>
          <p class="lede">Four-tier funnel from the 500 mega-cap universe to <strong class="hl">5 FY26 wins for $5M ARR</strong>.</p>
          <div class="funnel">
            {funnel.map((f, i) => {
              const widths = ["100%", "62%", "32%", "12%"];
              const colors = ["var(--accent-soft)", "var(--accent)", "var(--highlight)", "var(--ink)"];
              const textColors = ["var(--ink)", "white", "white", "white"];
              return (
