            <div class="h-2 rounded-full bg-gradient-to-r from-[var(--color-ink)] via-[var(--color-accent)] to-[var(--color-accent-soft)]" style={`opacity: ${0.55 + i * 0.15};`}></div>
            <div class="text-[18px] uppercase tracking-[0.16em] font-mono font-bold text-[var(--color-ink)] mt-3">{label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Three parallel tracks, color-coded · bolder presentation styling -->
    <div class="max-w-6xl space-y-5">
      {sprintTracks.map((t, i) => {
        const IconC = Icon(t.icon);
        return (
          <div class="rounded-xl border-2 border-[var(--color-line)] bg-[var(--color-paper)] overflow-hidden print:break-inside-avoid shadow-sm" style={`border-left: 6px solid ${t.accent};`} data-reveal="fade-up" data-reveal-delay={i}>
            <div class="grid md:grid-cols-[12rem_1fr_1fr_1fr] gap-0">
              <!-- Track label, color-coded · bigger labels -->
              <div class="p-5 flex flex-col justify-center gap-2 border-b md:border-b-0 md:border-r border-[var(--color-line)]" style={`background: ${t.accent}18;`}>
                <div class="flex items-center gap-2">
                  {IconC && <IconC class="w-6 h-6" style={`color: ${t.accent};`} />}
                  <span class="text-[14px] uppercase tracking-[0.16em] font-mono font-bold" style={`color: ${t.accent};`}>Track 0{i + 1}</span>
                </div>
                <span class="font-display text-2xl leading-tight">{t.track}</span>
                <div class="flex items-center gap-1.5 mt-2 pt-2 border-t" style={`border-color: ${t.accent}33;`}>
                  <Trophy class="w-4 h-4" style={`color: ${t.accent};`} />
                  <span class="text-[14px] font-mono font-bold leading-tight" style={`color: ${t.accent};`}>{t.milestone}</span>
                </div>
              </div>
              <!-- Three time windows with accent stripe on top -->
              {[t.d1_30, t.d30_60, t.d60_90].map((d, ci) => (
                <div class="relative p-5 text-[16px] leading-relaxed border-t md:border-t-0 md:border-l border-[var(--color-line)] text-[var(--color-ink)]">
                  <div class="absolute top-0 left-5 right-5 h-1.5 rounded-b" style={`background: ${t.accent}; opacity: ${0.4 + ci * 0.25};`}></div>
                  <div class="pt-3">{d}</div>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Parallel-execution callout -->
    <div class="mt-8 max-w-4xl rounded-lg border-l-4 border-[var(--color-accent)] bg-[var(--color-accent-soft)]/30 p-5">
      <div class="flex items-start gap-3">
        <Zap class="w-5 h-5 text-[var(--color-accent)] shrink-0 mt-1" />
        <div>
          <h4 class="font-display text-lg leading-tight mb-1">Three tracks. Strict parallel. Zero sequential blockers.</h4>
          <p class="text-[15px] text-[var(--color-ink)] leading-relaxed">Target KK live date: <strong>September 1, 2026</strong>. First paid revenue 6 to 8 months from kickoff, not 12.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- ============================================================ -->
  <!-- §10 · LAUNCH TEAM + HIRING ROADMAP                            -->
  <!-- ============================================================ -->
  <Section
    id="team"
    eyebrow="10 · Launch team"
    title="The Core Squad. The 2026 hiring wave."
    lede="Four roles seated or filling now. Four quarterly hiring waves shaping the rest of the year."
    tone="soft"
  >
    <div class="grid lg:grid-cols-2 gap-6 max-w-6xl">
      <!-- Core Squad -->
      <div class="rounded-xl border-2 border-[var(--color-accent)] bg-[var(--color-paper)] p-6 print:break-inside-avoid">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-[var(--color-line)]">
          <Crown class="w-5 h-5 text-[var(--color-accent)]" />
          <h3 class="font-display text-xl">The Core Squad</h3>
        </div>
        <dl class="space-y-4">
          {coreSquad.map((m) => (
            <div class="grid grid-cols-[1fr_1fr] gap-3 items-start">
              <div>
                <div class="text-[16px] uppercase tracking-[0.12em] font-mono font-bold text-[var(--color-ink-faint)] mb-1">{m.role}</div>
                <div class="font-display text-base text-[var(--color-ink)]">{m.name}</div>
              </div>
              <p class="text-[16px] text-[var(--color-ink-soft)] leading-snug pt-3">{m.note}</p>
            </div>
          ))}
        </dl>
      </div>

      <!-- Q1-Q4 phasing -->
      <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] p-6 print:break-inside-avoid">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-[var(--color-line)]">
          <Calendar class="w-5 h-5 text-[var(--color-accent)]" />
          <h3 class="font-display text-xl">2026 hiring phasing</h3>
        </div>
        <div class="space-y-3">
          {hiringPhasing.map((p) => (
            <div class="flex gap-3">
              <span class="font-mono text-[16px] font-bold text-[var(--color-accent)] w-8 shrink-0">{p.q}</span>
              <div>
                <div class="font-display text-base text-[var(--color-ink)] mb-0.5">{p.focus}</div>
                <p class="text-[16px] text-[var(--color-ink-soft)] leading-snug">{p.goal}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- ============================================================ -->
  <!-- §11 · RISKS                                                   -->
  <!-- ============================================================ -->
  <Section
    id="risks"
    eyebrow="11 · Risks & mitigations"
    title="Three systemic risks. Engineered mitigations."
    lede='Talent. Procurement. Language. <strong>The three places a foreign-vendor Japan landing fails.</strong> Each one has a specific structural mitigation.'
  >
    <div class="max-w-6xl rounded-xl border border-[var(--color-line)] bg-[var(--color-paper)] overflow-hidden print:break-inside-avoid">
      <!-- Single header row -->
      <div class="hidden md:grid md:grid-cols-[14rem_1fr_1fr] gap-0 bg-[var(--color-ink)] text-[var(--color-paper)] text-sm uppercase tracking-[0.16em] font-mono font-bold">
        <div class="p-4">Systemic risk</div>
        <div class="p-4 border-l border-[var(--color-paper)]/20">The risk</div>
        <div class="p-4 border-l border-[var(--color-paper)]/20 bg-[var(--color-accent)] text-[var(--color-paper)]">Structural mitigation</div>
      </div>
      <!-- Rows -->
      {risks.map((r, i) => {
        const IconC = Icon(r.icon);
        return (
          <div class="grid md:grid-cols-[14rem_1fr_1fr] gap-0 border-t border-[var(--color-line)] print:break-inside-avoid" data-reveal="fade-up" data-reveal-delay={i % 3}>
            <div class="p-5 md:p-4 flex md:items-center gap-3 md:border-r border-[var(--color-line)] bg-[var(--color-paper-soft)]/40">
              {IconC && <IconC class="w-5 h-5 text-[var(--color-accent)] shrink-0" />}
              <h3 class="font-display text-xl leading-tight text-[var(--color-ink)]">{r.risk}</h3>
            </div>
            <div class="p-5 md:p-4 border-t md:border-t-0 md:border-l border-[var(--color-line)]">
              <p class="text-base text-[var(--color-ink-soft)] leading-relaxed">{r.framing}</p>
            </div>
            <div class="p-5 md:p-4 border-t md:border-t-0 md:border-l-2 border-[var(--color-accent)] bg-[var(--color-accent-soft)]/30">
              <p class="text-base text-[var(--color-ink)] leading-relaxed font-medium">{r.mitigation}</p>
            </div>
          </div>
        );
      })}
    </div>
  </Section>

  <!-- ============================================================ -->
  <!-- §12 · HQ ASKS                                                 -->
  <!-- ============================================================ -->
  <Section
    id="asks"
    eyebrow="12 · Where HQ unlocks Japan velocity"
    title="Three asks of HQ. Each unlocks the next."
    lede='The plan works only if HQ moves at the speed Japan requires. <strong class="text-[var(--color-accent)]">Three specific commitments unlock the rest.</strong>'
    tone="ink"
  >
    <div class="grid lg:grid-cols-3 gap-5 max-w-6xl">
      {hqAsks.map((a, i) => (
        <div class="rounded-xl border-2 border-[var(--color-accent)] bg-[var(--color-paper)] text-[var(--color-ink)] p-6 print:break-inside-avoid" data-reveal="fade-up" data-reveal-delay={i}>
          <div class="font-display text-[3.5rem] leading-none text-[var(--color-accent)] mb-3 tracking-tight">{a.num}</div>
          <h3 class="font-display text-xl mb-3 leading-tight">{a.title}</h3>
          <div class="mb-3">
            <div class="text-[16px] uppercase tracking-[0.12em] font-mono font-bold text-[var(--color-accent)] mb-1">Ask</div>
            <p class="text-[15px] leading-relaxed">{a.ask}</p>
          </div>
          <div class="pt-3 border-t border-[var(--color-line)]">
            <div class="text-[16px] uppercase tracking-[0.12em] font-mono font-bold text-[var(--color-ink-faint)] mb-1">Impact</div>
            <p class="text-[15px] leading-relaxed text-[var(--color-ink-soft)]">{a.impact}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- ============================================================ -->
  <!-- CLOSING                                                       -->
  <!-- ============================================================ -->
  <section class="py-20 sm:py-28 bg-[var(--color-ink)] text-[var(--color-paper)]">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-[2rem] sm:text-[3rem] md:text-[4rem] leading-[1.05] tracking-tight mb-5 break-words" data-reveal="fade-up">
        Move at startup speed in a market that <span class="text-[var(--color-accent)] italic">rewards staying power.</span>
      </h2>
      <p class="font-display text-xl sm:text-2xl text-[var(--color-paper-soft)] italic mb-3" data-reveal="fade-up" data-reveal-delay="1">
        Win logos in 90 days. Keep them for a decade.
      </p>
      <p class="text-sm text-[var(--color-paper-soft)] max-w-2xl mx-auto" data-reveal="fade-up" data-reveal-delay="2">
        Build a Japan business worth talking about in the Series C deck.
      </p>
    </div>
  </section>

  <!-- Footer cross-link -->
  <section class="py-14">
    <div class="max-w-4xl mx-auto px-6">
      <div class="border-t border-[var(--color-line)] pt-8 flex flex-wrap items-center justify-between gap-4">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-ink)] hover:text-[var(--color-accent)] transition-colors">
          <ArrowLeft class="w-4 h-4" />
          Japan strategy thesis
        </a>
        <span class="text-[16px] text-[var(--color-ink-faint)] font-mono">
          Launch Plan · May 2026 · Confidential · Satoshi Hosoi
        </span>
      </div>
    </div>
  </section>
</Layout>
