---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import * as Icons from "@lucide/astro";
import {
  Flag,
  Rocket,
  Globe,
  TrendingUp,
  Users,
  Building2,
  Shield,
  ShieldCheck,
  Target,
  Compass,
  Zap,
  Eye,
  Crown,
  Sparkles,
  AlertTriangle,
  CheckCircle2,
  ArrowDown,
  ArrowLeft,
  BookOpen,
  Trophy,
  Mountain,
  Languages,
  Briefcase,
  HeartHandshake,
  Award,
  Gauge,
  Lock,
  Calendar,
  GitMerge,
  PiggyBank,
  Factory,
  Landmark,
} from "@lucide/astro";

const iconToPascal = (s: string) =>
  s.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join("");
const Icon = (name?: string) => (name ? ((Icons as any)[iconToPascal(name)] ?? null) : null);

// =====================================================================
// Slide 2 · Executive Summary · three big stats
// =====================================================================
const execSummary = [
  {
    stat: "$286M",
    label: "The Global Foundation",
    body: "$150M Series B at $2B (Mar 2026), four months after $100M Series A. Lead: Insight Partners.",
    sub: [
      "30+ countries live · 80+ enterprise customers",
      "Containment rates >80% in production deployments",
    ],
  },
  {
    stat: "$1B+",
    label: "The Japan Opportunity",
    body: "Projected TAM for Agentic AI, driven by severe labor shortages and a demographic decline.",
    sub: [
      "Targeted universe of 500 mega-sized enterprises",
      "Must-Win Accounts: 155 priority targets",
      "Urgent shift from legacy RPA to autonomous workflows",
    ],
  },
  {
    stat: "90 Days",
    label: "The Acceleration Strategy",
    body: "Aggressive parallel execution sprint targeting first paid revenue in just 6-8 months.",
    sub: [
      "Bypassing standard 12-month procurement delays",
      "Legal, Talent, and Pipeline tracks in strict parallel",
    ],
  },
];

// =====================================================================
// Slide 3 · Global Momentum + APAC Push · proof points
// =====================================================================
const globalProof = [
  { stat: "$286M", label: "Total raised", body: "$150M Series B at $2B (Mar 2026), four months after $100M Series A. Insight, Index, IVP, Bessemer, Vine.", icon: "landmark" },
  { stat: "30+", label: "Countries live", body: "EMEA · APAC · Americas. Embedded country teams, not pure SaaS.", icon: "globe" },
  { stat: "80+", label: "Enterprise customers", body: "Telco · BFSI · healthcare · manufacturing. Production deployments.", icon: "building-2" },
  { stat: "<5%", label: "Annual logo churn", body: "World's lowest enterprise SaaS churn. Bezeq retained at scale.", icon: "shield" },
  { stat: ">80%", label: "Containment rate", body: "Wonderful-reported across production deployments. Replaces legacy automation vendors.", icon: "gauge" },
  { stat: "70%", label: "Multi-workflow expansion", body: "European customers expand to new workflows within 3 months.", icon: "git-merge" },
];

// =====================================================================
// Slide 6 · JP enterprise market — pyramid + industry donut
// Source: METI 2023 Basic Survey of Japanese Business Structure & Activities
// + Hosoi-san launch deck image6 (mega-cap segmentation)
// =====================================================================
const industryMix = [
  { color: "var(--color-accent)", pct: 40, label: "Manufacturing", co: "Toyota, Sony, Panasonic" },
  { color: "#7a5cff", pct: 20, label: "Distribution & Retail", co: "Seven & i, Aeon, Uniqlo" },
  { color: "#0b8f6b", pct: 15, label: "Finance & Insurance", co: "MUFG, Mizuho, Tokyo Marine" },
  { color: "var(--color-accent-ink)", pct: 15, label: "Service & Infrastructure", co: "NTT, JR East, Recruit" },
  { color: "var(--color-ink-soft)", pct: 10, label: "Construction & Real Estate", co: "" },
];
// Precompute donut segment offsets (avoid in-JSX mutation)
const DONUT_C = 2 * Math.PI * 30;
let _o = 0;
const donutSegments = industryMix.map((s) => {
  const dash = (s.pct / 100) * DONUT_C;
  const seg = { ...s, dash, offset: _o };
  _o += dash;
  return seg;
});

// =====================================================================
// Slide 4 · Japan demographic structure 2010 → 2040
// Source: IPSS · National Institute of Population & Social Security Research
// =====================================================================
const demographics = [
  {
    year: "2010",
    actual: true,
    bands: [
      { label: "Under 20", value: 23.0, pct: 18 },
      { label: "Working age (15-64)", value: 79.2, pct: 62, highlight: true },
      { label: "65 +", value: 25.8, pct: 20 },
    ],
    total: 128.0,
  },
  {
    year: "2025",
    actual: false,
    bands: [
      { label: "Under 20", value: 20.6, pct: 16 },
      { label: "Working age (15-64)", value: 70.5, pct: 56, highlight: true },
      { label: "65 +", value: 35.4, pct: 28 },
    ],
    total: 126.5,
  },
  {
    year: "2040",
    actual: false,
    projection: true,
    bands: [
      { label: "Under 20", value: 17.0, pct: 15 },
      { label: "Working age (15-64)", value: 60.0, pct: 53, highlight: true },
      { label: "65 +", value: 36.9, pct: 32 },
    ],
    total: 113.9,
  },
];
const workingAgeDelta = demographics[0].bands[1].value - demographics[2].bands[1].value;
const workingAgePctChange = Math.round((workingAgeDelta / demographics[0].bands[1].value) * 100);

// =====================================================================
// Slide 4 · Japan Macro Catalyst
// =====================================================================
const macroCatalyst = [
  {
    label: "Demographic Crisis",
    sublabel: "Driver",
    icon: "users",
    body: "Rapidly aging population and shrinking workforce creating unprecedented labor shortages.",
  },
  {
    label: "Government Intervention",
    sublabel: "Catalyst",
    icon: "landmark",
    body: "2025 AI Promotion Act and centralised AI Strategy HQ established.",
    detail: "¥10 Trillion (~$65B) investment framework to 2030; GENIAC funding domestic LLMs.",
  },
  {
    label: "Enterprise Reality",
    sublabel: "Outcome",
    icon: "factory",
    body: "Urgent shift from legacy RPA to end-to-end Agentic AI to replace white-collar shortfalls.",
    detail: "$5-6B Agentic AI TAM; enterprise adoption accelerating at 30-40%.",
  },
];

// =====================================================================
// Slide 5 · Why Japan running fast · market stats
// =====================================================================
// ~150 JPY/USD assumed mid-2026. Update if FX shifts materially before HQ board.
const FX = 150;
const usd = (jpyB: number) => `~$${(jpyB / FX).toFixed(1).replace(/\.0$/, "")}B`;

const japanMarket = {
  rank: "#3",
  rankLabel: "Global enterprise SaaS market by spend",
  chart: [
    { year: "2024", value: 180 },
    { year: "2025", value: 290 },
    { year: "2026", value: 480 },
    { year: "2027", value: 720 },
    { year: "2028E", value: 980 },
  ],
  highlights: [
    { stat: "<5%", label: "Annual enterprise logo churn. World's lowest." },
    { stat: "2.4×", label: "Avg. Japan enterprise ACV vs APAC peers." },
  ],
};

// =====================================================================
// Slide 7 · Competitive Landscape
// =====================================================================
const competitors = [
  {
    name: "Rakuten AI 3.0",
    them: "700B-param MoE. Integrated ecosystem focus.",
    us: "Production ROI over model-building. We plug directly into existing tech infrastructures.",
  },
  {
    name: "NEC cotomi LLM",
    them: "Specialised, single-task workflow automation.",
    us: "Multi-workflow orchestration. 70% of clients expand to new workflows within 3 months.",
  },
  {
    name: "Fujitsu Kozuchi AI",
    them: "Multi-AI agent collaboration trials and localised POCs.",
    us: "Europe-proven track record of at-scale enterprise deployments, bypassing sandbox trials.",
  },
  {
    name: "Sakana AI",
    them: "Nature-inspired, highly secure Japanese LLMs.",
    us: "Keigo-native deployment combined with a consumption-only commercial model (virtually zero adoption barrier).",
  },
];

// =====================================================================
// Slide 8 · Three Strategic Pillars
// =====================================================================
const pillars = [
  {
    title: "Credibility",
    icon: "crown",
    items: [
      "Strong, credible local leadership commanding C-suite respect.",
      "Flawless cultural execution and Japanese-grade UX.",
      "Delivering actual production ROI, refusing to do sandbox POCs.",
    ],
  },
  {
    title: "Long-Term Commitment",
    icon: "heart-handshake",
    items: [
      "Aligning tightly with central government objectives (2025 AI Promotion Act).",
      "Heavy localised investment in Keigo-correct language capabilities.",
      "Providing a dedicated AI enablement layer with local implementation teams.",
    ],
  },
  {
    title: "Clear Differentiated Value",
    icon: "award",
    items: [
      "Supporting regulators to ensure highly compliant, trustworthy deployments.",
      "Strict adherence to data sovereignty, governance, and security compliance.",
      "Fully-generative agents capable of handling complex workflows autonomously.",
    ],
  },
];

// =====================================================================
// Slide 10 · Pipeline Funnel
// =====================================================================
const funnel = [
  { count: 500, label: "Japan Enterprise · universe of mega-cap targets" },
  { count: 155, label: "Must-Win List · GM curated by fit, budget, speed" },
  { count: 48, label: "Tier 1 Priorities · highest-value, highest-fit accounts" },
  { count: 5, label: "FY26 Win Targets · $5M ARR by Dec 2026" },
];

const pocTracks = [
  {
    name: "Track 1 · Innovation Lab PoCs",
    target: "CDO + Innovation Heads",
    edge: "Fast budget access, low procurement friction.",
    proof: "Champions hungry for a quick win.",
  },
  {
    name: "Track 2 · DX Mandate PoCs",
    target: "CIO + Digital Transformation Office",
    edge: "Board-level pressure to ship visible, structural AI outcomes.",
    proof: "Aligned to ringi-friendly transformation budgets.",
  },
];


// =====================================================================
// Slide 12 · Launch Team & Hiring Roadmap
// =====================================================================
const coreSquad = [
  { role: "President", name: "Satoshi Hosoi", note: "Policy, lobbying, C-level relations" },
  { role: "General Manager", name: "Hiroshi Ando", note: "Daily ops, HQ collaboration" },
  { role: "Field CTO", name: "TBD", note: "Senior technical lead" },
  { role: "Technical Lead", name: "Marco Avila", note: "Tech delivery, HQ collaboration, JP-fit engineering" },
];

const hiringPhasing = [
  { q: "Q1", focus: "Leadership hiring", goal: "Establishing credibility + entity" },
  { q: "Q2", focus: "Technical deployment team", goal: "Securing production capabilities" },
  { q: "Q3", focus: "Sales and partnership team", goal: "Scaling revenue pipeline" },
  { q: "Q4", focus: "Customer success and scaling", goal: "Protecting and expanding accounts" },
];

// =====================================================================
// Slide 13 · Risks
// =====================================================================
const risks = [
  {
    risk: "Talent Scarcity",
    icon: "users",
    framing: "High risk of mis-hires in a notoriously thin, premium senior talent pool. Wave-1 team must be flawless.",
    mitigation: "Elite retained search engaged pre-entity. Mandatory HQ founder interview gate. Strict 90-day performance reviews.",
  },
  {
    risk: "Enterprise Procurement Drag",
    icon: "gauge",
    framing: "Default B2B enterprise procurement cycles in Japan take 6-12 months, destroying startup momentum.",
    mitigation: "Surgically targeting agile Innovation/DX budgets. Mandating CEO-sponsored PoCs. Deploying MS partner co-selling mechanisms.",
  },
  {
    risk: "Language & Cultural Rejection",
    icon: "languages",
    framing: "Failure in keigo, particles, or strict business etiquette instantly destroys trust. This is a product failure, not just bad marketing.",
    mitigation: "Strict keigo-aware agent quality bar with native reviews. Japanese-grade UX architecture. Native delivery team operating from Day 1.",
  },
];

// =====================================================================
// Slide 14 · Where HQ Unlocks Japan Velocity
// =====================================================================
const hqAsks = [
  {
    num: "01",
    title: "Fast-track Legal Turnaround",
    ask: "48-hour SLA on Japan contract reviews.",
    impact: "Pre-approved MSA, NDA, and DPA templates owned entirely by the local Japan team to bypass time-zone bottlenecks and red tape.",
  },
  {
    num: "02",
    title: "Budget Flex for Top Candidates",
    ask: "Authorisation to stretch 10-15% above standard bands for Wave-1 hires.",
    impact: "A+ talent in Japan is a market premium, not a discount. Securing elite founding talent immediately accelerates the entire 12-month roadmap.",
  },
  {
    num: "03",
    title: "Executive Sponsorship",
    ask: "HQ Founders commit to supporting top talent interviews.",
    impact: "Warms up elite candidates prior to KK entity completion, maintaining critical recruiting momentum during the Pre-Entity phase.",
  },
];

const maxChartValue = Math.max(...japanMarket.chart.map((c) => c.value));
---

<Layout
  title="Wonderful AI · Japan Launch Acceleration Plan"
  description="Strategic Blueprint + 90-Day Execution Sprint. Satoshi Hosoi, President, Japan. May 2026. Confidential."
  brand="Wonderful AI · Japan"
  tagline="Launch Acceleration Plan"
  footerNote="Cloudflare Access · Confidential · prepared for HQ leadership"
  lastUpdated="2026-05"
  tocItems={[
    { number: "01", title: "Executive summary", href: "#summary" },
    { number: "02", title: "Global momentum", href: "#momentum" },
    { number: "03", title: "Japan catalyst", href: "#catalyst" },
    { number: "04", title: "Why Japan now", href: "#market" },
    { number: "05", title: "Competitive edge", href: "#competition" },
    { number: "06", title: "Strategic pillars", href: "#pillars" },
    { number: "07", title: "Time to revenue", href: "#revenue" },
    { number: "08", title: "Pipeline funnel", href: "#funnel" },
    { number: "09", title: "Launch checklist", href: "#sprint" },
    { number: "10", title: "Team & hiring", href: "#team" },
    { number: "11", title: "Risks", href: "#risks" },
    { number: "12", title: "HQ asks", href: "#asks" },
  ]}
>
  <Fragment slot="nav">
    <a href="#summary" class="hover:text-[var(--color-ink)] transition-colors">Summary</a>
    <a href="#sprint" class="hover:text-[var(--color-ink)] transition-colors">Checklist</a>
    <a href="#team" class="hover:text-[var(--color-ink)] transition-colors">Team</a>
    <a href="#asks" class="hover:text-[var(--color-ink)] transition-colors">Asks</a>
  </Fragment>

  <!-- ============================================================ -->
  <!-- TITLE / HERO                                                  -->
  <!-- ============================================================ -->
  <section id="title" class="pt-20 sm:pt-28 pb-16 scroll-mt-4">
    <div class="max-w-6xl mx-auto px-6 w-full">
      <div class="flex items-center gap-3 mb-10 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Flag class="w-3.5 h-3.5" />
          Confidential · for HQ leadership
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">
          Satoshi Hosoi · President, Japan · May 2026
        </span>
      </div>

      <p class="text-[16px] uppercase tracking-[0.22em] text-[var(--color-accent)] font-bold mb-5" data-reveal="fade-up" data-reveal-delay="1">
        Wonderful AI · Japan
      </p>
      <h1 class="font-display text-[1.75rem] sm:text-[2.5rem] md:text-[3.5rem] lg:text-[4rem] leading-[1.05] tracking-tight mb-4 max-w-none relative" data-reveal="fade-up" data-reveal-delay="2">
        <span class="whitespace-nowrap">Launch Acceleration <span class="text-[var(--color-ink-soft)] italic font-display">Plan.</span></span>
        <span aria-hidden="true" class="absolute -left-3 sm:-left-5 top-2 bottom-2 w-[3px] sm:w-[5px] rounded-full bg-gradient-to-b from-[var(--color-accent)] via-[var(--color-accent)] to-transparent"></span>
      </h1>
      <p class="font-display text-xl sm:text-2xl text-[var(--color-ink-soft)] mb-10 max-w-3xl leading-snug italic" data-reveal="fade-up" data-reveal-delay="3">
        Strategic Blueprint &amp; 90-Day Execution Sprint.
      </p>

      <!-- Hero stat strip · fills the title slide -->
      <div class="grid grid-cols-2 md:grid-cols-4 print:grid-cols-4 gap-4 max-w-6xl mb-6" data-reveal="fade-up" data-reveal-delay="3.5">
        {[
          { stat: "$286M", label: "Raised cumulative", sub: "$150M Series B · $2B val" },
          { stat: "30+", label: "Countries live", sub: "EMEA · APAC · Americas" },
          { stat: "80+", label: "Enterprise customers", sub: "Telco · BFSI · health · mfg" },
          { stat: "$5M ARR", label: "FY26 Japan target", sub: "5 wins from 500 mega-cap" },
        ].map((s) => (
          <div class="rounded-xl border-2 border-[var(--color-line)] bg-[var(--color-paper)] p-4 print:p-3">
            <div class="font-display text-[2.5rem] sm:text-[2.75rem] print:text-[2.5rem] leading-none text-[var(--color-highlight)] tracking-tight">{s.stat}</div>
            <div class="text-[14px] uppercase tracking-[0.16em] font-mono font-bold text-[var(--color-ink)] mt-2">{s.label}</div>
            <div class="text-[16px] text-[var(--color-ink-soft)] mt-1 leading-snug">{s.sub}</div>
          </div>
        ))}
      </div>

      <!-- Three-track strip (Legal · Talent · Pipeline) -->
      <div class="grid md:grid-cols-3 print:grid-cols-3 gap-4 max-w-6xl" data-reveal="fade-up" data-reveal-delay="3.7">
        {[
          { tag: "Track 01", title: "Legal & Entity", body: "KK incorporation, banking, compliance posture." },
          { tag: "Track 02", title: "Talent", body: "Wave-1 hires: Country GM, Solutions Eng, GTM lead." },
          { tag: "Track 03", title: "Pipeline", body: "155 must-win accounts. 5 paid wins by Dec 2026." },
        ].map((t) => (
          <div class="border-l-4 border-[var(--color-accent)] bg-[var(--color-paper)]/60 pl-3 py-1.5">
            <div class="text-[16px] uppercase tracking-[0.18em] font-mono font-bold text-[var(--color-accent)]">{t.tag}</div>
            <div class="font-display text-[1rem] text-[var(--color-ink)] leading-tight mt-0.5">{t.title}</div>
            <div class="text-[14px] text-[var(--color-ink-soft)] leading-snug mt-0.5">{t.body}</div>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-3 print:hidden" data-reveal="fade-up" data-reveal-delay="4">
        <a href="#summary" class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-[var(--color-ink)] text-[var(--color-paper)] text-sm font-semibold hover:bg-[var(--color-accent)] transition-colors">
          <BookOpen class="w-4 h-4" />
          Read the plan
          <ArrowDown class="w-3.5 h-3.5 ml-1" />
        </a>
        <a href="/launch-plan/present" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-[var(--color-ink)]/20 bg-[var(--color-paper)] text-[var(--color-ink)] text-sm font-semibold hover:bg-[var(--color-accent)] hover:text-[var(--color-paper)] hover:border-[var(--color-accent)] transition-colors">
          Open the presentation
        </a>
      </div>
      <p class="text-xs text-[var(--color-ink-faint)] font-mono mt-4 print:hidden" data-reveal="fade-up" data-reveal-delay="5">
        Last synced: <strong class="text-[var(--color-ink)]">2026-06-03</strong>.
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §01 · EXECUTIVE SUMMARY                                       -->
  <!-- ============================================================ -->
  <Section
    id="summary"
    eyebrow="01 · Executive summary"
    title="Three numbers tell the story."
    lede='<strong>$286M raised globally.</strong> <strong>$1B+ TAM</strong> in Japan. <strong class="text-[var(--color-highlight)]">90 days</strong> to compress the first paid revenue cycle. The rest of the plan supports those three claims.'
  >
    <div class="grid md:grid-cols-3 print:grid-cols-3 gap-5 max-w-6xl">
      {execSummary.map((item, i) => (
        <div class="rounded-xl border-2 border-[var(--color-line)] bg-[var(--color-paper)] p-6 print:break-inside-avoid" data-reveal="fade-up" data-reveal-delay={i}>
          <div class="font-display text-[3.5rem] sm:text-[4.5rem] leading-none text-[var(--color-highlight)] mb-2 tracking-tight">{item.stat}</div>
          <h3 class="font-display text-xl mb-3 leading-tight">{item.label}</h3>
          <p class="text-sm text-[var(--color-ink)] leading-relaxed mb-4">{item.body}</p>
          <ul class="space-y-1.5 text-[15px] text-[var(--color-ink-soft)]">
            {item.sub.map((s) => (
              <li class="flex gap-2"><span class="text-[var(--color-accent)] mt-0.5">·</span><span>{s}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <!-- ============================================================ -->
  <!-- §02 · GLOBAL MOMENTUM + APAC PUSH                             -->
  <!-- ============================================================ -->
  <Section
    id="momentum"
    eyebrow="02 · Global momentum"
    title="Proof exists. APAC is next."
    lede='Six headline numbers from European deployments. The board has seen these. <strong class="text-[var(--color-highlight)]">Japan is the missing logo.</strong>'
    tone="soft"
  >
    <!-- 3x2 grid of large stat tiles · fills the slide -->
    <div class="grid md:grid-cols-3 print:grid-cols-3 gap-4 max-w-6xl w-full">
      {globalProof.map((p, i) => {
        const IconC = Icon(p.icon);
        return (
          <div class="rounded-xl border-2 border-[var(--color-line)] bg-[var(--color-paper)] p-4 print:p-3 print:break-inside-avoid" data-reveal="fade-up" data-reveal-delay={i}>
            <div class="flex items-start justify-between mb-2">
              <div class="font-display text-[2.25rem] sm:text-[2.75rem] print:text-[2.5rem] leading-none text-[var(--color-highlight)] tracking-tight">{p.stat}</div>
              {IconC && <IconC class="w-5 h-5 text-[var(--color-ink-faint)] mt-1" />}
            </div>
            <div class="text-[14px] uppercase tracking-[0.14em] font-mono font-bold text-[var(--color-accent)] mb-1">{p.label}</div>
            <p class="text-[15px] leading-snug text-[var(--color-ink)]">{p.body}</p>
          </div>
        );
      })}
    </div>
  </Section>

  <!-- ============================================================ -->
  <!-- §03 · JAPAN MACRO CATALYST                                    -->
  <!-- ============================================================ -->
  <Section
    id="catalyst"
    eyebrow="03 · Demographic crisis"
    title="Demographic demand forces the buy."
    lede='Working-age 15-64 collapses 24% by 2040. <strong class="text-[var(--color-highlight)]">Enterprise has no choice but autonomous workflows.</strong>'
  >
    <!-- ===== DEMOGRAPHIC STACKED-BAR VISUAL · the headline evidence ===== -->
    <div class="max-w-6xl mb-4 rounded-xl border-2 border-[var(--color-accent)]/40 bg-[var(--color-paper)] p-4 sm:p-6 print:p-4 print:break-inside-avoid" data-reveal="fade-up">
      <div class="flex items-center gap-3 mb-1 flex-wrap">
        <Users class="w-5 h-5 text-[var(--color-accent)]" />
        <span class="text-sm uppercase tracking-[0.16em] font-mono font-bold text-[var(--color-accent)]">The Demographic Crisis · Driver</span>
      </div>
      <h3 class="font-display text-2xl sm:text-3xl leading-tight mb-2">
        <span class="text-[var(--color-accent)] font-bold">{workingAgeDelta.toFixed(1)}M</span> working-age population lost in 30 years.
      </h3>
      <p class="text-base text-[var(--color-ink-soft)] mb-4 max-w-3xl">2010 to 2040 (IPSS projection). Working age 15-64 collapses <strong class="text-[var(--color-ink)]">{workingAgePctChange}%</strong>. Elderly grow <strong class="text-[var(--color-ink)]">+43%</strong>. Enterprise can't hire its way out.</p>

      <!-- Three stacked bars · 2010 / 2025 / 2040 -->
      <div class="grid sm:grid-cols-3 gap-3 sm:gap-5 mb-4">
        {demographics.map((d, i) => (
          <div class="relative" data-reveal="fade-up" data-reveal-delay={i + 1}>
            <div class="flex items-baseline justify-between mb-2">
              <span class="font-display text-2xl text-[var(--color-ink)]">{d.year}{d.projection && <span class="text-sm text-[var(--color-ink-faint)] font-sans"> · projected</span>}</span>
              <span class="text-sm font-mono text-[var(--color-ink-faint)]">{d.total}M</span>
            </div>
            <!-- vertical stacked bar showing 3 bands -->
