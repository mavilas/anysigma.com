---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Quote from "../components/Quote.astro";
import * as Icons from "@lucide/astro";
import {
  Flag,
  CheckCircle2,
  AlertTriangle,
  XCircle,
  CircleHelp,
  ArrowDown,
  BookOpen,
  Globe,
  TrendingUp,
  Sparkles,
  Skull,
  Rocket,
  Eye,
  Trophy,
  Wrench,
  MapPin,
  Languages,
  Swords,
  Anchor,
  Compass,
  Lightbulb,
  AlertCircle,
  Crown,
  Mountain,
  Gift,
  Award,
  Calendar,
  CheckCheck,
  Cpu,
  Mic,
  Building2,
  UsersRound,
  LayoutDashboard,
  ShieldCheck,
  Cloud,
  CloudOff,
  Activity,
  ActivitySquare,
  ShieldAlert,
  Shield,
  Binary,
  FileSpreadsheet,
  Type,
  Map,
  Download,
  ThumbsUp,
  ListChecks,
  MicVocal,
  SlidersHorizontal,
  Phone,
  FastForward,
  Package2,
  Code2,
  Play,
  GitFork,
  CloudCog,
  Users,
  Target,
  Globe2,
  Building,
  Briefcase,
} from "@lucide/astro";

// kebab-case → PascalCase icon lookup helper for the dynamic Icons import
const iconToPascal = (s: string) =>
  s
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join("");

// =====================================================================
// CONTENT — kept as data so individual sections stay clean to read
// =====================================================================

// Marco's track-record credentials (for §05 Evidence)
const marcoCredentials = [
  {
    icon: "phone",
    headline: "4 enterprise voice-AI deals in Japan",
    detail:
      "Sold first, built the product after the deal was signed. Contact centers, real estate, logistics, partner ops. Current Japanese enterprise buyers, current conversations.",
  },
  {
    icon: "shield-check",
    headline: "SOC II Type I led end-to-end",
    detail:
      "In Japan, security review is meeting one. I have the documentation, the playbook, and the answers procurement teams ask for before they evaluate the product itself.",
  },
  {
    icon: "languages",
    headline: "Voice AI built for 4 JP writing systems",
    detail:
      "From scratch, not translated. Hiragana, Katakana, Kanji, Romaji. Keigo speech levels (Sonkeigo, Kenjogo, Teineigo). Cultural silence patterns. Found and fixed the predictable breaking points.",
  },
  {
    icon: "fast-forward",
    headline: "Japanese enterprise procurement: 12 mo → 3 mo",
    detail:
      "Demo in meeting one, security in two, pilot terms in three. Skip a step and the deal dies. I have just run this sequence. The current intel is current.",
  },
];

// Four practice areas that map to Wonderful's specific gaps
const practiceAreas = [
  {
    title: "Product & Localization",
    icon: "package-2",
    week: "Wk 2–4",
    blurb:
      "Audit your product against what Japanese enterprise buyers test for in the first ten minutes. Build localization right, not translated.",
    bullets: [
      "Demo & product audit walk-through. What they ask first, what wows, what kills the deal.",
      "Voice-AI localization. 4 writing systems · keigo speech levels · cultural silence handling. From scratch.",
      "Roadmap input. Fix the predictable JP breaking points before customers find them.",
    ],
  },
  {
    title: "Compliance & Security",
    icon: "shield-check",
    week: "Wk 3–4",
    blurb:
      "Get the security story production-ready before you walk into meeting one. Security review is the first meeting in Japan, not the last.",
    bullets: [
      "SOC II Type I playbook + documentation pack.",
      "ISMAP readiness for Japanese govt + enterprise procurement.",
      "Data residency · on-prem · VPC posture mapped to JP buyer requirements.",
      "Japanese-language compliance docs and procurement responses.",
    ],
  },
  {
    title: "Go-to-Market",
    icon: "compass",
    week: "Wk 1–12",
    blurb:
      "Compress the 12-month JP enterprise sales cycle to 3. The procurement sequence is the same every time. The vertical detail varies.",
    bullets: [
      "Sales playbook calibrated by vertical (contact center, real estate, logistics, partner).",
      "Procurement sequence: security meeting one, demo meeting two, pilot terms meeting three.",
      "Warm introductions to JP enterprise decision-makers. Current network, not old contacts.",
      "Market positioning for procurement workflows, fiscal year cycles, ringi approval chains.",
    ],
  },
  {
    title: "Talent & Recruiting",
    icon: "users-round",
    week: "Wk 5–12",
    blurb:
      "Find, evaluate, and close the team in Japan. Engineering judgment that recruiters cannot provide.",
    bullets: [
      "Technical screening at engineering depth. Architecture, system design, code quality, production readiness.",
      "Interview process design calibrated for JP candidates' multiple offers.",
      "Engineering network access. Current, not database — people I have shipped with.",
      "Recruiter alignment. Sharper briefs, calibrated comp benchmarks, JP-specific screening criteria.",
    ],
  },
];

// 90-day plan, used in §06
const ninetyDayPlan = [
  {
    weeks: "Weeks 1–2",
    title: "Land + playbook",
    icon: "play",
    deliverables: [
      "Japan positioning playbook",
      "Enterprise demo playbook",
      "Target account map",
      "Candidate sourcing strategy",
    ],
  },
  {
    weeks: "Weeks 3–4",
    title: "Roadmap + compliance",
    icon: "shield-check",
    deliverables: [
      "Compliance roadmap (SOC II, ISMAP, data residency)",
      "Localization gap assessment",
      "Competitive battle cards",
      "Security review preparation pack",
    ],
  },
  {
    weeks: "Weeks 5–8",
    title: "Open the funnel",
    icon: "rocket",
    deliverables: [
      "First enterprise meetings · warm introductions",
      "Candidate pipeline delivery to JP recruiters",
      "Recruiter activation with vetted Japan firms",
    ],
  },
  {
    weeks: "Weeks 9–12",
    title: "Pilot terms + hiring",
    icon: "trophy",
    deliverables: [
      "Pilot terms with first enterprise customer",
      "Hiring framework + comp strategy",
      "Decision memo: direct vs SI-led vs BPO-channel primary motion",
    ],
  },
];

// Winners (JP-led, market-deep) vs Losers (HQ-driven, generic)
const winners = [
  { name: "Sakana AI", what: "$2.65B valuation Nov 2025. JP-native, government-friendly. Local champion.", url: "https://techcrunch.com/2025/11/17/sakana-ai-raises-135m-series-b-at-a-2-65b-valuation-to-continue-building-ai-models-for-japan/" },
  { name: "LayerX", what: "$100M Series B Sep 2025. JP back-office AI. Embedded customer teams.", url: "https://techcrunch.com/2025/09/01/layerx-uses-ai-to-cut-enterprise-back-office-workload-scores-100m-in-series-b/" },
  { name: "PKSHA · Karakuri · Mobius", what: "Imperfect but JP-deep. Own the installed base by default. Slow but trusted.", url: "https://www.pkshatech.com/" },
  { name: "Bezeq (Wonderful's own ref)", what: "2,000-agent telco, ~80% resolution, real production. Proof Wonderful can win at scale when the local fit is there.", url: "https://www.bezeq.co.il/en/" },
];

const losers = [
  { name: "IBM Watson Japan", what: "2017–19 loud entry. Mizuho · MUFG · Daiichi Sankyo named, then quietly off. The reference accounts walked.", url: "https://www.idc.com/jp" },
  { name: "Salesforce Einstein", what: "Strong global product. JP customers run on PKSHA, Karakuri, or Mobius for voice + chat. Einstein stays the CRM.", url: "https://www.salesforce.com/jp/products/einstein-ai-solutions/" },
  { name: "Generic foreign AI-CX vendors", what: "Translated their pitch, lost POCs in 3 months. No embedded team, no keigo eval, no on-prem option.", url: null },
  { name: "Xembly (US AI Chief of Staff)", what: "$20M raised. Salesforce + Qualtrics customers. Shut down June 2024. Same archetype, US edition.", url: "https://www.geekwire.com/2024/enterprise-ai-company-xembly-abruptly-ends-service-for-users-says-its-working-on-new-chapter/" },
];

// Wonderful platform strengths (from V2)
const strengths = [
  {
    title: "Agentic OS, not chat-on-top",
    icon: "cpu",
    detail:
      "The demo showed real plumbing. The platform bridges a billing dispute on a legacy stack with no human handoff. Not a chatbot in platform costume.",
  },
  {
    title: "Deepdub eTTS voice",
    icon: "mic",
    detail:
      "Human-grade voice with proper barge-in and interruption handling. Closest competitor on voice in the JP-targeting cohort. Voice matters more here than anywhere.",
  },
  {
    title: "Bezeq production reference",
    icon: "building-2",
    detail:
      "2,000-agent telco, around 80% resolution, millions of calls a month. Most foreign vendors landing in Japan have no production reference at this scale.",
  },
  {
    title: "Forward-Deployed Engineering",
    icon: "users-round",
    detail:
      "Embedded country teams. Local CTO plus agentic engineers inside the customer. This is the posture JP enterprises expect. PKSHA and AI Shift cannot match it operationally.",
  },
  {
    title: "Multimodal agents + Wonderful Apps",
    icon: "layout-dashboard",
    detail:
      "End-user, employee, and platform views landed as one product. Auto-generated UIs are a credible wedge into internal DX, not just CS.",
  },
  {
    title: "Enterprise-grade governance + audit",
    icon: "shield-check",
    detail:
      "Permissioning, audit logs, channel integrations, telephony, MCP. The table-stakes for JP enterprise procurement are checked. Hard-won, not easy to fake.",
  },
];

// Wonderful platform gaps (with severity + icon)
const gaps = [
  {
    title: "Voice control · formality + dialect handling",
    severity: "high",
    icon: "mic-vocal",
    detail:
      "Japanese voice has to switch fluently between Sonkeigo, Kenjogo, and Teineigo inside the same call. Kansai-ben and Tohoku-ben ASR is a separate cliff. General LLM scale does not fix this.",
  },
  {
    title: "Cloud-only posture · no on-prem / VPC option",
    severity: "high",
    icon: "cloud-off",
    detail:
      "JP procurement asks about data residency in the first 30 minutes. Many enterprises require VPC, on-prem, or air-gapped. Cloud-only is a hard stop with those accounts.",
  },
  {
    title: "LLM repeat-number / hallucination loops",
    severity: "high",
    icon: "alert-triangle",
    detail:
      "Voice models sometimes lock into repeating digits or phrases on long sessions. Needs a guardrail layer (length cap, repetition detector, deterministic fallback). Unforgiving in JP customer service.",
  },
  {
    title: "PII handling · in transit, at rest, on every touch",
    severity: "high",
    icon: "shield",
    detail:
      "JP procurement asks specifically about pseudonymization in transit, redaction at storage, role-based view, and audit logging on every touch. \"Encrypted\" is not the answer they want.",
  },
  {
    title: "Robustness + graceful degradation",
    severity: "high",
    icon: "shield-alert",
    detail:
      "Production voice + agentic orchestration + multi-agent debate creates many failure modes. What breaks first when something fails? JP procurement asks and grades the answer.",
  },
  {
    title: "Uptime + SLA terms",
    severity: "high",
    icon: "activity-square",
    detail:
      "JP enterprise treats SLAs contractually. Specific uptime (99.9 / 99.95 / four-nines), credit terms, defined incident-response cadence. \"Best effort\" does not survive procurement.",
  },
  {
    title: "Dashboard UX",
    severity: "medium",
    icon: "layout-dashboard",
    detail:
      "Anthony surfaced this. The widget-studio approach (per-role components, drag-to-reorder, contextual surface) is the right direction. JP execs grade on this surface daily.",
  },
  {
    title: "Data export friction",
    severity: "medium",
    icon: "download",
    detail:
      "Large JP enterprises (NTT, Mitsubishi, Panasonic) routinely need subsidiary-to-parent data flow. A self-serve signed-URL path with audit trail solves it.",
  },
  {
    title: "AI-recommendation feedback (thumbs / approve / reject)",
    severity: "medium",
    icon: "thumbs-up",
    detail:
      "JP enterprise wants oversight over autonomy. Without explicit accept / reject capture on every recommendation, the platform reads as autopilot-y in procurement.",
  },
  {
    title: "Configuration over customization",
    severity: "medium",
    icon: "sliders-horizontal",
    detail:
      "Forward-Deployed Engineering is a strength. Risk: customer-specific customization becomes one-off engineering creating tech debt. JP enterprises prefer 80% via configuration, 20% custom.",
  },
  {
    title: "Activity / task UI",
    severity: "low",
    icon: "list-checks",
    detail:
      "Acknowledged basic. Acceptable through 2026 if the underlying pipeline is strong. Not acceptable past Q4.",
  },
  {
    title: "In-session sentiment",
    severity: "low",
    icon: "activity",
    detail:
      "Post-session sentiment is fine for analytics. In-session is what call-center floor leads want for intervention triggers. Roadmap timeline worth surfacing.",
  },
];

// Japan failure modes — radial signature SVG + cards
const japanFailureModes = [
  {
    label: "Keigo",
    title: "Sonkeigo · Kenjogo · Teineigo switching",
    impact:
      "Foreign agents that get keigo wrong don't read as wooden. They read as offensive. The single biggest reason US-first vendors fail at JP customer-facing voice.",
    icon: "languages",
  },
  {
    label: "Dialect",
    title: "Kansai-ben · Tohoku-ben ASR",
    impact:
      "Regional dialects break Western ASR pipelines. Osaka contact centers and Tohoku branches make-or-break early PoCs.",
    icon: "map",
  },
  {
    label: "Encoding",
    title: "Mojibake · Shift-JIS · EBCDIC",
    impact:
      "JP banks and utilities still run mainframe stacks. Without native transcoding, every customer-record lookup becomes a project of its own.",
    icon: "binary",
  },
  {
    label: "Documents",
    title: "Kami-Excel · merged cells · layout-as-data",
    impact:
      "Japanese corporates use Excel as a layout language. Strategy decks, internal policies, customer records all live in patterns that break naïve RAG.",
    icon: "file-spreadsheet",
  },
  {
    label: "Characters",
    title: "Furigana + Gaiji",
    impact:
      "Naïve tokenizers duplicate Furigana. Banks and government use Gaiji for names that don't exist in Unicode. Quiet hallucinations the customer notices before you do.",
    icon: "type",
  },
  {
    label: "Compliance",
    title: "APPI · data residency · on-prem",
    impact:
      "Procurement asks about data residency in the first 30 minutes. Cloud-only is a hard stop. APPI 2025–26 amendments added administrative penalties.",
    icon: "shield-alert",
  },
];

// Competitor matrix — JP procurement cohort
const competitors = [
  {
    name: "PKSHA Tech",
    role: "Old guard",
    strength: "Massive installed base · existing enterprise relationships",
    weakness: "Agent-poor · decision-tree-bound · slow to ship agentic",
    wonderfulWedge: "Voice + autonomy + multimodal — step-changes PKSHA can't match operationally",
  },
  {
    name: "Karakuri",
    role: "The sniper",
    strength: "95%+ accuracy on chat · clean product",
    weakness: "Chat-heavy · weaker on voice · narrower scope",
    wonderfulWedge: "Voice is the wedge. Karakuri's customers are also Wonderful's TAM.",
  },
  {
    name: "AI Shift",
    role: "Marketer",
    strength: "Strong UX · solid sales motion",
    weakness: "Surface-level · no deep ERP · less platform, more product",
    wonderfulWedge: "Platform depth + forward-deployed eng = procurement edge for larger logos",
  },
  {
    name: "Mobius (Mobilus)",
    role: "Telco veteran",
    strength: "Deployed across JP telco contact centers",
    weakness: "Legacy baggage · less agentic · slow innovation",
    wonderfulWedge: "Use as the baseline customers are migrating from. Replacement story is real.",
  },
  {
    name: "Sakana AI",
    role: "Local hero",
    strength: "World-class models · Japan-native · brand halo",
    weakness: "No application layer · model-first · long enterprise cycles",
    wonderfulWedge: "Wonderful is the last mile Sakana doesn't build. Co-marketing potential, not direct competition.",
  },
];

// Open questions per audience
const openQuestions = [
  {
    audience: "HQ + Asia Regional",
    icon: "globe-2",
    question: "Direct enterprise sales, BPO channel (Transcosmos, Bell System24), or both. Has Tel Aviv decided?",
  },
  {
    audience: "HQ + Asia Regional",
    icon: "cloud-cog",
    question: "On-prem + VPC posture. Current state, and roadmap timeline visible to a JP procurement team.",
  },
  {
    audience: "HQ + Asia Regional",
    icon: "users",
    question: "Founding JP team profile. Who is hired, what role is next, what bar.",
  },
  {
    audience: "Hosoi-san + Anthony + Henek",
    icon: "target",
    question: "Year-1 logo target. Which single name landed in 2026 makes this region \"won\" in HQ's eyes.",
  },
  {
    audience: "Hosoi-san + Anthony + Henek",
    icon: "git-fork",
    question: "Alignment that the beachhead is internal workflow automation, not customer service, until JP-fit gaps are production-ready.",
  },
  {
    audience: "HQ engineering",
    icon: "wrench",
    question: "Roadmap for §03 high-severity gaps. Keigo eval set, dialect ASR fidelity, transcoding, repeat-number guardrail, PII handling, SLA terms.",
  },
];

// Helper to render an icon by string name
const Icon = (name: string) => (Icons as any)[iconToPascal(name)];
---

<Layout
  title="Wonderful · Japan strategy · Marco Avila"
  description="Selling the shift in Japan. A confidential strategy + engagement proposal for Wonderful.ai's Asia leadership."
  brand="Marco Avila"
  tagline="Wonderful · Japan strategy"
  footerNote="Cloudflare Access · 24h session · Confidential to Anthony · Henek · Hosoi-san"
  lastUpdated="2026-05-12"
>
  <!-- ============================================================ -->
  <!-- HERO -->
  <!-- ============================================================ -->
  <section class="pt-20 sm:pt-28 pb-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-10 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Flag class="w-3.5 h-3.5" />
          Confidential · Anthony · Henek · Hosoi-san
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">
          Marco Avila · 2026-05-12 · ~14 min read
        </span>
      </div>

      <p class="text-[10px] uppercase tracking-[0.22em] text-[var(--color-accent)] font-bold mb-5" data-reveal="fade-up" data-reveal-delay="1">
        The shift
      </p>
      <h1 class="font-display text-[2.75rem] sm:text-[4rem] lg:text-[4.75rem] leading-[1.0] tracking-tight mb-8 max-w-5xl" data-reveal="fade-up" data-reveal-delay="2">
        Japan-led,<br />not Japan-translated.
      </h1>

      <div class="prose-block max-w-3xl mb-12" data-reveal="fade-up" data-reveal-delay="3">
        <p>
          <strong>In Japan, AI is not a cost-cutting story. It is survival.</strong> Contact centers cannot hire. Knowledge workers are retiring faster than they are being replaced. The Cabinet Office's own demographic forecasts make the math undeniable. Enterprise AI in Japan is not a margin lever. It is the only way the country's largest organizations stay operational past 2030.
        </p>
        <p>
          That changes how Japan buys. The question is no longer <em>"can we afford to wait?"</em> It is <em>"who do we trust to land before the door closes?"</em> The market is huge, friendly, and finally moving. Most foreign vendors will lose it the same way they have lost it before, by letting HQ write the Japan plan.
        </p>
        <p>
          The Japan strategy has to be <strong>written in Tokyo</strong>. Asia regional carries it outward. HQ in Tel Aviv provides air cover, capital, and platform velocity. Every foreign vendor that tried this in reverse got pushed out, and the procurement reality of this market will close the door on the next foreign vendor that does the same.
        </p>
        <p>
          This writeup follows that thesis through five acts. <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-accent)]">The shift</span> · <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-accent)]">Winners and losers</span> · <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-accent)]">The promised land</span> · <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-accent)]">Magic gifts (platform + operator)</span> · <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-accent)]">Evidence</span>. Then a 90-day plan and a path forward.
        </p>
      </div>

      <!-- TL;DR card -->
      <div class="rounded-xl border-2 border-[var(--color-accent)] bg-[var(--color-paper)] p-7 mb-12 max-w-4xl" data-reveal="fade-up" data-reveal-delay="4">
        <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent-ink)] font-bold mb-3 flex items-center gap-2">
          <Sparkles class="w-3.5 h-3.5" />
          TL;DR · 60 seconds
        </div>
        <ul class="text-base text-[var(--color-ink)] leading-relaxed space-y-2.5">
          <li>
            <strong>The platform is real.</strong> Agentic OS, voice, Bezeq-scale reference. The core 80% is shipped.
          </li>
          <li>
            <strong>The 20% is what Japan tests for.</strong> Keigo, dialect, PII, on-prem, robustness, SLA, document encoding. Without these, no SI partner will stake their JP enterprise relationship on Wonderful.
          </li>
          <li>
            <strong>Beachhead, Hosoi-san aligned.</strong> Sell PoC on the 80% now. Internal workflow automation at old-guard logos. Close the 20% in parallel during procurement. By production time, Wonderful is JP-tuned and the customer is committed. 12-month sales cycle compressed to engineering-and-sales-in-parallel.
          </li>
          <li>
            <strong>The strategy gets written in Tokyo.</strong> Hosoi-san leads. Asia regional bridges. HQ provides air cover. Inversion of the foreign-vendor default.
          </li>
        </ul>
      </div>

      <div class="flex flex-wrap items-center gap-3" data-reveal="fade-up" data-reveal-delay="5">
        <a href="#shift" class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-[var(--color-ink)] text-[var(--color-paper)] text-sm font-semibold hover:bg-[var(--color-accent)] transition-colors">
          <BookOpen class="w-4 h-4" />
          Read the full feedback
          <ArrowDown class="w-3.5 h-3.5 ml-1" />
        </a>
        <a href="#plan" class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-[var(--color-line)] text-sm font-semibold hover:border-[var(--color-ink)] transition-colors">
          Skip to the 90-day plan
        </a>
      </div>

      <p class="mt-6 text-xs text-[var(--color-ink-faint)] max-w-3xl">
        Audience: Anthony (VP, Asia Operations) · Henek (Asia Regional GM) · Hosoi-san / Satoshi (President, Japan, in role May 2026). Distributed via the LINE group as the requested feedback writeup. Hosted at <code class="inline-code">wonderful.anysigma.com</code> behind Cloudflare Access.
      </p>
    </div>
  </section>

  <hr class="section-rule max-w-6xl mx-auto" />

  <!-- ============================================================ -->
  <!-- §01 THE SHIFT -->
  <!-- ============================================================ -->
  <Section
    id="shift"
    eyebrow="01 · The shift"
    title="Japan's AI market is huge, friendly, and moving fast. The HQ-driven foreign-vendor model is officially dead."
    lede="Two things changed at once. Demographic pressure flipped Japan from 'maybe' to 'must' on enterprise AI adoption. And the pattern of foreign-vendor failure became too obvious for procurement teams to ignore. Both shifts create urgency. Both shifts have winners and losers, and the criteria for being on the right side are clear."
  >
    <!-- "AI = survival" callout — the load-bearing reframe -->
    <div class="rounded-xl border-2 border-[var(--color-accent)]/40 bg-[var(--color-accent-soft)]/30 p-6 mb-10 max-w-4xl" data-reveal="fade-up">
      <div class="flex items-baseline gap-2 mb-2 flex-wrap">
        <span class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent-ink)] font-bold">The Japan reframe</span>
      </div>
      <h3 class="font-display text-2xl mb-2 leading-tight">AI in Japan is not a cost-cutting story. It is survival.</h3>
      <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">
        In every other market, enterprise AI gets sold as ROI or margin. In Japan, it gets sold as <em class="font-display">continuity</em>. Contact centers physically cannot hire enough operators. Knowledge workers are retiring faster than they are replaced. <a class="text-[var(--color-accent)] hover:underline" href="https://www8.cao.go.jp/kourei/english/annualreport/index-wh.html" target="_blank" rel="noopener noreferrer">The Cabinet Office's demographic forecasts</a> make the math undeniable. AI is the only way the largest JP organizations stay operational past 2030. That changes the buying frame from "do we want this" to "who do we trust to deliver it."
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-4 max-w-5xl mb-12">
      <div class="tile border border-[var(--color-line)] rounded-xl p-6 bg-[var(--color-paper)]" data-reveal="fade-up">
        <Globe class="w-5 h-5 text-[var(--color-accent)] mb-4" />
