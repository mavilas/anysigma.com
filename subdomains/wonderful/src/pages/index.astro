---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Quote from "../components/Quote.astro";
import * as Icons from "@lucide/astro";
import {
  Flag,
  CheckCircle2,
  AlertTriangle,
  XCircle,
  CircleHelp,
  ArrowDown,
  BookOpen,
  Globe,
  TrendingUp,
  Sparkles,
  Skull,
  Rocket,
  Eye,
  Trophy,
  Wrench,
  MapPin,
  Languages,
  Swords,
  Anchor,
  Compass,
  Lightbulb,
  AlertCircle,
  Crown,
  Mountain,
  Gift,
  Award,
  Calendar,
  CheckCheck,
  Cpu,
  Mic,
  Building2,
  UsersRound,
  LayoutDashboard,
  ShieldCheck,
  Cloud,
  CloudOff,
  Activity,
  ActivitySquare,
  ShieldAlert,
  Shield,
  Binary,
  FileSpreadsheet,
  Type,
  Map,
  Download,
  ThumbsUp,
  ListChecks,
  MicVocal,
  SlidersHorizontal,
  Phone,
  FastForward,
  Package2,
  Code2,
  Play,
  GitFork,
  CloudCog,
  Users,
  Target,
  Globe2,
  Building,
  Briefcase,
} from "@lucide/astro";

// kebab-case → PascalCase icon lookup helper for the dynamic Icons import
const iconToPascal = (s: string) =>
  s
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join("");

// =====================================================================
// CONTENT — kept as data so individual sections stay clean to read
// =====================================================================

// Four practice areas that map to Wonderful's specific gaps
const practiceAreas = [
  {
    title: "Product & Localization",
    icon: "package-2",
    week: "Wk 2–4",
    blurb:
      "Audit your product against what Japanese enterprise buyers test for in the first ten minutes. Build localization right, not translated.",
    bullets: [
      "Demo & product audit walk-through. What they ask first, what wows, what kills the deal.",
      "Voice-AI localization. 4 writing systems · keigo speech levels · cultural silence handling. From scratch.",
      "Roadmap input. Fix the predictable JP breaking points before customers find them.",
    ],
  },
  {
    title: "Compliance & Security",
    icon: "shield-check",
    week: "Wk 3–4",
    blurb:
      "Get the security story production-ready before you walk into meeting one. Security review is the first meeting in Japan, not the last.",
    bullets: [
      "SOC II Type I playbook + documentation pack.",
      "ISMAP readiness for Japanese govt + enterprise procurement.",
      "Data residency · on-prem · VPC posture mapped to JP buyer requirements.",
      "Japanese-language compliance docs and procurement responses.",
    ],
  },
  {
    title: "Go-to-Market",
    icon: "compass",
    week: "Wk 1–12",
    blurb:
      "Compress the 12-month JP enterprise sales cycle to 3. The procurement sequence is the same every time. The vertical detail varies.",
    bullets: [
      "Sales playbook calibrated by vertical (contact center, real estate, logistics, partner).",
      "Procurement sequence: security meeting one, demo meeting two, pilot terms meeting three.",
      "Warm introductions to JP enterprise decision-makers. Current network, not old contacts.",
      "Market positioning for procurement workflows, fiscal year cycles, ringi approval chains.",
    ],
  },
  {
    title: "Hiring calibration & screening depth",
    icon: "users-round",
    week: "In flight",
    blurb:
      "Wonderful's Japan hiring is already in motion. Where I add value sits on top of that engine: depth of technical screening on senior eng, calibration of briefs and interview close-rate, and access to people I have shipped with.",
    bullets: [
      "Technical screening at engineering depth for the senior eng roles where pattern-match matters most. Architecture, system design, production readiness.",
      "Interview process calibration for JP candidates who hold multiple offers. Close rate matters more than top-of-funnel volume.",
      "JP-specific brief sharpening for recruiters already engaged. Better signal per call.",
      "Engineering network access. Current, not database. People I have shipped with.",
    ],
  },
];

// 90-day plan, used in §06
const ninetyDayPlan = [
  {
    weeks: "Weeks 1–2",
    title: "Land + playbook",
    icon: "play",
    deliverables: [
      "Japan positioning playbook",
      "Enterprise demo playbook",
      "Target account map",
      "JP hiring brief calibration · sits on top of recruiters already engaged",
    ],
  },
  {
    weeks: "Weeks 3–4",
    title: "Roadmap + compliance",
    icon: "shield-check",
    deliverables: [
      "Compliance roadmap (SOC II, ISMAP, data residency)",
      "Localization gap assessment",
      "Competitive battle cards",
      "Security review preparation pack",
    ],
  },
  {
    weeks: "Weeks 5–8",
    title: "Open the funnel",
    icon: "rocket",
    deliverables: [
      "First enterprise meetings · warm introductions",
      "Senior eng technical screening at depth",
      "Interview process calibration for JP close-rate",
    ],
  },
  {
    weeks: "Weeks 9–12",
    title: "Pilot terms + first closes",
    icon: "trophy",
    deliverables: [
      "Pilot terms with first enterprise customer",
      "Decision memo: direct vs SI-led vs BPO-channel primary motion",
      "Calibrated framework for the next senior closes",
    ],
  },
];

// Winners (JP-led, market-deep) vs Losers (HQ-driven, generic)
const winners = [
  { name: "Sakana AI", what: "$2.65B valuation Nov 2025. JP-native, government-friendly. Local champion.", url: "https://techcrunch.com/2025/11/17/sakana-ai-raises-135m-series-b-at-a-2-65b-valuation-to-continue-building-ai-models-for-japan/" },
  { name: "LayerX", what: "$100M Series B Sep 2025. JP back-office AI. Embedded customer teams.", url: "https://techcrunch.com/2025/09/01/layerx-uses-ai-to-cut-enterprise-back-office-workload-scores-100m-in-series-b/" },
  { name: "PKSHA · Karakuri · Mobius", what: "Imperfect but JP-deep. Own the installed base by default. Slow but trusted.", url: "https://www.pkshatech.com/" },
  { name: "Bezeq (Wonderful's own ref)", what: "2,000-agent telco, ~80% resolution, real production. Proof Wonderful can win at scale when the local fit is there.", url: "https://www.bezeq.co.il/en/" },
];

const losers = [
  { name: "IBM Watson Japan", what: "2017–19 loud entry. Mizuho · MUFG · Daiichi Sankyo named, then quietly off. The reference accounts walked.", url: "https://www.idc.com/jp" },
  { name: "Salesforce Einstein", what: "Strong global product. JP customers run on PKSHA, Karakuri, or Mobius for voice + chat. Einstein stays the CRM.", url: "https://www.salesforce.com/jp/products/einstein-ai-solutions/" },
  { name: "Generic foreign AI-CX vendors", what: "Translated their pitch, lost POCs in 3 months. No embedded team, no keigo eval, no on-prem option.", url: null },
  { name: "Xembly (US AI Chief of Staff)", what: "$20M raised. Salesforce + Qualtrics customers. Shut down June 2024. Same archetype, US edition.", url: "https://www.geekwire.com/2024/enterprise-ai-company-xembly-abruptly-ends-service-for-users-says-its-working-on-new-chapter/" },
];

// Wonderful platform strengths — proven scale leads, then platform depth
const strengths = [
  {
    title: "Proven at production scale",
    badge: "Front and center",
    icon: "building-2",
    detail:
      "Bezeq · 2,000-agent telco · ~80% resolution · millions of calls a month. Almost no foreign agentic-AI vendor landing in Japan can point to a reference of this scale. Lead every conversation with this.",
  },
  {
    title: "Agentic OS · not chat-on-top",
    badge: "Architecture",
    icon: "cpu",
    detail:
      "The demo showed real plumbing. Real workflow autonomy that bridges a billing dispute on a legacy stack with no human handoff. Not a chatbot in platform costume.",
  },
  {
    title: "Deepdub eTTS voice",
    badge: "Voice",
    icon: "mic",
    detail:
      "Human-grade voice with proper barge-in and interruption handling. Closest competitor on voice in the JP-targeting cohort. Voice matters more in Japan than anywhere.",
  },
  {
    title: "SIP / IVR + telephony integrations",
    badge: "Carrier-ready",
    icon: "phone",
    detail:
      "Direct carrier integration, not a recorded-line wrapper. This is what makes a JP contact-center PoC physically possible without a six-month integration project. Major moat vs chat-first competitors.",
  },
  {
    title: "Agent builder + extensibility",
    badge: "Builder",
    icon: "package-2",
    detail:
      "Customers can build, modify, and combine agents inside the platform. Channel integrations, MCP, third-party tools. The system the customer's own engineers will use is the system the customer will keep.",
  },
  {
    title: "Forward-Deployed Engineering",
    badge: "Embedded posture",
    icon: "users-round",
    detail:
      "Embedded country teams. Local CTO plus agentic engineers inside the customer. The posture JP enterprises expect. PKSHA and AI Shift cannot match it operationally.",
  },
  {
    title: "Multimodal + Wonderful Apps",
    badge: "Surface",
    icon: "layout-dashboard",
    detail:
      "End-user, employee, and platform views landed as one product. Auto-generated UIs are a credible wedge into internal DX, not just CS.",
  },
  {
    title: "Enterprise-grade governance + audit",
    badge: "Table-stakes covered",
    icon: "shield-check",
    detail:
      "Permissioning, audit logs, channel integrations, telephony, MCP. The procurement table-stakes are already checked. Hard-won, not easy to fake.",
  },
];

// Wonderful platform gaps (with severity + icon)
const gaps = [
  {
    title: "Voice control · formality + dialect handling",
    severity: "high",
    icon: "mic-vocal",
    detail:
      "Japanese voice has to switch fluently between Sonkeigo, Kenjogo, and Teineigo inside the same call. Kansai-ben and Tohoku-ben ASR is a separate cliff. General LLM scale does not fix this.",
  },
  {
    title: "Cloud-only posture · no on-prem / VPC option",
    severity: "high",
    icon: "cloud-off",
    detail:
      "JP procurement asks about data residency in the first 30 minutes. Many enterprises require VPC, on-prem, or air-gapped. Cloud-only is a hard stop with those accounts.",
  },
  {
    title: "LLM repeat-number / hallucination loops",
    severity: "high",
    icon: "alert-triangle",
    detail:
      "Voice models sometimes lock into repeating digits or phrases on long sessions. Needs a guardrail layer (length cap, repetition detector, deterministic fallback). Unforgiving in JP customer service.",
  },
  {
    title: "PII handling · in transit, at rest, on every touch",
    severity: "high",
    icon: "shield",
    detail:
      "JP procurement asks specifically about pseudonymization in transit, redaction at storage, role-based view, and audit logging on every touch. \"Encrypted\" is not the answer they want.",
  },
  {
    title: "Robustness + graceful degradation",
    severity: "high",
    icon: "shield-alert",
    detail:
      "Production voice + agentic orchestration + multi-agent debate creates many failure modes. What breaks first when something fails? JP procurement asks and grades the answer.",
  },
  {
    title: "Uptime + SLA terms",
    severity: "high",
    icon: "activity-square",
    detail:
      "JP enterprise treats SLAs contractually. Specific uptime (99.9 / 99.95 / four-nines), credit terms, defined incident-response cadence. \"Best effort\" does not survive procurement.",
  },
  {
    title: "Legacy integrations · mainframe · COBOL · old EDI",
    severity: "high",
    icon: "binary",
    detail:
      "JP old-guard industrials (Panasonic, Hitachi, NEC, Fujitsu, the big banks) run agents-of-record on COBOL mainframes, AS/400 / IBM i, SOAP, and old EDI. The demo did not surface how Wonderful's agents reach into those systems. For internal-workflow PoCs at the named beachhead targets, this is mission-critical, not optional.",
  },
  {
    title: "Dashboard UX",
    severity: "medium",
    icon: "layout-dashboard",
    detail:
      "Anthony surfaced this. The widget-studio approach (per-role components, drag-to-reorder, contextual surface) is the right direction. JP execs grade on this surface daily.",
  },
  {
    title: "Data export friction",
    severity: "medium",
    icon: "download",
    detail:
      "Large JP enterprises (NTT, Mitsubishi, Panasonic) routinely need subsidiary-to-parent data flow. A self-serve signed-URL path with audit trail solves it.",
  },
  {
    title: "AI-recommendation feedback (thumbs / approve / reject)",
    severity: "medium",
    icon: "thumbs-up",
    detail:
      "JP enterprise wants oversight over autonomy. Without explicit accept / reject capture on every recommendation, the platform reads as autopilot-y in procurement.",
  },
  {
    title: "Configuration · full control · platform influence",
    severity: "high",
    icon: "sliders-horizontal",
    detail:
      "JP enterprise wants 80% via configuration, not customization. And they want full visibility, full control, and meaningful influence on the platform roadmap. Forward-Deployed Engineering is a strength but the configuration surface (settings, dashboard widgets, role-based defaults, customer-facing config UIs) needs to do the heavy lifting before bespoke eng cycles. Customization without a strong config surface creates tech debt + lock-in + customer fatigue.",
  },
  {
    title: "Ease of use · admin + builder UX",
    severity: "high",
    icon: "wrench",
    detail:
      "Agent builder, admin tools, and configuration UIs need to be operable by the customer's own team, not just Wonderful FDEs. JP customers grade ease-of-use harshly. Anthony surfaced UX gaps already; this category is the one to invest in next.",
  },
  {
    title: "Activity / task UI",
    severity: "low",
    icon: "list-checks",
    detail:
      "Acknowledged basic. Acceptable through 2026 if the underlying pipeline is strong. Not acceptable past Q4.",
  },
  {
    title: "In-session sentiment",
    severity: "low",
    icon: "activity",
    detail:
      "Post-session sentiment is fine for analytics. In-session is what call-center floor leads want for intervention triggers. Roadmap timeline worth surfacing.",
  },
];

// Japan failure modes — radial signature SVG + cards
const japanFailureModes = [
  {
    label: "Keigo",
    title: "Sonkeigo · Kenjogo · Teineigo switching",
    impact:
      "Foreign agents that get keigo wrong don't read as wooden. They read as offensive. The single biggest reason US-first vendors fail at JP customer-facing voice.",
    icon: "languages",
  },
  {
    label: "Dialect",
    title: "Kansai-ben · Tohoku-ben ASR",
    impact:
      "Regional dialects break Western ASR pipelines. Osaka contact centers and Tohoku branches make-or-break early PoCs.",
    icon: "map",
  },
  {
    label: "Encoding",
    title: "Mojibake · Shift-JIS · EBCDIC",
    impact:
      "JP banks and utilities still run mainframe stacks. Without native transcoding, every customer-record lookup becomes a project of its own.",
    icon: "binary",
  },
  {
    label: "Documents",
    title: "Kami-Excel · merged cells · layout-as-data",
    impact:
      "Japanese corporates use Excel as a layout language. Strategy decks, internal policies, customer records all live in patterns that break naïve RAG.",
    icon: "file-spreadsheet",
  },
  {
    label: "Characters",
    title: "Furigana + Gaiji",
    impact:
      "Naïve tokenizers duplicate Furigana. Banks and government use Gaiji for names that don't exist in Unicode. Quiet hallucinations the customer notices before you do.",
    icon: "type",
  },
  {
    label: "Compliance",
    title: "APPI · data residency · on-prem",
    impact:
      "Procurement asks about data residency in the first 30 minutes. Cloud-only is a hard stop. APPI 2025–26 amendments added administrative penalties.",
    icon: "shield-alert",
  },
];

// Competitor matrix — JP procurement cohort
const competitors = [
  // === JP-native cohort · who procurement compares Wonderful against today ===
  {
    cohort: "jp",
    name: "PKSHA Tech",
    role: "Old guard",
    strength: "Massive installed base · existing enterprise relationships",
    weakness: "Agent-poor · decision-tree-bound · slow to ship agentic",
    wonderfulWedge: "Voice + autonomy + multimodal. Step-changes PKSHA can't match operationally.",
  },
  {
    cohort: "jp",
    name: "Karakuri",
    role: "The sniper",
    strength: "95%+ accuracy on chat · clean product",
    weakness: "Chat-heavy · weaker on voice · narrower scope",
    wonderfulWedge: "Voice is the wedge. Karakuri's customers are also Wonderful's TAM.",
  },
  {
    cohort: "jp",
    name: "AI Shift",
    role: "Marketer",
    strength: "Strong UX · solid sales motion",
    weakness: "Surface-level · no deep ERP · less platform, more product",
    wonderfulWedge: "Platform depth + forward-deployed eng = procurement edge for larger logos",
  },
  {
    cohort: "jp",
    name: "Mobius (Mobilus)",
    role: "Telco veteran",
    strength: "Deployed across JP telco contact centers",
    weakness: "Legacy baggage · less agentic · slow innovation",
    wonderfulWedge: "Use as the baseline customers are migrating from. Replacement story is real.",
  },
  {
    cohort: "jp",
    name: "Sakana AI",
    role: "Local hero",
    strength: "World-class models · Japan-native · brand halo",
    weakness: "No application layer · model-first · long enterprise cycles",
    wonderfulWedge: "Wonderful is the last mile Sakana doesn't build. Co-marketing potential, not direct competition.",
  },
  {
    cohort: "jp",
    name: "Jurin AI",
    role: "JP-native startup",
    strength: "Native Tokyo team · JP enterprise instincts · fast iteration on JP-specific failure modes",
    weakness: "Startup-scale gaps. No Bezeq-grade production reference. Narrower platform breadth, less mature security posture, smaller FDE bench, no multi-region deployment story. The things JP procurement at the largest-logo tier asks for that startups have not yet built.",
    wonderfulWedge: "Wonderful has the platform depth and scale proof Jurin does not yet have. Jurin has JP-native operator instinct. Different stages of the same curve. Complementary at JP mid-market, competitive once Jurin scales.",
  },
  // === Global + platform entrants · the widening cohort, showing up in JP RFPs now ===
  {
    cohort: "global",
    name: "Sierra",
    role: "Global agentic platform (US)",
    strength: "Bret Taylor brand + Series-C capital · sophisticated agentic platform · enterprise CS at SiriusXM / ADT-class logos · raising the global bar.",
    weakness: "English-first, no JP-native team. HQ-driven foreign-vendor pattern. Generic localization. No keigo / dialect / APPI / ISMAP track record. JP procurement will read Sierra the same way it read every prior foreign vendor that walked away.",
    wonderfulWedge: "Sierra is the threat that proves the thesis: HQ-driven loses Japan even when the platform is excellent. Wonderful's JP-led inversion is what beats Sierra in this market.",
  },
  {
    cohort: "global",
    name: "Decagon",
    role: "Agentic CS (US, similar shape)",
    strength: "Closest platform shape to Wonderful · agentic enterprise CS · just raised Series C · explicit Japan ambitions · text-channel polished.",
    weakness: "Text-first, weaker voice story. No production-scale telco reference at Bezeq's level. Same HQ-driven foreign-vendor pattern risk as Sierra. No keigo / dialect / on-prem story.",
    wonderfulWedge: "Voice + Bezeq scale + multimodal. Decagon's wedge is text. Wonderful's wedge for JP enterprise (voice + scale) lands where Decagon has not invested.",
  },
  {
    cohort: "global",
    name: "Salesforce Agentforce",
    role: "Platform-vendor entry (channel threat)",
    strength: "Pulls through Salesforce JP install base · vendor incumbency · existing security + procurement relationships · CRM data gravity.",
    weakness: "Bolted-on agentic, not native. Locked to the Salesforce stack. Tries to do everything; depth on none. Foreign vendor under JP procurement scrutiny just like the rest. The Einstein-JP customer-attrition pattern is the precedent procurement remembers.",
    wonderfulWedge: "Wonderful is purpose-built agentic. JP enterprise wants a platform, not a CRM extension. Where Salesforce already owns CRM, Wonderful coexists as the agentic layer above it.",
  },
];

// Open questions per audience
const openQuestions = [
  {
    audience: "HQ + Asia Regional",
    icon: "globe-2",
    question: "Direct enterprise sales, BPO channel (Transcosmos, Bell System24), or both. Has Tel Aviv decided?",
  },
  {
    audience: "HQ + Asia Regional",
    icon: "cloud-cog",
    question: "On-prem + VPC posture. Current state, and roadmap timeline visible to a JP procurement team.",
  },
  {
    audience: "HQ + Asia Regional",
    icon: "users",
    question: "Founding JP team profile. Who is hired, what role is next, what bar.",
  },
  {
    audience: "Hosoi-san + Anthony + Henek",
    icon: "target",
    question: "Year-1 logo target. Which single name landed in 2026 makes this region \"won\" in HQ's eyes.",
  },
  {
    audience: "Hosoi-san + Anthony + Henek",
    icon: "git-fork",
    question: "Alignment that the beachhead is internal workflow automation, not customer service, until JP-fit gaps are production-ready.",
  },
  {
    audience: "HQ engineering",
    icon: "wrench",
    question: "Roadmap for the high-severity gaps in §05. Keigo eval set, dialect ASR fidelity, transcoding, repeat-number guardrail, PII handling, SLA terms.",
  },
  {
    audience: "HQ engineering",
    icon: "binary",
    question: "Legacy integration story. How does the agent reach a COBOL mainframe / AS-400 / SOAP / old EDI system at Panasonic, Hitachi, or a major JP bank. Did not come up in the demo. Critical for any old-guard PoC.",
  },
];

// Helper to render an icon by string name
const Icon = (name: string) => (Icons as any)[iconToPascal(name)];
---

<Layout
  title="Wonderful · Japan strategy · Marco Avila"
  description="Selling the shift in Japan. A confidential strategy + engagement proposal for Wonderful.ai's Asia leadership."
  brand="Marco Avila"
  tagline="Wonderful · Japan strategy"
  footerNote="Cloudflare Access · 24h session · Confidential to Anthony · Henek · Hosoi-san"
  lastUpdated="2026-05-12"
>
  <Fragment slot="nav">
    <a href="#shift" class="hover:text-[var(--color-ink)] transition-colors">Shift</a>
    <a href="#winners-losers" class="hover:text-[var(--color-ink)] transition-colors">Winners</a>
    <a href="#magic-gifts" class="hover:text-[var(--color-ink)] transition-colors">Magic gifts</a>
    <a href="#evidence" class="hover:text-[var(--color-ink)] transition-colors">Evidence</a>
    <a href="#plan" class="hover:text-[var(--color-ink)] transition-colors">Plan</a>
    <a href="#references" class="hover:text-[var(--color-ink)] transition-colors">References</a>
  </Fragment>

  <!-- ============================================================ -->
  <!-- HERO -->
  <!-- ============================================================ -->
  <section class="pt-20 sm:pt-28 pb-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-10 flex-wrap" data-reveal="fade-up">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent-ink)] text-xs font-semibold tracking-wide">
          <Flag class="w-3.5 h-3.5" />
          Confidential · Anthony · Henek · Hosoi-san
        </span>
        <span class="text-xs text-[var(--color-ink-faint)] font-mono">
          Marco Avila · 2026-05-12 · ~14 min read
        </span>
      </div>

      <p class="text-[10px] uppercase tracking-[0.22em] text-[var(--color-accent)] font-bold mb-5" data-reveal="fade-up" data-reveal-delay="1">
        The opening · what I saw in your demo
      </p>
      <h1 class="font-display text-[2.75rem] sm:text-[4rem] lg:text-[4.75rem] leading-[1.0] tracking-tight mb-4 max-w-5xl relative" data-reveal="fade-up" data-reveal-delay="2">
        The platform is real.<br /><span class="text-[var(--color-ink-soft)] italic font-display">Now to win Japan.</span>
        <span aria-hidden="true" class="absolute -left-3 sm:-left-5 top-2 bottom-2 w-[3px] sm:w-[5px] rounded-full bg-gradient-to-b from-[var(--color-accent)] via-[var(--color-accent)] to-transparent"></span>
      </h1>
      <p class="font-display text-xl sm:text-2xl text-[var(--color-ink-soft)] mb-10 max-w-3xl leading-snug italic" data-reveal="fade-up" data-reveal-delay="3">
        A 14-minute read on Wonderful's Japan play, starting with the product and ending with the plan.
      </p>

      <!-- Narrative lede — story opens with the platform, pivots to Japan -->
      <div class="story-prose max-w-3xl mb-12" data-reveal="fade-up" data-reveal-delay="4">
        <p class="first-para">
          I watched the demo end to end. <strong>The platform is real.</strong> Agentic OS, voice, multimodal, dynamic dashboards, the Wonderful Apps auto-UI layer, and the Bezeq-scale reference — 2,000 agents, ~80% resolution, millions of calls a month, all in production. Almost no foreign agentic-AI vendor landing in Japan today can point to a reference of this shape. The plumbing is mostly there. The wedge — voice plus autonomy plus multimodal plus forward-deployed engineering plus production-scale proof — is the right shape for the largest JP enterprise rooms.
        </p>
        <p>
          <strong>But Japan is not generic.</strong> The remaining 20% is what Japan tests for in the first three procurement meetings. Keigo register handling. Kansai / Tohoku dialect on the ASR. PII handling under APPI 2025–26 amendments. On-prem and ISMAP posture. Document encoding in COBOL / Shift-JIS mainframe environments. None of those came up in the demo itself. They will come up the moment procurement opens the security review. Fail one, you fail the procurement, before they ever try the product.
        </p>
        <p>
          And this market is urgent. In Japan, <strong>AI is not a cost-cutting story. It is survival.</strong> Contact centers cannot hire. Knowledge workers are retiring faster than they are being replaced. The Cabinet Office's demographic forecasts make the math undeniable. The question is no longer <em>"can we afford to wait?"</em> It is <em>"who do we trust to land before the door closes?"</em> Most foreign vendors will lose it the same way they have lost it before, by letting HQ write the Japan plan.
        </p>
        <p>
