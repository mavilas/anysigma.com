---
import "../styles/tailwind.css";
import { Zap, Lock, Shield } from "@lucide/astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
  title?: string;
  description?: string;
  /** Show the "Authenticated" badge in the header (sites behind Cloudflare Access). Default true. */
  authBadge?: boolean;
  /** Override the small brand name shown next to the logo. */
  brand?: string;
  /** Override the tagline shown under the brand name. */
  tagline?: string;
  /** Footer line shown next to the lock — defaults to the Access session note. */
  footerNote?: string;
  /** Footer "Last updated" date. */
  lastUpdated?: string;
}

const {
  title = "Mini-Site Boilerplate",
  description = "An internal mini-site built from the anysigma mini-site boilerplate.",
  authBadge = true,
  brand = "Brand",
  tagline = "Tagline",
  footerNote = "Cloudflare Access · 14-day session",
  lastUpdated,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bree+Serif&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="bg-grain min-h-screen">
    <!-- HEADER -->
    <header class="nav-backdrop border-b border-[var(--color-line)] sticky top-0 z-20">
      <div class="max-w-6xl mx-auto px-6 py-3.5 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <slot name="logo">
            <span class="w-8 h-8 rounded-md bg-[var(--color-ink)] flex items-center justify-center group-hover:bg-[var(--color-accent)] transition-colors">
              <Zap class="w-4 h-4 text-[var(--color-paper)]" />
            </span>
          </slot>
          <div class="leading-tight">
            <div class="font-display text-lg">{brand}</div>
            <div class="text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-faint)]">
              {tagline}
            </div>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm text-[var(--color-ink-soft)]">
          <slot name="nav" />
        </nav>

        <div class="flex items-center gap-2">
          {authBadge && (
            <span class="inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full bg-[var(--color-success-soft)] text-[var(--color-success)] font-medium">
              <Shield class="w-3 h-3" />
              <span class="hidden sm:inline">Authenticated</span>
            </span>
          )}
        </div>
      </div>
    </header>

    <TableOfContents />

    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-[var(--color-line)] mt-24">
      <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row gap-6 sm:items-center sm:justify-between text-sm text-[var(--color-ink-soft)]">
        <slot name="footer-left">
          <div class="flex items-center gap-2">
            <Zap class="w-4 h-4 text-[var(--color-accent)]" />
            <span>{brand} · {tagline}</span>
          </div>
        </slot>
        <div class="flex items-center gap-5 text-xs">
          <div class="flex items-center gap-1.5">
            <Lock class="w-3 h-3" />
            <span>{footerNote}</span>
          </div>
          {lastUpdated && <span>Last updated {lastUpdated}</span>}
        </div>
      </div>
    </footer>

    <!-- Reveal-on-scroll -->
    <script is:inline>
      (function () {
        const els = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window) || !els.length) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const delay = parseInt(entry.target.dataset.revealDelay || "0", 10);
                entry.target.style.transitionDelay = `${delay * 80}ms`;
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
