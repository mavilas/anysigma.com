---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import * as Icons from "@lucide/astro";
import {
  Flag,
  Sparkles,
  ListChecks,
  Trophy,
  AlertTriangle,
  AlertCircle,
  ShieldCheck,
  Wrench,
  Compass,
  Building2,
  Users,
  TrendingUp,
  ArrowLeft,
  ArrowDown,
  BookOpen,
  Mail,
  MessageSquare,
  CheckCircle2,
  CircleHelp,
  XCircle,
  Eye,
  GitMerge,
  Layers,
  Mic,
  Binary,
  FileText,
  Briefcase,
  Cpu,
} from "@lucide/astro";

const iconToPascal = (s: string) =>
  s.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join("");
const Icon = (name?: string) => (name ? ((Icons as any)[iconToPascal(name)] ?? null) : null);

// =====================================================================
// Hosoi-san's three tracks. Marco's contributions slotted underneath.
// =====================================================================
interface Item {
  title: string;
  owner: "Marco" | "Marco · Hosoi-san" | "Hosoi-san · HQ" | "Hosoi-san" | "Marco · HQ" | "TBD";
  detail: string;
  placeholder?: boolean;
}

interface TrackBlock {
  day: 30 | 60;
  items: Item[];
}

interface Track {
  id: string;
  label: string;
  icon: string;
  accent: string;
  owns: string;
  marcoLane: string;
  d30: Item[];
  d60: Item[];
}

const tracks: Track[] = [
  {
    id: "legal",
    label: "Legal & Entity",
    icon: "building-2",
    accent: "var(--color-accent)",
    owns: "Hosoi-san · HQ legal · 行政書士 + 司法書士",
